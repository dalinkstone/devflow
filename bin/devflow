#!/usr/bin/env bash
# ============================================================================
#  devflow — your agentic cloud dev environment
#
#  Spin up Claude Code or Codex in a Daytona sandbox using your existing
#  subscriptions (Claude Max / ChatGPT Pro) — no agent API keys. Optional
#  deployment credentials are forwarded only through explicit flags. Sessions
#  live in tmux inside the sandbox, so you can close your laptop and reattach from
#  anywhere with `devflow attach`.
#
#  https://github.com/dalinkstone/devflow
# ============================================================================
set -u
set -o pipefail

DEVFLOW_VERSION="0.9.0"

# ----------------------------------------------------------------------------
# Config (precedence: environment > config file > built-in default)
# ----------------------------------------------------------------------------
CONFIG_DIR="${DEVFLOW_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/devflow}"
CONFIG_FILE="$CONFIG_DIR/config"
SECRETS_FILE="$CONFIG_DIR/secrets"

GH_PIN_VERSION="2.96.0"          # fallback for in-sandbox gh install
CODEX_PIN_TAG="rust-v0.142.5"    # fallback for in-sandbox codex install
DT_MIN_VERSION="0.200.0"         # older clients spam API mismatch warnings
DT_PIN_VERSION="0.200.1"         # fallback for in-sandbox daytona install (--with-daytona)
DV_EXPECTED_PROVISION_VERSION=5

_CONFIG_KEYS="DEVFLOW_AGENT DEVFLOW_SIZE DEVFLOW_CPU DEVFLOW_MEMORY DEVFLOW_DISK DEVFLOW_AUTO_STOP DEVFLOW_TARGET DEVFLOW_SNAPSHOT DEVFLOW_CLAUDE_AUTH DEVFLOW_EXEC_STYLE DEVFLOW_WORKROOT DEVFLOW_HARNESS DEVFLOW_NTFY_URL DEVFLOW_NTFY_TOPIC DEVFLOW_AUTO_HANDOFF DEVFLOW_DOMAIN"

load_config() {
  # 1) preserve values that came from the caller's environment
  local k v _envsaved=""
  for k in $_CONFIG_KEYS DEVFLOW_CLAUDE_TOKEN DEVFLOW_DAYTONA_SANDBOX_KEY; do
    eval "v=\${$k-__devflow_unset__}"
    if [ "$v" != "__devflow_unset__" ]; then
      _envsaved="$_envsaved $k=$(printf '%q' "$v")"
    fi
  done
  # 2) config + secrets files (user-owned, chmod 600)
  # shellcheck disable=SC1090
  [ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
  # shellcheck disable=SC1090
  [ -f "$SECRETS_FILE" ] && . "$SECRETS_FILE"
  # 3) environment wins
  [ -n "$_envsaved" ] && eval "$_envsaved"
  # 4) defaults fill the gaps
  : "${DEVFLOW_AGENT:=claude}"          # claude | codex | both | none
  : "${DEVFLOW_SIZE:=}"                 # small | medium | large; "" = medium
  : "${DEVFLOW_CPU:=}"                  # legacy; maps to the smallest size that fits
  : "${DEVFLOW_MEMORY:=}"               # legacy (MB); ditto
  : "${DEVFLOW_DISK:=}"                 # legacy (GB); ditto
  : "${DEVFLOW_AUTO_STOP:=0}"           # minutes; 0 = never (close your laptop safely)
  : "${DEVFLOW_TARGET:=}"               # us | eu | "" = org default
  : "${DEVFLOW_SNAPSHOT:=}"             # custom snapshot; "" = Daytona default image
  : "${DEVFLOW_CLAUDE_AUTH:=auto}"      # auto | token | creds
  : "${DEVFLOW_EXEC_STYLE:=}"           # join | argv | "" = auto-probe
  : "${DEVFLOW_WORKROOT:=work}"         # dir under $HOME in the sandbox
  : "${DEVFLOW_HARNESS:=auto}"          # auto | omc | omx | both | core
  : "${DEVFLOW_NTFY_URL:=https://ntfy.sh}"  # push server (self-hostable)
  : "${DEVFLOW_NTFY_TOPIC:=}"           # private topic; set by 'mobile --setup-push'
  : "${DEVFLOW_AUTO_HANDOFF:=}"         # ""=off | auto|push|op|bw|note — send reconnect line after every 'up'
  : "${DEVFLOW_DOMAIN:=devflow.sh}"      # stable browser terminals: NAME.devflow.sh
  : "${DEVFLOW_CLAUDE_TOKEN:=}"
  : "${DEVFLOW_DAYTONA_SANDBOX_KEY:=}"  # minted API key forwarded by --with-daytona
  return 0
}

resolve_harness() { # AGENT REQUESTED -> effective harness
  local agent="$1" req="$2"
  case "$req" in
    auto)
      case "$agent" in
        claude) printf 'omc' ;;
        codex)  printf 'omx' ;;
        both)   printf 'both' ;;
        *)      printf 'core' ;;
      esac ;;
    none) printf 'core' ;;
    *)    printf '%s' "$req" ;;
  esac
}

# Daytona sizes sandboxes via its fixed-size default snapshots — the API
# rejects raw --cpu/--memory/--disk whenever a snapshot backs the sandbox,
# and the default image is a snapshot too. Sizes:
#   small = 1cpu/1gb/3gb · medium = 2cpu/4gb/8gb · large = 4cpu/8gb/10gb
size_desc() { # SIZE -> "2cpu/4gb/8gb"
  case "$1" in
    small)  printf '1cpu/1gb/3gb' ;;
    medium) printf '2cpu/4gb/8gb' ;;
    large)  printf '4cpu/8gb/10gb' ;;
  esac
}

size_for_resources() { # CPU MEM_MB DISK_GB (legacy knobs) -> smallest size that fits
  local cpu="${1:-1}" mem="${2:-1024}" disk="${3:-3}" n
  for n in "$cpu" "$mem" "$disk"; do
    case "$n" in ''|*[!0-9]*) printf 'large'; return 0 ;; esac
  done
  if [ "$cpu" -le 1 ] && [ "$mem" -le 1024 ] && [ "$disk" -le 3 ]; then printf 'small'
  elif [ "$cpu" -le 2 ] && [ "$mem" -le 4096 ] && [ "$disk" -le 8 ]; then printf 'medium'
  else printf 'large'; fi
}

default_size() { # from config: DEVFLOW_SIZE wins, legacy resources map, else medium
  if [ -n "$DEVFLOW_SIZE" ]; then printf '%s' "$DEVFLOW_SIZE"
  elif [ -n "${DEVFLOW_CPU}${DEVFLOW_MEMORY}${DEVFLOW_DISK}" ]; then
    size_for_resources "$DEVFLOW_CPU" "$DEVFLOW_MEMORY" "$DEVFLOW_DISK"
  else printf 'medium'; fi
}

config_set() { # config_set FILE KEY VALUE
  local file="$1" key="$2" val="$3" tmp
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
  touch "$file"
  chmod 600 "$file"
  tmp="$(mktemp "${TMPDIR:-/tmp}/devflow.XXXXXX")"
  grep -v "^${key}=" "$file" >"$tmp" 2>/dev/null || true
  printf '%s=%q\n' "$key" "$val" >>"$tmp"
  mv "$tmp" "$file"
  chmod 600 "$file"
}

# ----------------------------------------------------------------------------
# UI helpers
# ----------------------------------------------------------------------------
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] && [ -z "${NO_COLOR:-}" ]; then
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_RESET=$'\033[0m'
else
  C_BOLD=""; C_DIM=""; C_BLUE=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_RESET=""
fi

say()  { printf '%s\n' "${C_CYAN}${C_BOLD}devflow${C_RESET} $*"; }
step() { printf '%s\n' "${C_BLUE}▸${C_RESET} $*"; }
ok()   { printf '%s\n' "${C_GREEN}✓${C_RESET} $*"; }
warn() { printf '%s\n' "${C_YELLOW}!${C_RESET} $*" >&2; }
err()  { printf '%s\n' "${C_RED}✗${C_RESET} $*" >&2; }
die()  { err "$@"; exit 1; }

ui_state_value() {
  local state="$1" color="$C_DIM"
  case "$state" in
    started|running|completed|interactive) color="$C_GREEN" ;;
    queued|starting|restoring|creating)     color="$C_YELLOW" ;;
    failed|error|stale|destroyed|missing)  color="$C_RED" ;;
  esac
  printf '%s%s%s' "$color" "$state" "$C_RESET"
}

ui_title() { printf '%s%s%s\n' "$C_BOLD" "$1" "$C_RESET"; }
ui_row()   { printf '  %s%-9s%s %s\n' "$C_DIM" "$1" "$C_RESET" "$2"; }

kv_field() { # KEY-VALUE_TEXT KEY
  printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -1
}

peek_meta_field() { # META KEY
  printf '%s\n' "$1" | sed -n "s/.*[[:space:]]$2=\([^[:space:]]*\).*/\1/p"
}

clean_peek_output() {
  LC_ALL=C awk '
    BEGIN {
      esc = sprintf("%c", 27); bel = sprintf("%c", 7)
      bs = sprintf("%c", 8); cr = sprintf("%c", 13)
      osc = esc "]"; st = esc "\\"
      csi = esc "\\[[0-9;?]*[ -/]*[@-~]"
    }
    function strip_osc(s, p, rest, bell_end, st_end) {
      while ((p = index(s, osc)) > 0) {
        rest = substr(s, p + 2)
        bell_end = index(rest, bel); st_end = index(rest, st)
        if (bell_end > 0 && (st_end == 0 || bell_end < st_end))
          s = substr(s, 1, p - 1) substr(rest, bell_end + 1)
        else if (st_end > 0)
          s = substr(s, 1, p - 1) substr(rest, st_end + 2)
        else
          return substr(s, 1, p - 1)
      }
      return s
    }
    {
      line = strip_osc($0)
      gsub(csi, "", line)
      while ((p = index(line, cr)) > 0) line = substr(line, p + 1)
      while ((p = index(line, bs)) > 0) {
        before = substr(line, 1, p - 1); after = substr(line, p + 1)
        if (length(before) > 0) before = substr(before, 1, length(before) - 1)
        line = before after
      }
      gsub(/[[:cntrl:]]/, "", line)
      sub(/[[:space:]]+$/, "", line)

      # Codex occasionally paints these local session bookkeeping errors and
      # its token footer into the pane. They are not part of the agent result;
      # --raw remains available when the full transcript is needed.
      if (line ~ /ERROR codex_core::session: failed to record rollout/) next
      if (line ~ /^items: thread [0-9a-f-]+ not found$/) next
      if (line == "tokens used") { skip_tokens = 1; next }
      if (skip_tokens && line ~ /^[0-9,]+$/) { skip_tokens = 0; next }
      skip_tokens = 0
      lines[++count] = line
    }
    END {
      first = 1
      while (first <= count && lines[first] == "") first++
      last = count
      while (last >= first && lines[last] == "") last--
      blank = 0
      for (i = first; i <= last; i++) {
        if (lines[i] == "") {
          if (!blank) print ""
          blank = 1
        } else {
          print lines[i]
          blank = 0
        }
      }
    }
  '
}

trim_peek_padding() {
  awk '
    {
      lines[++count] = $0
      if ($0 != "") last = count
    }
    END {
      first = 1
      while (first <= last && lines[first] == "") first++
      for (i = first; i <= last; i++) print lines[i]
    }
  '
}

confirm() { # confirm "question" -> 0 yes / 1 no
  local ans
  printf '%s' "${C_YELLOW}?${C_RESET} $1 [y/N] "
  read -r ans || true
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# ----------------------------------------------------------------------------
# Small utilities
# ----------------------------------------------------------------------------
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 — run 'devflow setup' (or: $2)"; }
have_cmd() { command -v "$1" >/dev/null 2>&1; }
need_val() { [ -n "${2:-}" ] || die "flag $1 requires a value"; }

version_lt() { # VERSION MINIMUM; release versions only
  awk -v have="$1" -v want="$2" 'BEGIN {
    split(have, h, "."); split(want, w, ".")
    for (i = 1; i <= 3; i++) {
      h[i] += 0; w[i] += 0
      if (h[i] < w[i]) exit 0
      if (h[i] > w[i]) exit 1
    }
    exit 1
  }'
}

daytona_cli_version() {
  command daytona version 2>/dev/null | sed -n 's/.*v\([0-9][0-9.]*\).*/\1/p' | head -1
}

require_daytona_cli() {
  local have path
  need_cmd daytona "curl -fsSL https://devflow.sh/install | sh"
  have="$(daytona_cli_version)"
  path="$(command -v daytona)"
  [ -n "$have" ] || die "could not read the Daytona CLI version at $path — reinstall: curl -fsSL https://devflow.sh/install | sh"
  version_lt "$have" "$DT_MIN_VERSION" \
    && die "Daytona CLI v$have is too old at $path (need v$DT_MIN_VERSION+) — update: curl -fsSL https://devflow.sh/install | sh"
  return 0
}

upgrade_daytona_cli() {
  local prefix brew_bin current
  have_cmd brew || return 1
  brew upgrade daytonaio/cli/daytona \
    || brew install daytonaio/cli/daytona \
    || return 1
  prefix="$(brew --prefix daytona 2>/dev/null || brew --prefix daytonaio/cli/daytona 2>/dev/null)" \
    || return 1
  brew_bin="$prefix/bin/daytona"
  [ -x "$brew_bin" ] || return 1
  current="$(command -v daytona 2>/dev/null || true)"
  if [ "$current" = "$HOME/.local/bin/daytona" ]; then
    ln -sf "$brew_bin" "$current" || return 1
  fi
  return 0
}

b64_encode() { # portable, single-line output
  if base64 --help 2>&1 | grep -q -- '-w'; then base64 -w0; else base64 | tr -d '\n'; fi
}

b64_decode() { # portable stdin decoder
  local data
  data="$(cat)"
  printf '%s' "$data" | base64 --decode 2>/dev/null \
    || printf '%s' "$data" | base64 -D 2>/dev/null \
    || printf '%s' "$data" | base64 -d
}

sanitize_name() {
  local out
  out="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9-]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-40)"
  [ -n "$out" ] && printf '%s' "$out" || printf 'sandbox'
}

repo_from_arg() { # normalize repo arg -> owner/name (empty if not repo-ish)
  local a="$1"
  a="${a%.git}"
  case "$a" in
    https://github.com/*) a="${a#https://github.com/}" ;;
    http://github.com/*)  a="${a#http://github.com/}" ;;
    git@github.com:*)     a="${a#git@github.com:}" ;;
  esac
  case "$a" in
    */*/*) printf '' ;;
    ?*/?*) printf '%s' "$a" ;;
    *)     printf '' ;;
  esac
}

current_repo() { # owner/name of cwd's github origin, or empty
  local url
  url="$(git config --get remote.origin.url 2>/dev/null || true)"
  [ -n "$url" ] || { printf ''; return 0; }
  repo_from_arg "$url"
}

# ----------------------------------------------------------------------------
# Daytona wrappers
# ----------------------------------------------------------------------------
_DT_VERSION_CHECKED=0
dt() {
  if [ "$_DT_VERSION_CHECKED" != 1 ]; then
    require_daytona_cli
    _DT_VERSION_CHECKED=1
  fi
  command daytona "$@"
}

dt_quiet() { # Daytona command with curated success output from the caller
  local output
  if output="$(dt "$@" 2>&1)"; then return 0; fi
  [ -z "$output" ] || printf '%s\n' "$output" >&2
  return 1
}

# NOTE: must be an org-scoped call that works under BOTH auth modes — the CLI
# refuses `organization` subcommands entirely under api-key auth
dt_auth_check() { command daytona list >/dev/null 2>&1; }

dt_info_json() { dt info "$1" -f json 2>/dev/null; }

sandbox_state() { # NAME -> state string or "missing"
  local j
  j="$(dt_info_json "$1")" || { printf 'missing'; return 0; }
  printf '%s' "$j" | jq -r '.state // .status // "unknown"'
}

wait_for_state() { # NAME WANT TIMEOUT_S
  local name="$1" want="$2" timeout="${3:-180}" waited=0 st=""
  while [ "$waited" -lt "$timeout" ]; do
    st="$(sandbox_state "$name")"
    case "$st" in
      "$want") return 0 ;;
      error|build_failed|destroyed) die "sandbox '$name' entered state: $st" ;;
    esac
    sleep 2
    waited=$((waited + 2))
  done
  die "timed out waiting for sandbox '$name' to be $want (last state: ${st:-unknown})"
}

# --- remote exec ------------------------------------------------------------
# Different daytona CLI builds pass `exec … -- args` through differently: some
# join args into one shell string, some preserve argv. Probe once, cache.
probe_exec_style() { # NAME (sandbox must be started)
  local out
  out="$(dt exec "$1" --timeout 30 -- printf %s 'x y' 2>/dev/null || true)"
  case "$out" in
    "x y") DEVFLOW_EXEC_STYLE="argv" ;;
    "xy")  DEVFLOW_EXEC_STYLE="join" ;;
    *)
      out="$(dt exec "$1" --timeout 30 -- echo 'dv probe' 2>/dev/null || true)"
      case "$out" in
        *"dv probe"*) DEVFLOW_EXEC_STYLE="argv" ;;
        *)            DEVFLOW_EXEC_STYLE="join" ;;
      esac
      ;;
  esac
  config_set "$CONFIG_FILE" DEVFLOW_EXEC_STYLE "$DEVFLOW_EXEC_STYLE"
}

dt_run() { # NAME SCRIPT [TIMEOUT] — run a (newline-free) bash command string
  local name="$1" script="$2" timeout="${3:-0}"
  [ -n "$DEVFLOW_EXEC_STYLE" ] || probe_exec_style "$name"
  if [ "$DEVFLOW_EXEC_STYLE" = "argv" ]; then
    dt exec "$name" --timeout "$timeout" -- bash -lc "$script"
  else
    local quoted
    quoted="$(printf '%q' "$script")"
    dt exec "$name" --timeout "$timeout" -- "bash -lc $quoted"
  fi
}

dt_push_file() { # NAME REMOTE_PATH  (content on stdin) — chunked base64 upload
  local name="$1" remote="$2" b64 len off=0 chunk=6000 part first=1
  b64="$(b64_encode)"
  len=${#b64}
  while [ "$off" -lt "$len" ]; do
    part="${b64:$off:$chunk}"
    if [ "$first" = 1 ]; then
      dt_run "$name" "umask 077 && printf %s '$part' > '$remote.b64'" 120 >/dev/null
      first=0
    else
      dt_run "$name" "printf %s '$part' >> '$remote.b64'" 120 >/dev/null
    fi
    off=$((off + chunk))
  done
  dt_run "$name" "umask 077 && base64 -d '$remote.b64' > '$remote' && rm -f '$remote.b64'" 60 >/dev/null
}

# ----------------------------------------------------------------------------
# Local auth harvesting (memoized; secrets never printed or logged)
# ----------------------------------------------------------------------------
_HARVESTED=0
harvest_all() {
  [ "$_HARVESTED" = 1 ] && return 0
  _HARVESTED=1
  # --- claude: token (preferred) or credentials copy ---
  CLAUDE_MODE="none"; CLAUDE_TOKEN=""; CLAUDE_CREDS_B64=""
  if [ "$DEVFLOW_CLAUDE_AUTH" != "creds" ] && [ -n "$DEVFLOW_CLAUDE_TOKEN" ]; then
    CLAUDE_MODE="token"; CLAUDE_TOKEN="$DEVFLOW_CLAUDE_TOKEN"
  elif [ "$DEVFLOW_CLAUDE_AUTH" != "token" ]; then
    local creds=""
    if [ "$(uname -s)" = "Darwin" ]; then
      creds="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
    fi
    if [ -z "$creds" ] && [ -f "$HOME/.claude/.credentials.json" ]; then
      creds="$(cat "$HOME/.claude/.credentials.json")"
    fi
    if [ -n "$creds" ]; then
      CLAUDE_MODE="creds"
      CLAUDE_CREDS_B64="$(printf '%s' "$creds" | b64_encode)"
    fi
  fi
  # --- codex: ChatGPT sign-in file ---
  CODEX_AUTH_B64=""
  local cf="${CODEX_HOME:-$HOME/.codex}/auth.json"
  [ -f "$cf" ] && CODEX_AUTH_B64="$(b64_encode <"$cf")"
  # --- github ---
  GH_TOKEN_VAL=""
  have_cmd gh && GH_TOKEN_VAL="$(gh auth token 2>/dev/null || true)"
  # --- git identity ---
  GIT_NAME="$(git config --global user.name 2>/dev/null || git config user.name 2>/dev/null || true)"
  GIT_EMAIL="$(git config --global user.email 2>/dev/null || git config user.email 2>/dev/null || true)"

  # --- explicit deployment credentials (opt-in per invocation) ---
  AWS_ENABLED=0 AWS_CREDS_B64="" AWS_CONFIG_B64="" AWS_EXPIRATION="" AWS_SOURCE_PROFILE=""
  SECRET_ENV_B64="" SECRET_ENV_NAMES=""
  local env_name env_value env_payload="" env_item env_assignment
  if [ -n "${DEVFLOW_AWS_PROFILE:-}" ]; then
    have_cmd aws || die "--aws-profile requires the AWS CLI locally"
    local aws_json aws_key aws_secret aws_token aws_region aws_creds aws_config
    aws_json="$(aws configure export-credentials --profile "$DEVFLOW_AWS_PROFILE" --format process 2>/dev/null)" \
      || die "could not resolve AWS profile '$DEVFLOW_AWS_PROFILE' (log in/refresh it, then retry)"
    aws_key="$(printf '%s' "$aws_json" | jq -r '.AccessKeyId // empty')"
    aws_secret="$(printf '%s' "$aws_json" | jq -r '.SecretAccessKey // empty')"
    aws_token="$(printf '%s' "$aws_json" | jq -r '.SessionToken // empty')"
    AWS_EXPIRATION="$(printf '%s' "$aws_json" | jq -r '.Expiration // empty')"
    [ -n "$aws_key" ] && [ -n "$aws_secret" ] \
      || die "AWS profile '$DEVFLOW_AWS_PROFILE' did not resolve usable credentials"
    if { [ -z "$aws_token" ] || [ -z "$AWS_EXPIRATION" ]; } && [ "${DEVFLOW_ALLOW_STATIC_AWS:-0}" != 1 ]; then
      die "AWS profile '$DEVFLOW_AWS_PROFILE' resolved non-expiring/static credentials; use an assumed-role profile with an expiring STS session (or explicitly accept the risk with --allow-static-aws)"
    fi
    aws sts get-caller-identity --profile "$DEVFLOW_AWS_PROFILE" >/dev/null 2>&1 \
      || die "AWS profile '$DEVFLOW_AWS_PROFILE' failed sts:GetCallerIdentity"
    aws_region="$(aws configure get region --profile "$DEVFLOW_AWS_PROFILE" 2>/dev/null || true)"
    [ -n "$aws_region" ] || aws_region="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}"
    aws_creds="[devflow]
aws_access_key_id = $aws_key
aws_secret_access_key = $aws_secret"
    [ -n "$aws_token" ] && aws_creds="$aws_creds
aws_session_token = $aws_token"
    aws_config="[profile devflow]
region = $aws_region
output = json"
    AWS_CREDS_B64="$(printf '%s\n' "$aws_creds" | b64_encode)"
    AWS_CONFIG_B64="$(printf '%s\n' "$aws_config" | b64_encode)"
    AWS_SOURCE_PROFILE="$DEVFLOW_AWS_PROFILE"
    AWS_ENABLED=1
  fi

  if [ -n "${DEVFLOW_SECRET_ENV_NAMES:-}" ]; then
    for env_name in $DEVFLOW_SECRET_ENV_NAMES; do
      case "$env_name" in
        ''|[0-9]*|*[!A-Za-z0-9_]*) die "invalid --secret-env name '$env_name'" ;;
      esac
      eval "env_value=\${$env_name-}"
      [ -n "$env_value" ] || die "--secret-env $env_name is unset or empty"
      env_payload="$env_payload$(printf 'export %s=%q' "$env_name" "$env_value")"$'\n'
      SECRET_ENV_NAMES="${SECRET_ENV_NAMES}${SECRET_ENV_NAMES:+ }$env_name"
    done
  fi
  if [ -n "${DEVFLOW_ENV_ITEMS:-}" ]; then
    for env_item in $DEVFLOW_ENV_ITEMS; do
      env_assignment="$(printf '%s' "$env_item" | b64_decode)" \
        || die "could not decode --env assignment"
      case "$env_assignment" in
        *=*) env_name="${env_assignment%%=*}"; env_value="${env_assignment#*=}" ;;
        *) die "--env expects NAME=VALUE" ;;
      esac
      case "$env_name" in
        ''|[0-9]*|*[!A-Za-z0-9_]*) die "invalid --env name '$env_name'" ;;
      esac
      env_payload="$env_payload$(printf 'export %s=%q' "$env_name" "$env_value")"$'\n'
      SECRET_ENV_NAMES="${SECRET_ENV_NAMES}${SECRET_ENV_NAMES:+ }$env_name"
    done
  fi
  [ -n "$env_payload" ] && SECRET_ENV_B64="$(printf '%s' "$env_payload" | b64_encode)"
  return 0
}

build_secrets_bundle() { # stdout: env file consumed by the sandbox provisioner
  harvest_all
  printf 'DV_CLAUDE_MODE=%s\n' "$CLAUDE_MODE"
  printf 'DV_CLAUDE_TOKEN=%s\n' "$CLAUDE_TOKEN"
  printf 'DV_CLAUDE_CREDS_B64=%s\n' "$CLAUDE_CREDS_B64"
  printf 'DV_CODEX_AUTH_B64=%s\n' "$CODEX_AUTH_B64"
  printf 'DV_GH_TOKEN=%s\n' "$GH_TOKEN_VAL"
  printf 'DV_GIT_NAME=%q\n' "${GIT_NAME:-}"
  printf 'DV_GIT_EMAIL=%q\n' "${GIT_EMAIL:-}"
  printf 'DV_GH_PIN=%s\n' "$GH_PIN_VERSION"
  printf 'DV_CODEX_PIN=%s\n' "$CODEX_PIN_TAG"
  printf 'DV_AWS_ENABLED=%s\n' "$AWS_ENABLED"
  printf 'DV_AWS_CREDS_B64=%s\n' "$AWS_CREDS_B64"
  printf 'DV_AWS_CONFIG_B64=%s\n' "$AWS_CONFIG_B64"
  printf 'DV_AWS_EXPIRATION=%q\n' "$AWS_EXPIRATION"
  printf 'DV_AWS_SOURCE_PROFILE=%q\n' "$AWS_SOURCE_PROFILE"
  printf 'DV_SECRET_ENV_B64=%s\n' "$SECRET_ENV_B64"
  printf 'DV_SECRET_ENV_NAMES=%q\n' "$SECRET_ENV_NAMES"
}

auth_summary() { # print what will be synced (no secret values)
  harvest_all
  local ready=""
  case "$CLAUDE_MODE" in
    token) ready="claude" ;;
    creds) ready="claude" ;;
    none)  warn "Claude Code: no subscription auth found — run 'devflow token' (or log in to claude locally)" ;;
  esac
  if [ -n "$CODEX_AUTH_B64" ]; then ready="${ready}${ready:+ · }codex"
  else warn "Codex: no ~/.codex/auth.json — run 'codex' locally and sign in with ChatGPT first"; fi
  if [ -n "$GH_TOKEN_VAL" ]; then ready="${ready}${ready:+ · }github"
  else warn "GitHub: gh not authenticated — private clones/pushes won't work (gh auth login)"; fi
  [ -z "$ready" ] || ok "auth ready: $ready"
  if [ "$AWS_ENABLED" = 1 ]; then
    if [ -n "$AWS_EXPIRATION" ]; then ok "AWS: temporary profile '$AWS_SOURCE_PROFILE' (expires $AWS_EXPIRATION)"
    else warn "AWS: static profile '$AWS_SOURCE_PROFILE' explicitly allowed"; fi
    step "AWS deployment toolchain will be installed in the sandbox"
  fi
  [ -n "$SECRET_ENV_NAMES" ] && ok "forwarded env: applying named variables ($SECRET_ENV_NAMES)"
}

# ----------------------------------------------------------------------------
# Repo selection
# ----------------------------------------------------------------------------
pick_repo() { # sets REPO_PICKED (owner/name, may be "")
  REPO_PICKED=""
  need_cmd gh "brew install gh"
  step "fetching your repositories…" >&2
  local list
  list="$(gh repo list --limit 200 --json nameWithOwner,description \
          --template '{{range .}}{{.nameWithOwner}}{{"\t"}}{{.description}}{{"\n"}}{{end}}' 2>/dev/null || true)"
  [ -n "$list" ] || die "could not list repos via gh — is 'gh auth login' done?"
  if have_cmd fzf; then
    local sel
    sel="$(printf '%s\n' "$list" | fzf --height=60% --reverse --prompt='repo> ' \
          --header='pick a repo (esc = blank sandbox)' --delimiter='\t' --with-nth=1,2 || true)"
    REPO_PICKED="$(printf '%s' "$sel" | cut -f1)"
  else
    say "pick a repo (number), or 0 for a blank sandbox:"
    printf '%s\n' "$list" | head -30 | nl -w3 -s') ' | cut -c1-100
    printf 'repo #: '
    local n
    read -r n || true
    if [ -n "$n" ] && [ "$n" != "0" ]; then
      REPO_PICKED="$(printf '%s\n' "$list" | sed -n "${n}p" | cut -f1)"
    fi
  fi
  return 0
}

# ----------------------------------------------------------------------------
# Embedded payload: sandbox provisioner (phased; runs INSIDE the sandbox)
# ----------------------------------------------------------------------------
emit_provision_script() {
cat <<'DVPROV_EOF'
#!/usr/bin/env bash
# devflow sandbox provisioner — runs INSIDE the Daytona sandbox. Idempotent.
# Phases (DV_PHASE): tools | auth | workspace | all
set -u
set -o pipefail

DV_DIR="$HOME/.devflow"
DV_BIN="$DV_DIR/bin"
DV_STAGE="$DV_DIR/stage"
DV_PROVISION_VERSION=5
export PATH="$HOME/.local/bin:$DV_BIN:$PATH"

: "${DV_PHASE:=all}"
: "${DV_AGENT:=claude}"
: "${DV_REPO:=}"
: "${DV_BRANCH:=}"
: "${DV_NAME:=sandbox}"
: "${DV_TASK_B64:=}"
: "${DV_WORKROOT:=work}"
: "${DV_HARNESS:=core}"   # core | omc | omx | both

log()  { printf '[devflow] %s\n' "$*"; }
fail() { printf '[devflow] ERROR: %s\n' "$*" >&2; exit 1; }

mkdir -p "$DV_DIR" "$DV_BIN" "$DV_STAGE" "$HOME/.local/bin"
chmod 700 "$DV_DIR" "$DV_STAGE"
cd "$HOME" || true   # tools that drop state in cwd (omx setup) must land in $HOME

SUDO=""
if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
  SUDO="sudo"
fi

apt_install() { # best-effort package install (root or passwordless sudo)
  command -v apt-get >/dev/null 2>&1 || return 1
  if [ "$(id -u)" = "0" ]; then
    apt-get update -qq >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" >/dev/null 2>&1
  elif [ -n "$SUDO" ]; then
    $SUDO apt-get update -qq >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y -qq "$@" >/dev/null 2>&1
  else
    return 1
  fi
}

ensure_node_path() { # surface nvm-installed node (default Daytona image uses nvm)
  command -v node >/dev/null 2>&1 && return 0
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  fi
  command -v node >/dev/null 2>&1 && return 0
  local d
  for d in "$HOME"/.nvm/versions/node/*/bin /usr/local/share/nvm/versions/node/*/bin; do
    if [ -x "$d/node" ]; then export PATH="$d:$PATH"; return 0; fi
  done
  return 0
}

arch_triple() { case "$(uname -m)" in aarch64|arm64) printf 'aarch64' ;; *) printf 'x86_64' ;; esac; }
arch_gh()     { case "$(uname -m)" in aarch64|arm64) printf 'arm64'   ;; *) printf 'amd64'  ;; esac; }

version_lt() { # VERSION MINIMUM; release versions only
  awk -v have="$1" -v want="$2" 'BEGIN {
    split(have, h, "."); split(want, w, ".")
    for (i = 1; i <= 3; i++) {
      h[i] += 0; w[i] += 0
      if (h[i] < w[i]) exit 0
      if (h[i] > w[i]) exit 1
    }
    exit 1
  }'
}

gh_curl() { # authenticated GitHub download when possible (rate limits)
  if [ -n "${DV_GH_TOKEN:-}" ]; then
    curl -fsSL -H "Authorization: Bearer $DV_GH_TOKEN" "$@"
  else
    curl -fsSL "$@"
  fi
}

load_secrets() {
  DV_CLAUDE_MODE=none DV_CLAUDE_TOKEN="" DV_CLAUDE_CREDS_B64="" DV_CODEX_AUTH_B64=""
  DV_GH_TOKEN="" DV_GIT_NAME="" DV_GIT_EMAIL="" DV_GH_PIN="2.96.0" DV_CODEX_PIN="rust-v0.142.5"
  DV_AWS_ENABLED=0 DV_AWS_CREDS_B64="" DV_AWS_CONFIG_B64="" DV_AWS_EXPIRATION="" DV_AWS_SOURCE_PROFILE=""
  DV_SECRET_ENV_B64="" DV_SECRET_ENV_NAMES=""
  if [ -f "$DV_STAGE/secrets.env" ]; then
    # shellcheck disable=SC1090
    . "$DV_STAGE/secrets.env"
  fi
}

ensure_npm() { # make npm usable (nvm-installed or fresh nvm install); rc 1 if impossible
  ensure_node_path
  if ! command -v npm >/dev/null 2>&1; then
    log "installing node 22 via nvm (needed for the multi-agent harness)…"
    export NVM_DIR="$HOME/.nvm"
    if [ ! -s "$NVM_DIR/nvm.sh" ]; then
      curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash > "$DV_DIR/nvm-install.log" 2>&1 || true
    fi
    # shellcheck disable=SC1091
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
    command -v nvm >/dev/null 2>&1 && nvm install 22 >> "$DV_DIR/nvm-install.log" 2>&1
    ensure_node_path
  fi
  command -v npm >/dev/null 2>&1 || return 1
  # non-root global installs need a user-writable prefix (skip under nvm,
  # which manages its own prefix and rejects overrides)
  local proot
  proot="$(npm root -g 2>/dev/null || true)"
  if [ -n "$proot" ] && [ ! -w "$(dirname "$proot")" ] && [ "$(id -u)" != "0" ]; then
    npm config set prefix "$HOME/.local" >/dev/null 2>&1 || true
  fi
  # nvm's bin dir is invisible to non-interactive login shells (ubuntu's
  # .bashrc returns early), so expose the runtime on a stable PATH
  link_global_bin node
  link_global_bin npm
  link_global_bin npx
  return 0
}

link_global_bin() { # expose an npm-global binary at ~/.local/bin
  local src
  src="$(npm prefix -g 2>/dev/null)/bin/$1"
  [ -x "$src" ] && [ "$src" != "$HOME/.local/bin/$1" ] && ln -sf "$src" "$HOME/.local/bin/$1"
  return 0
}

cloud_arch() { case "$(uname -m)" in aarch64|arm64) printf 'arm64' ;; *) printf 'amd64' ;; esac; }
aws_arch()   { case "$(uname -m)" in aarch64|arm64) printf 'aarch64' ;; *) printf 'x86_64' ;; esac; }

install_cloud_tools() {
  [ "${DV_AWS_ENABLED:-0}" = 1 ] || return 0
  log "installing AWS deployment toolchain (aws, eksctl, kubectl, helm, yq, envsubst, shellcheck, docker)…"
  apt_install unzip gettext-base openssh-client openssl file shellcheck docker.io \
    python3 python3-venv python3-pip ca-certificates || true
  local t arch kver
  arch="$(cloud_arch)"

  if ! command -v aws >/dev/null 2>&1; then
    t="$(mktemp -d)"
    if curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(aws_arch).zip" -o "$t/aws.zip" \
       && unzip -q "$t/aws.zip" -d "$t" \
       && "$t/aws/install" -i "$HOME/.local/aws-cli" -b "$HOME/.local/bin" >/dev/null; then :
    else rm -rf "$t"; fail "AWS CLI install failed"; fi
    rm -rf "$t"
  fi

  if ! command -v eksctl >/dev/null 2>&1; then
    t="$(mktemp -d)"
    if curl -fsSL "https://github.com/eksctl-io/eksctl/releases/latest/download/eksctl_Linux_${arch}.tar.gz" -o "$t/eksctl.tgz" \
       && tar -xzf "$t/eksctl.tgz" -C "$t" \
       && install -m 0755 "$t/eksctl" "$HOME/.local/bin/eksctl"; then :
    else rm -rf "$t"; fail "eksctl install failed"; fi
    rm -rf "$t"
  fi

  if ! command -v kubectl >/dev/null 2>&1; then
    kver="$(curl -fsSL https://dl.k8s.io/release/stable.txt 2>/dev/null || true)"
    [ -n "$kver" ] || fail "could not resolve the current stable kubectl version"
    curl -fsSL "https://dl.k8s.io/release/${kver}/bin/linux/${arch}/kubectl" -o "$HOME/.local/bin/kubectl" \
      || fail "kubectl install failed"
    chmod 0755 "$HOME/.local/bin/kubectl"
  fi

  if ! command -v helm >/dev/null 2>&1; then
    t="$(mktemp -d)"
    if curl -fsSL "https://get.helm.sh/helm-v3.18.4-linux-${arch}.tar.gz" -o "$t/helm.tgz" \
       && tar -xzf "$t/helm.tgz" -C "$t" \
       && install -m 0755 "$t/linux-${arch}/helm" "$HOME/.local/bin/helm"; then :
    else rm -rf "$t"; fail "helm install failed"; fi
    rm -rf "$t"
  fi

  if ! command -v yq >/dev/null 2>&1; then
    curl -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${arch}" -o "$HOME/.local/bin/yq" \
      || fail "yq install failed"
    chmod 0755 "$HOME/.local/bin/yq"
  fi

  if ! helm unittest --help >/dev/null 2>&1; then
    helm plugin install https://github.com/helm-unittest/helm-unittest.git --version v1.1.1 \
      > "$DV_DIR/helm-unittest-install.log" 2>&1 \
      || fail "helm-unittest install failed (see ~/.devflow/helm-unittest-install.log)"
  fi

  # Daytona's Docker-in-Docker snapshots can run dockerd. On a plain snapshot
  # the CLI is still installed, and a clear warning tells the operator to use
  # a prebuilt image or a DIND-capable snapshot.
  if command -v docker >/dev/null 2>&1 && ! docker info >/dev/null 2>&1; then
    [ -n "$SUDO" ] && $SUDO service docker start >/dev/null 2>&1 || true
    if ! docker info >/dev/null 2>&1 && [ -n "$SUDO" ] && $SUDO docker info >/dev/null 2>&1; then
      cat > "$HOME/.local/bin/docker" <<'DV_DOCKER_WRAPPER'
#!/usr/bin/env bash
exec sudo -n /usr/bin/docker "$@"
DV_DOCKER_WRAPPER
      chmod 0755 "$HOME/.local/bin/docker"
    fi
  fi

  for t in aws eksctl kubectl helm yq envsubst jq ssh-keygen curl openssl shellcheck docker file python3; do
    command -v "$t" >/dev/null 2>&1 || fail "AWS deployment tool missing after install: $t"
  done
  if docker info >/dev/null 2>&1; then
    log "AWS deployment toolchain ready (Docker daemon available)"
  else
    log "warn: Docker CLI installed but daemon unavailable — use a prebuilt runner image or a DIND-capable Daytona snapshot"
  fi
}

# ============================ phase: tools ===================================
phase_tools() {
  log "phase 1/4 tools: checking base packages…"
  local missing=""
  for t in tmux git curl; do command -v "$t" >/dev/null 2>&1 || missing="$missing $t"; done
  if [ -n "$missing" ]; then
    log "installing:$missing"
    # shellcheck disable=SC2086
    apt_install $missing ca-certificates || log "warn: could not apt-install$missing"
  fi
  command -v git  >/dev/null 2>&1 || fail "git missing and not installable in this image"
  command -v curl >/dev/null 2>&1 || fail "curl missing and not installable in this image"
  command -v tmux >/dev/null 2>&1 || log "warn: no tmux — sessions won't survive disconnects"
  command -v jq   >/dev/null 2>&1 || apt_install jq || true
  command -v rg   >/dev/null 2>&1 || apt_install ripgrep || true
  install_cloud_tools

  # ---- gh CLI ----
  if ! command -v gh >/dev/null 2>&1; then
    log "installing gh v$DV_GH_PIN…"
    local a t
    a="$(arch_gh)"
    t="$(mktemp -d)"
    if gh_curl "https://github.com/cli/cli/releases/download/v${DV_GH_PIN}/gh_${DV_GH_PIN}_linux_${a}.tar.gz" -o "$t/gh.tgz" \
       && tar -xzf "$t/gh.tgz" -C "$t"; then
      cp "$t/gh_${DV_GH_PIN}_linux_${a}/bin/gh" "$HOME/.local/bin/gh" && chmod +x "$HOME/.local/bin/gh"
    else
      log "warn: gh install failed (private-repo clone won't work)"
    fi
    rm -rf "$t"
  fi

  # ---- Claude Code ----
  ensure_node_path
  if ! command -v claude >/dev/null 2>&1; then
    log "installing Claude Code (native)…"
    curl -fsSL https://claude.ai/install.sh | bash > "$DV_DIR/claude-install.log" 2>&1 || true
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v claude >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
      log "native install unavailable — falling back to npm…"
      npm install -g @anthropic-ai/claude-code >> "$DV_DIR/claude-install.log" 2>&1 || true
    fi
  fi

  # ---- Codex CLI ----
  # Daytona snapshots may already contain Codex. Treat an older binary as
  # missing: stale defaults can select a model that ChatGPT auth rejects.
  local triple tag t bin codex_have codex_want install_codex
  triple="$(arch_triple)-unknown-linux-musl"
  tag=""
  if [ -n "${DV_GH_TOKEN:-}" ]; then
    tag="$(gh_curl https://api.github.com/repos/openai/codex/releases/latest 2>/dev/null | grep -m1 '"tag_name"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/' || true)"
  fi
  [ -n "$tag" ] || tag="$DV_CODEX_PIN"
  codex_want="${tag#rust-v}"
  codex_have="$(codex --version 2>/dev/null | awk '{print $NF}' | sed 's/^v//' || true)"
  install_codex=0
  if [ -z "$codex_have" ] || version_lt "$codex_have" "$codex_want"; then
    install_codex=1
  fi
  if [ "$install_codex" = 1 ]; then
    if [ -n "$codex_have" ]; then
      log "upgrading Codex CLI v$codex_have → v$codex_want…"
    else
      log "installing Codex CLI v$codex_want…"
    fi
    t="$(mktemp -d)"
    if gh_curl "https://github.com/openai/codex/releases/download/${tag}/codex-${triple}.tar.gz" -o "$t/codex.tgz" \
       2> "$DV_DIR/codex-native-install.log" \
       && tar -xzf "$t/codex.tgz" -C "$t" >> "$DV_DIR/codex-native-install.log" 2>&1; then
      bin="$(find "$t" -maxdepth 2 -type f -name 'codex*' ! -name '*.tar.gz' | head -1)"
      [ -n "$bin" ] && cp "$bin" "$HOME/.local/bin/codex" && chmod +x "$HOME/.local/bin/codex"
    fi
    rm -rf "$t"
    codex_have="$(codex --version 2>/dev/null | awk '{print $NF}' | sed 's/^v//' || true)"
    if [ -z "$codex_have" ] || version_lt "$codex_have" "$codex_want"; then
      log "native Codex install unavailable — falling back to a user-local npm install…"
      ensure_node_path
      command -v npm >/dev/null 2>&1 || ensure_npm || true
      if command -v npm >/dev/null 2>&1; then
        # ensure_npm may have linked an older snapshot-global codex here.
        # Remove that exact user-local launcher so npm can install the matching
        # package executable, never modifying the snapshot's Node tree.
        rm -f "$HOME/.local/bin/codex"
        npm install --prefix "$HOME/.local" --no-audit --no-fund "@openai/codex@$codex_want" \
          > "$DV_DIR/codex-install.log" 2>&1 || true
        if [ -x "$HOME/.local/node_modules/@openai/codex/bin/codex.js" ]; then
          ln -sf "$HOME/.local/node_modules/@openai/codex/bin/codex.js" "$HOME/.local/bin/codex"
        fi
      fi
    fi
  fi

  codex_have="$(codex --version 2>/dev/null | awk '{print $NF}' | sed 's/^v//' || true)"

  # only hard-fail if the selected agent is unusable
  case "$DV_AGENT" in
    claude) command -v claude >/dev/null 2>&1 || fail "claude install failed (see ~/.devflow/claude-install.log)" ;;
    codex)  command -v codex  >/dev/null 2>&1 || fail "codex install failed"
            version_lt "$codex_have" "$codex_want" && fail "Codex CLI v$codex_have is older than required v$codex_want" ;;
    both)   command -v claude >/dev/null 2>&1 || fail "claude install failed"
            command -v codex  >/dev/null 2>&1 || fail "codex install failed"
            version_lt "$codex_have" "$codex_want" && fail "Codex CLI v$codex_have is older than required v$codex_want" ;;
  esac
  log "tools ready: $(command -v claude >/dev/null 2>&1 && printf 'claude ')$(command -v codex >/dev/null 2>&1 && printf 'codex-v%s ' "$codex_have")$(command -v gh >/dev/null 2>&1 && printf 'gh ')$(command -v tmux >/dev/null 2>&1 && printf 'tmux')"
}

# ============================ phase: auth ====================================
phase_auth() {
  log "phase 2/4 auth: applying subscription credentials…"
  load_secrets
  umask 077
  mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.aws"
  chmod 700 "$HOME/.aws"

  : > "$DV_DIR/env"
  chmod 600 "$DV_DIR/env"
  case "$DV_CLAUDE_MODE" in
    token)
      printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "$DV_CLAUDE_TOKEN" >> "$DV_DIR/env"
      log "claude auth: long-lived subscription token"
      ;;
    creds)
      printf '%s' "$DV_CLAUDE_CREDS_B64" | base64 -d > "$HOME/.claude/.credentials.json"
      chmod 600 "$HOME/.claude/.credentials.json"
      log "claude auth: subscription credentials copied"
      ;;
    *) log "claude auth: none provided (claude will ask to log in)" ;;
  esac
  printf '%s\n' '[ -f "$HOME/.devflow/forwarded.env" ] && . "$HOME/.devflow/forwarded.env"' >> "$DV_DIR/env"
  printf '%s\n' '[ -f "$HOME/.devflow/aws.env" ] && . "$HOME/.devflow/aws.env"' >> "$DV_DIR/env"

  if [ -n "$DV_CODEX_AUTH_B64" ]; then
    printf '%s' "$DV_CODEX_AUTH_B64" | base64 -d > "$HOME/.codex/auth.json"
    chmod 600 "$HOME/.codex/auth.json"
    log "codex auth: ChatGPT sign-in copied"
  else
    log "codex auth: none provided (use 'codex login --device-auth' in the sandbox)"
  fi

  if [ -n "$DV_GH_TOKEN" ] && command -v gh >/dev/null 2>&1; then
    printf '%s' "$DV_GH_TOKEN" | gh auth login --with-token 2>/dev/null || true
    gh auth setup-git 2>/dev/null || true
    log "github auth: $(gh api user -q .login 2>/dev/null || echo 'token applied')"
  fi

  [ -n "$DV_GIT_NAME" ]  && git config --global user.name  "$DV_GIT_NAME"
  [ -n "$DV_GIT_EMAIL" ] && git config --global user.email "$DV_GIT_EMAIL"
  git config --global init.defaultBranch main 2>/dev/null || true
  git config --global push.autoSetupRemote true 2>/dev/null || true

  if [ "${DV_AWS_ENABLED:-0}" = 1 ]; then
    printf '%s' "$DV_AWS_CREDS_B64" | base64 -d > "$HOME/.aws/credentials"
    printf '%s' "$DV_AWS_CONFIG_B64" | base64 -d > "$HOME/.aws/config"
    chmod 600 "$HOME/.aws/credentials" "$HOME/.aws/config"
    {
      printf 'export AWS_PROFILE=devflow\n'
      printf 'export AWS_SDK_LOAD_CONFIG=1\n'
      printf 'export AWS_CREDENTIAL_EXPIRATION=%q\n' "$DV_AWS_EXPIRATION"
      printf 'export DEVFLOW_AWS_EXPIRATION=%q\n' "$DV_AWS_EXPIRATION"
    } > "$DV_DIR/aws.env"
    chmod 600 "$DV_DIR/aws.env"
    printf '%s' "$DV_AWS_EXPIRATION" > "$DV_DIR/aws-expiration"
    printf '%s' "$DV_AWS_SOURCE_PROFILE" > "$DV_DIR/aws-profile"
    chmod 600 "$DV_DIR/aws-expiration" "$DV_DIR/aws-profile"
    if [ -n "$DV_AWS_EXPIRATION" ]; then
      log "aws auth: temporary session applied (expires $DV_AWS_EXPIRATION)"
    else
      log "aws auth: explicitly allowed static credentials applied"
    fi
  fi

  if [ -n "${DV_SECRET_ENV_B64:-}" ]; then
    printf '%s' "$DV_SECRET_ENV_B64" | base64 -d > "$DV_DIR/forwarded.env"
    chmod 600 "$DV_DIR/forwarded.env"
    printf '%s' "$DV_SECRET_ENV_NAMES" > "$DV_DIR/forwarded-env-names"
    chmod 600 "$DV_DIR/forwarded-env-names"
    log "forwarded env: named variables applied ($DV_SECRET_ENV_NAMES)"
  fi

  if command -v shred >/dev/null 2>&1; then shred -u "$DV_STAGE/secrets.env" 2>/dev/null || rm -f "$DV_STAGE/secrets.env"
  else rm -f "$DV_STAGE/secrets.env"; fi
  umask 022
  log "auth done."
}

# ============================ phase: workspace ================================
phase_workspace() {
  log "phase 3/4 workspace: repo + dotfiles + session…"

  # ---- repo ----
  local WORKDIR
  if [ -n "$DV_REPO" ]; then
    WORKDIR="$HOME/$DV_WORKROOT/${DV_REPO##*/}"
    if [ ! -d "$WORKDIR/.git" ]; then
      log "cloning $DV_REPO…"
      mkdir -p "$HOME/$DV_WORKROOT"
      if [ -n "$DV_BRANCH" ]; then
        git clone --branch "$DV_BRANCH" "https://github.com/$DV_REPO.git" "$WORKDIR" 2>/dev/null \
          || { git clone "https://github.com/$DV_REPO.git" "$WORKDIR" \
               && git -C "$WORKDIR" checkout -b "$DV_BRANCH"; } \
          || fail "clone failed for $DV_REPO (private? check gh auth)"
      else
        git clone "https://github.com/$DV_REPO.git" "$WORKDIR" || fail "clone failed for $DV_REPO"
      fi
    elif [ -n "$DV_BRANCH" ]; then
      git -C "$WORKDIR" checkout "$DV_BRANCH" 2>/dev/null || git -C "$WORKDIR" checkout -b "$DV_BRANCH" || true
    fi
  else
    WORKDIR="$HOME/$DV_WORKROOT/scratch"
    mkdir -p "$WORKDIR"
  fi
  printf '%s' "$WORKDIR"        > "$DV_DIR/workdir"
  printf '%s' "$DV_AGENT"       > "$DV_DIR/agent"
  printf '%s' "$DV_NAME"        > "$DV_DIR/name"
  printf '%s' "${DV_REPO:-}"    > "$DV_DIR/repo"
  touch "$DV_DIR/autotmux"

  if [ -n "$DV_TASK_B64" ]; then
    umask 077
    printf '%s' "$DV_TASK_B64" | base64 -d > "$DV_DIR/task"
    umask 022
    log "task queued for the agent"
  fi

  # ---- claude harness ----
  if [ ! -f "$HOME/.claude.json" ]; then
    cat > "$HOME/.claude.json" <<DV_CLAUDEJSON
{
  "hasCompletedOnboarding": true,
  "bypassPermissionsModeAccepted": true,
  "theme": "dark",
  "projects": {
    "$WORKDIR": {
      "hasTrustDialogAccepted": true,
      "hasCompletedProjectOnboarding": true
    }
  }
}
DV_CLAUDEJSON
  elif command -v jq >/dev/null 2>&1; then
    local tmpj
    tmpj="$(mktemp)"
    jq --arg wd "$WORKDIR" '.hasCompletedOnboarding = true
      | .bypassPermissionsModeAccepted = true
      | .projects[$wd] = ((.projects[$wd] // {}) + {hasTrustDialogAccepted: true, hasCompletedProjectOnboarding: true})' \
      "$HOME/.claude.json" > "$tmpj" && mv "$tmpj" "$HOME/.claude.json"
  fi

  if [ ! -f "$HOME/.claude/settings.json" ]; then
    cat > "$HOME/.claude/settings.json" <<'DV_SETTINGS'
{
  "statusLine": {
    "type": "command",
    "command": "~/.devflow/bin/dv-statusline",
    "padding": 0
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  }
}
DV_SETTINGS
  fi

  if [ ! -f "$HOME/.claude/CLAUDE.md" ]; then
    cat > "$HOME/.claude/CLAUDE.md" <<'DV_CLAUDEMD'
# devflow sandbox

You are running inside a disposable **Daytona cloud sandbox** provisioned by
devflow. Facts about this environment:

- The sandbox is yours alone: installing packages, editing system config, and
  long-running processes are all fine. Prefer acting over asking.
- The working repository is checked out under `~/work/`. Do your work there.
- `gh` is authenticated as the sandbox owner. Push to feature branches and
  open PRs with `gh pr create`; never force-push `main` unless explicitly
  asked.
- Git identity is already configured. Commit early and often — committed and
  pushed work is the only durable work if the sandbox is deleted.
- The session runs inside tmux (session `dv`). The user may detach and
  reattach at any time; you may be resumed mid-task. If resumed, run
  `git status` and skim recent commits to re-establish context first.
- Permission prompts are bypassed. Be deliberate with destructive commands;
  prefer reversible operations.

## Multi-agent

Specialized subagents are installed — delegate instead of doing everything
in one context:

- `dv-engineer` (implementation), `dv-designer` (UX/API design),
  `dv-security` (security review) are always available. Use dv-security
  proactively after changes that touch auth, input handling, or secrets.
- If oh-my-claudecode is installed (check: `/help` lists `/autopilot`),
  prefer its workflows for big tasks: `/autopilot "…"` for autonomous
  builds, `/team N:executor "…"` for parallel work, `/ultrawork` for
  max-effort passes; its roster includes architect, designer,
  security-reviewer, test-engineer, and more.
DV_CLAUDEMD
  fi

  # ---- codex harness ----
  if [ ! -f "$HOME/.codex/config.toml" ]; then
    cat > "$HOME/.codex/config.toml" <<DV_CODEXCFG
# devflow harness — the Daytona sandbox is the isolation boundary, so codex
# itself runs with full autonomy inside it.
approval_policy = "never"
sandbox_mode = "danger-full-access"
forced_login_method = "chatgpt"
cli_auth_credentials_store = "file"

[projects."$WORKDIR"]
trust_level = "trusted"
DV_CODEXCFG
  fi

  if [ ! -f "$HOME/.codex/AGENTS.md" ]; then
    cat > "$HOME/.codex/AGENTS.md" <<'DV_AGENTSMD'
# devflow sandbox

You are running inside a disposable Daytona cloud sandbox provisioned by
devflow. The working repository is under `~/work/`. `gh` is authenticated —
push to feature branches and open PRs with `gh pr create`. Git identity is
configured; commit early and often since only pushed work survives sandbox
deletion. You run with full autonomy (no approval prompts) — be deliberate
with destructive commands. You may be detached from and resumed at any time;
on resume, check `git status` first.

If oh-my-codex is installed (the `omx` command exists), its workflows and
agent teams are available — prefer `$ultragoal`-style structured workflows
for large tasks, and consult its skills before hand-rolling orchestration.
DV_AGENTSMD
  fi

  # ---- tmux ----
  if [ ! -f "$HOME/.tmux.conf" ]; then
    cat > "$HOME/.tmux.conf" <<'DV_TMUXCONF'
# devflow tmux defaults
set -g mouse on
set -g history-limit 100000
set -g default-terminal "screen-256color"
set -g status-style "bg=colour24,fg=colour255"
set -g status-left "#[bold] devflow:#S "
set -g status-left-length 30
set -g status-right "#[fg=colour255]%H:%M "
set -g allow-rename off
set -g automatic-rename off
setw -g aggressive-resize on
DV_TMUXCONF
  fi

  # ---- shell integration ----
  cat > "$DV_DIR/shellrc" <<'DV_SHELLRC'
# devflow shell integration (sourced from ~/.bashrc and ~/.profile)
[ -n "${DEVFLOW_SHELLRC_RAN:-}" ] && return 0
DEVFLOW_SHELLRC_RAN=1; export DEVFLOW_SHELLRC_RAN

export PATH="$HOME/.local/bin:$HOME/.devflow/bin:$PATH"
[ -f "$HOME/.devflow/env" ] && . "$HOME/.devflow/env"
export DEVFLOW_SANDBOX=1
DEVFLOW_NAME="$(cat "$HOME/.devflow/name" 2>/dev/null || echo sandbox)"
export DEVFLOW_NAME

alias dv-work='cd "$(cat "$HOME/.devflow/workdir" 2>/dev/null || echo "$HOME")"'
alias yolo='claude --dangerously-skip-permissions'

# Auto-attach the devflow tmux session on interactive SSH logins, so
# `devflow attach` / `daytona ssh` drop straight into the agent.
if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${TMUX:-}" ] && [ -t 0 ] \
   && [ -f "$HOME/.devflow/autotmux" ] && command -v tmux >/dev/null 2>&1; then
  case "$-" in
    *i*)
      "$HOME/.devflow/bin/dv-ensure" >/dev/null 2>&1
      tmux new-session -A -s dv
      printf '\n[devflow] detached — "exit" to close, "tmux attach -t dv" to rejoin.\n'
      ;;
  esac
fi
DV_SHELLRC

  local rcfile
  for rcfile in "$HOME/.bashrc" "$HOME/.profile"; do
    if ! grep -q 'devflow/shellrc' "$rcfile" 2>/dev/null; then
      {
        printf '\n# --- devflow ---\n'
        printf '[ -f "$HOME/.devflow/shellrc" ] && . "$HOME/.devflow/shellrc"\n'
      } >> "$rcfile"
    fi
  done

  # ---- in-sandbox helper scripts ----
  cat > "$DV_BIN/dv-agent" <<'DV_DVAGENT'
#!/usr/bin/env bash
# dv-agent [claude|codex] — launch the coding agent in the work directory,
# resuming the previous conversation when one exists.
set -u
set -o pipefail
DV_DIR="$HOME/.devflow"
RUN_DIR="$DV_DIR/run"
AGENT="${1:-$(cat "$HOME/.devflow/agent" 2>/dev/null || echo claude)}"
WORKDIR="$(cat "$HOME/.devflow/workdir" 2>/dev/null || echo "$HOME")"
cd "$WORKDIR" 2>/dev/null || cd "$HOME"
[ -f "$HOME/.devflow/env" ] && . "$HOME/.devflow/env"
export PATH="$HOME/.local/bin:$HOME/.devflow/bin:$PATH"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"

TASK=""
TASK_FILE="$RUN_DIR/task.txt"
if [ -f "$DV_DIR/task" ]; then
  mv -f "$DV_DIR/task" "$TASK_FILE"
  chmod 600 "$TASK_FILE"
  TASK=1
fi
STARTED_AT="$(date -u +%FT%TZ)"
COMPLETED_AT=""
PROMPT_SHA=""
if [ -n "$TASK" ]; then
  if command -v sha256sum >/dev/null 2>&1; then
    PROMPT_SHA="$(sha256sum "$TASK_FILE" | awk '{print $1}')"
  else
    PROMPT_SHA="$(shasum -a 256 "$TASK_FILE" | awk '{print $1}')"
  fi
fi

status_write() { # STATE [EXIT_CODE]
  local state="$1" exit_code="${2:-}" tmp="$RUN_DIR/status.tmp.$$"
  {
    printf 'state=%s\n' "$state"
    printf 'agent=%s\n' "$AGENT"
    printf 'pid=%s\n' "$$"
    printf 'started_at=%s\n' "$STARTED_AT"
    [ -n "$COMPLETED_AT" ] && printf 'completed_at=%s\n' "$COMPLETED_AT"
    [ -n "$PROMPT_SHA" ] && printf 'prompt_sha256=%s\n' "$PROMPT_SHA"
    [ -n "$exit_code" ] && printf 'exit_code=%s\n' "$exit_code"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$RUN_DIR/status"
}

CLAUDE_FLAGS="--dangerously-skip-permissions"
if [ "$(id -u)" = "0" ]; then
  # claude refuses bypass mode as root
  CLAUDE_FLAGS="--permission-mode acceptEdits"
fi

has_claude_history() {
  local munged
  munged="$(printf '%s' "$WORKDIR" | sed 's|[/._]|-|g')"
  ls "$HOME/.claude/projects/$munged"/*.jsonl >/dev/null 2>&1
}

case "$AGENT" in
  codex)
    if [ -n "$TASK" ]; then
      : > "$RUN_DIR/agent.log"
      chmod 600 "$RUN_DIR/agent.log"
      status_write running
      codex exec --dangerously-bypass-approvals-and-sandbox --color never \
        -C "$WORKDIR" -o "$RUN_DIR/last-message.txt" - < "$TASK_FILE" 2>&1 \
        | tee -a "$RUN_DIR/agent.log"
      rc="${PIPESTATUS[0]}"
      COMPLETED_AT="$(date -u +%FT%TZ)"
      chmod 600 "$RUN_DIR/last-message.txt" 2>/dev/null || true
      if [ "$rc" -eq 0 ]; then status_write completed "$rc"
      else status_write failed "$rc"; fi
      exit "$rc"
    fi
    status_write interactive
    if codex resume --last 2>/dev/null; then exit 0; fi
    if command -v omx >/dev/null 2>&1; then exec omx; fi
    exec codex
    ;;
  claude|*)
    if [ -n "$TASK" ]; then
      status_write running
      # shellcheck disable=SC2086
      exec claude $CLAUDE_FLAGS "$(cat "$TASK_FILE")"
    fi
    status_write interactive
    if has_claude_history; then
      # shellcheck disable=SC2086
      claude $CLAUDE_FLAGS --continue || exec claude $CLAUDE_FLAGS
    else
      # shellcheck disable=SC2086
      exec claude $CLAUDE_FLAGS
    fi
    ;;
esac
DV_DVAGENT
  chmod +x "$DV_BIN/dv-agent"

  cat > "$DV_BIN/dv-task-start" <<'DV_TASKSTART'
#!/usr/bin/env bash
# Start one queued task in a fresh tmux agent window without attaching.
set -u
DV_DIR="$HOME/.devflow"
RUN_DIR="$DV_DIR/run"
WORKDIR="$(cat "$DV_DIR/workdir" 2>/dev/null || echo "$HOME")"
AGENT="$(cat "$DV_DIR/agent" 2>/dev/null || echo claude)"
INCOMING="${1:-}"
AGENT_OVERRIDE="${2:-}"
export PATH="$HOME/.local/bin:$DV_DIR/bin:$PATH"
command -v tmux >/dev/null 2>&1 || { echo "tmux is not installed" >&2; exit 1; }

state="$(sed -n 's/^state=//p' "$RUN_DIR/status" 2>/dev/null | head -1)"
pid="$(sed -n 's/^pid=//p' "$RUN_DIR/status" 2>/dev/null | head -1)"
if [ "$state" = "running" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
  echo "an agent task is already running (pid $pid)" >&2
  exit 2
fi
if [ -n "$AGENT_OVERRIDE" ]; then
  case "$AGENT_OVERRIDE" in claude|codex|both) AGENT="$AGENT_OVERRIDE" ;; *) echo "invalid agent override" >&2; exit 1 ;; esac
  printf '%s' "$AGENT" > "$DV_DIR/agent"
fi
[ "$AGENT" != "none" ] || { echo "sandbox agent is set to none" >&2; exit 1; }
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
if [ -n "$INCOMING" ]; then
  [ -f "$INCOMING" ] || { echo "incoming task file not found" >&2; exit 1; }
  mv -f "$INCOMING" "$DV_DIR/task"
  chmod 600 "$DV_DIR/task"
fi
[ -f "$DV_DIR/task" ] || { echo "no queued task" >&2; exit 1; }
printf 'state=queued\nagent=%s\n' "$AGENT" > "$RUN_DIR/status"
chmod 600 "$RUN_DIR/status"

if ! tmux has-session -t dv 2>/dev/null; then
  tmux new-session -d -s dv -n shell -c "$WORKDIR"
elif ! tmux list-windows -t dv -F '#{window_name}' | grep -qx shell; then
  tmux new-window -d -t dv -n shell -c "$WORKDIR"
fi
tmux kill-window -t dv:agent 2>/dev/null || true
tmux new-window -d -t dv -n agent -c "$WORKDIR"
tmux send-keys -t dv:agent "dv-agent $AGENT" C-m
tmux select-window -t dv:agent
echo "agent task started in tmux window dv:agent"
DV_TASKSTART
  chmod +x "$DV_BIN/dv-task-start"

  cat > "$DV_BIN/dv-ensure" <<'DV_DVENSURE'
#!/usr/bin/env bash
# dv-ensure — make sure the devflow tmux session exists (agent + shell windows)
set -u
command -v tmux >/dev/null 2>&1 || exit 0
WORKDIR="$(cat "$HOME/.devflow/workdir" 2>/dev/null || echo "$HOME")"
AGENT="$(cat "$HOME/.devflow/agent" 2>/dev/null || echo claude)"
export PATH="$HOME/.local/bin:$HOME/.devflow/bin:$PATH"

if ! tmux has-session -t dv 2>/dev/null; then
  tmux new-session -d -s dv -n shell -c "$WORKDIR"
fi
if ! tmux list-windows -t dv -F '#{window_name}' | grep -qx shell; then
  tmux new-window -d -t dv -n shell -c "$WORKDIR"
fi
case "$AGENT" in
  none)
    if ! tmux list-windows -t dv -F '#{window_name}' | grep -qx agent; then
      tmux new-window -d -t dv -n agent -c "$WORKDIR"
    fi
    ;;
  both)
    if ! tmux list-windows -t dv -F '#{window_name}' | grep -qx agent; then
      tmux new-window -d -t dv -n agent -c "$WORKDIR"
      tmux send-keys -t dv:agent "dv-agent claude" C-m
    fi
    if ! tmux list-windows -t dv -F '#{window_name}' | grep -qx codex; then
      tmux new-window -d -t dv -n codex -c "$WORKDIR"
      tmux send-keys -t dv:codex "dv-agent codex" C-m
    fi
    ;;
  *)
    if ! tmux list-windows -t dv -F '#{window_name}' | grep -qx agent; then
      tmux new-window -d -t dv -n agent -c "$WORKDIR"
      tmux send-keys -t dv:agent "dv-agent $AGENT" C-m
    fi
    ;;
esac
if tmux list-windows -t dv -F '#{window_name}' | grep -qx agent; then
  tmux select-window -t dv:agent
else
  tmux select-window -t dv:shell
fi
DV_DVENSURE
  chmod +x "$DV_BIN/dv-ensure"

  cat > "$DV_BIN/dv-statusline" <<'DV_STATUSLINE'
#!/usr/bin/env bash
# claude code statusline: sandbox · model · dir · branch · context
input="$(cat)"
name="$(cat "$HOME/.devflow/name" 2>/dev/null || echo sandbox)"
if command -v jq >/dev/null 2>&1; then
  model="$(printf '%s' "$input" | jq -r '.model.display_name // "?"')"
  dir="$(printf '%s' "$input" | jq -r '.workspace.current_dir // "?"')"
  ctx="$(printf '%s' "$input" | jq -r '.context_window.used_percentage // empty' 2>/dev/null)"
else
  model="?"; dir="$PWD"; ctx=""
fi
branch="$(git -C "$dir" branch --show-current 2>/dev/null)"
out="☁ $name · $model · ${dir/#$HOME/~}"
[ -n "$branch" ] && out="$out · $branch"
[ -n "$ctx" ] && out="$out · ctx ${ctx%%.*}%"
printf '%s' "$out"
DV_STATUSLINE
  chmod +x "$DV_BIN/dv-statusline"

  # ---- start the session ----
  # dv-ensure preserves existing windows. A queued task must instead replace
  # an idle or previously failed agent window so it cannot remain stranded.
  if [ -n "$DV_TASK_B64" ]; then
    "$DV_BIN/dv-task-start"
  else
    "$DV_BIN/dv-ensure"
  fi
  printf '%s' "$DV_PROVISION_VERSION" > "$DV_DIR/provisioned"
  log "workspace ready: agent=$DV_AGENT repo=${DV_REPO:-none} workdir=$WORKDIR"
}

# ============================ phase: harness ==================================
install_dv_subagents() {
  # devflow-native mini-team for Claude Code (always installed; dv- prefix
  # avoids collisions with oh-my-claudecode's own roster)
  mkdir -p "$HOME/.claude/agents"

  if [ ! -f "$HOME/.claude/agents/dv-engineer.md" ]; then
    cat > "$HOME/.claude/agents/dv-engineer.md" <<'DV_AG_ENG'
---
name: dv-engineer
description: Senior implementation engineer. Use for writing, refactoring, and debugging code once an approach is decided — turns a plan or bug report into working, tested changes.
---

You are a senior software engineer working inside a disposable cloud sandbox.
You own implementation quality: correct, minimal, idiomatic changes that match
the surrounding codebase.

- Read the relevant code before changing it; follow the repo's existing
  patterns, naming, and tooling.
- Prefer the smallest change that fully solves the problem. No drive-by
  refactors unless asked.
- Run the project's tests/linters after changes; fix what you break. If there
  are no tests, add focused ones for the behavior you changed.
- Commit logically-scoped changes with clear messages as you go.
- Report back: what changed, why, how it was verified, and any follow-ups.
DV_AG_ENG
  fi

  if [ ! -f "$HOME/.claude/agents/dv-designer.md" ]; then
    cat > "$HOME/.claude/agents/dv-designer.md" <<'DV_AG_DES'
---
name: dv-designer
description: Product/UX and API designer. Use before building user-facing surfaces or public interfaces — turns requirements into concrete flows, layouts, naming, and API shapes.
---

You are a pragmatic product designer who thinks in user flows and interface
contracts (UI and API alike).

- Start from the user's job-to-be-done; enumerate the primary flow and the two
  most likely edge flows before proposing surfaces.
- For UI: propose hierarchy, states (empty/loading/error), and copy. Favor
  conventions of the project's existing stack over novelty.
- For APIs/CLIs: design the smallest coherent surface; name things the way the
  codebase already names things; show example calls before writing code.
- Deliver artifacts the engineer can build from directly: annotated flows,
  component/endpoint lists, example payloads — not vague principles.
DV_AG_DES
  fi

  if [ ! -f "$HOME/.claude/agents/dv-security.md" ]; then
    cat > "$HOME/.claude/agents/dv-security.md" <<'DV_AG_SEC'
---
name: dv-security
description: Security reviewer. Use proactively after changes touching auth, input handling, secrets, network, file access, or dependencies — finds and explains real vulnerabilities with fixes.
---

You are an application security reviewer. Hunt for vulnerabilities that are
actually exploitable in this codebase — not theoretical checklist items.

- Priorities: injection (SQL/shell/template), authn/authz gaps, secret
  handling and logging, unsafe deserialization, path traversal, SSRF, unsafe
  defaults, and dependency risk.
- For each finding: the exact location, a concrete attack scenario, severity,
  and the minimal fix. Verify the fix compiles/tests when you apply one.
- Distinguish "exploitable now" from "hardening"; lead with the former.
- End with a short verdict: safe to ship, or blockers listed in order.
DV_AG_SEC
  fi
}

# Shared npm-harness installer: install the package if its main bin is
# missing, symlink bins where non-interactive shells can see them, then run
# the tool's own idempotent setup. Everything best-effort: failures warn into
# the per-tool log and the session stays usable on the core harness.
install_harness_tool() { # LABEL NPM_PKG MAIN_BIN SETUP_CMD READY_MSG [EXTRA_BINS…]
  local label="$1" pkg="$2" mainbin="$3" setup_cmd="$4" ready="$5" b
  shift 5
  if ! command -v "$mainbin" >/dev/null 2>&1; then
    log "installing $label…"
    npm install -g "$pkg@latest" > "$DV_DIR/$mainbin-install.log" 2>&1 \
      || log "warn: $mainbin npm install failed (see ~/.devflow/$mainbin-install.log)"
    ensure_node_path
    link_global_bin "$mainbin"
    for b in "$@"; do link_global_bin "$b"; done
  fi
  if command -v "$mainbin" >/dev/null 2>&1; then
    # shellcheck disable=SC2086  # setup_cmd is a controlled argv string
    if $setup_cmd </dev/null >> "$DV_DIR/$mainbin-install.log" 2>&1; then
      log "$ready"
    else
      log "warn: $mainbin setup failed:"
      tail -n 6 "$DV_DIR/$mainbin-install.log" 2>/dev/null | sed 's/^/[devflow]   /'
    fi
  fi
}

phase_harness() {
  log "phase 4/4 harness: multi-agent setup ($DV_HARNESS)…"

  case "$DV_HARNESS" in
    omc|omx|both)
      if ! ensure_npm; then
        log "warn: npm unavailable — skipped $DV_HARNESS install (core harness still active)"
        DV_HARNESS=core
      fi
      ;;
  esac

  if [ "$DV_HARNESS" = "omc" ] || [ "$DV_HARNESS" = "both" ]; then
    install_harness_tool "oh-my-claudecode (this can take a minute)" \
      oh-my-claude-sisyphus omc \
      "omc setup --no-plugin --force --quiet" \
      "omc ready: /autopilot, /ultrawork, /team (architect, designer, security-reviewer, +26 more)" \
      oh-my-claudecode omc-cli
  fi

  if [ "$DV_HARNESS" = "omx" ] || [ "$DV_HARNESS" = "both" ]; then
    install_harness_tool "oh-my-codex" \
      oh-my-codex omx \
      "omx setup --scope user --merge-agents --force" \
      "omx ready: launch codex sessions with 'omx' (\$ultragoal keywords, agent teams)"
  fi

  # after omc setup: its installer syncs ~/.claude/agents and drops unknown
  # files, so the devflow-native trio must be (re)installed last
  install_dv_subagents
  log "core team ready: dv-engineer / dv-designer / dv-security"

  printf '%s' "$DV_HARNESS" > "$DV_DIR/harness"
  log "harness done."
}

load_secrets   # defaults + secrets file if present (tools needs pins/token too)

case "$DV_PHASE" in
  tools)     phase_tools ;;
  auth)      phase_auth ;;
  workspace) phase_workspace ;;
  harness)   phase_harness ;;
  all)       phase_tools; phase_auth; phase_workspace; phase_harness ;;
  *)         fail "unknown phase: $DV_PHASE" ;;
esac
DVPROV_EOF
}

# ----------------------------------------------------------------------------
# Provision + sync orchestration (local side)
# ----------------------------------------------------------------------------
upload_provisioner() { # NAME [WITH_SECRETS]
  local name="$1" with_secrets="${2:-1}"
  emit_provision_script | dt_push_file "$name" "/tmp/.dv-provision.sh"
  if [ "$with_secrets" = 1 ]; then
    build_secrets_bundle | dt_push_file "$name" "/tmp/.dv-secrets.env"
  fi
  dt_run "$name" 'mkdir -p "$HOME/.devflow/stage" && chmod 700 "$HOME/.devflow" "$HOME/.devflow/stage" && mv -f /tmp/.dv-provision.sh "$HOME/.devflow/stage/provision.sh" && { [ ! -f /tmp/.dv-secrets.env ] || mv -f /tmp/.dv-secrets.env "$HOME/.devflow/stage/secrets.env"; }' 120 >/dev/null
}

run_phase() { # NAME PHASE AGENT REPO BRANCH TASK_B64 [HARNESS]
  local name="$1" phase="$2" agent="$3" repo="$4" branch="$5" task_b64="$6" harness="${7:-core}"
  dt_run "$name" "DV_PHASE='$phase' DV_AGENT='$agent' DV_REPO='$repo' DV_BRANCH='$branch' DV_NAME='$name' DV_TASK_B64='$task_b64' DV_WORKROOT='$DEVFLOW_WORKROOT' DV_HARNESS='$harness' bash \"\$HOME/.devflow/stage/provision.sh\"" 0
}

run_phase_clean() { # successful phases stay quiet; warnings and failures remain visible
  local output rc warnings
  if output="$(run_phase "$@" 2>&1)"; then
    warnings="$(printf '%s\n' "$output" | sed -n 's/^\[devflow\] warn: //p')"
    if [ -n "$warnings" ]; then
      while IFS= read -r line; do warn "$line"; done <<EOF
$warnings
EOF
    fi
    return 0
  else
    rc=$?
  fi
  [ -z "$output" ] || printf '%s\n' "$output" >&2
  return "$rc"
}

provision_sandbox() { # NAME AGENT REPO BRANCH TASK HARNESS
  local name="$1" agent="$2" repo="$3" branch="$4" task="$5" harness="$6" task_b64=""
  [ -n "$task" ] && task_b64="$(printf '%s' "$task" | b64_encode)"

  step "uploading provisioner + syncing subscription auth…"
  upload_provisioner "$name" 1

  step "installing tools (tmux, gh, claude, codex)…"
  run_phase_clean "$name" tools "$agent" "$repo" "$branch" "$task_b64" "$harness" \
    || die "sandbox tools phase failed; task was not queued"

  step "applying auth…"
  run_phase_clean "$name" auth "$agent" "$repo" "$branch" "$task_b64" "$harness" \
    || die "sandbox auth phase failed; task was not queued"

  step "setting up workspace + starting agent session…"
  run_phase_clean "$name" workspace "$agent" "$repo" "$branch" "$task_b64" "$harness" \
    || die "sandbox workspace phase failed; task was not queued"

  step "installing multi-agent harness ($harness)…"
  run_phase_clean "$name" harness "$agent" "$repo" "$branch" "$task_b64" "$harness" \
    || die "sandbox harness phase failed; task was not queued"
}

sandbox_is_provisioned() { # NAME
  local got
  got="$(dt_run "$1" 'cat "$HOME/.devflow/provisioned" 2>/dev/null || true' 60 2>/dev/null | tail -1)"
  [ "$got" = "$DV_EXPECTED_PROVISION_VERSION" ]
}

agent_task_state() { # NAME
  dt_run "$1" 'i=0; state=""; while [ "$i" -lt 30 ]; do state="$(sed -n "s/^state=//p" "$HOME/.devflow/run/status" 2>/dev/null | head -1)"; case "$state" in running|completed|failed) break ;; esac; i=$((i + 1)); sleep 1; done; printf "%s\n" "${state:-not-started}"' 60 2>/dev/null | tail -1
}

verify_agent_task_started() { # NAME
  local state
  state="$(agent_task_state "$1")"
  case "$state" in
    running|completed) ok "agent task state: $state" ;;
    failed) die "agent task exited immediately (inspect: devflow peek $1; devflow status $1)" ;;
    *) die "agent task did not start (state: ${state:-unknown}; inspect: devflow status $1)" ;;
  esac
}

queue_agent_task() { # NAME TASK [AGENT_OVERRIDE]
  local name="$1" task="$2" agent_override="${3:-}" start_output
  [ -n "$task" ] || return 0
  printf '%s' "$task" | dt_push_file "$name" "/tmp/.dv-task"
  step "starting detached agent task…"
  if ! start_output="$(dt_run "$name" '"$HOME/.devflow/bin/dv-task-start" /tmp/.dv-task '"$agent_override" 60 2>&1)"; then
    [ -z "$start_output" ] || printf '%s\n' "$start_output" >&2
    dt_run "$name" 'rm -f /tmp/.dv-task' 60 >/dev/null 2>&1 || true
    die "could not start task — another agent task may already be running (check: devflow status $name)"
  fi
  verify_agent_task_started "$name"
}

ensure_running() { # NAME — start if stopped/archived
  local st
  st="$(sandbox_state "$1")"
  case "$st" in
    started) return 0 ;;
    missing) die "no sandbox named '$1' — run: devflow up" ;;
    stopped|archived)
      step "sandbox is $st — starting…"
      dt start "$1" >/dev/null
      wait_for_state "$1" started 300
      ;;
    *)
      step "sandbox state: $st — waiting for it to start…"
      wait_for_state "$1" started 300
      ;;
  esac
}

# ----------------------------------------------------------------------------
# Sandbox listing / resolution
# ----------------------------------------------------------------------------
devflow_sandboxes_json() {
  dt list -f json 2>/dev/null \
    | jq '(if type == "object" then (.items // .sandboxes // .result // []) else . end)
          | [ .[] | select(((.labels // {})["devflow"] // "") == "1") ]'
}

resolve_name() { # [ARG] -> NAME (auto-picks when unambiguous)
  local arg="${1:-}"
  if [ -n "$arg" ]; then printf '%s' "$arg"; return 0; fi
  local names count
  names="$(devflow_sandboxes_json | jq -r '.[] | (.name // .id // empty)' 2>/dev/null || true)"
  count="$(printf '%s' "$names" | grep -c . 2>/dev/null || true)"
  if [ "$count" = "1" ]; then printf '%s' "$names"; return 0; fi
  if [ "$count" = "0" ] || [ -z "$count" ]; then die "no devflow sandboxes — run: devflow up"; fi
  if have_cmd fzf && [ -t 0 ]; then
    printf '%s\n' "$names" | fzf --height=40% --reverse --prompt='sandbox> '
  else
    err "multiple sandboxes — specify one of:"
    printf '%s\n' "$names" >&2
    exit 1
  fi
}

# ----------------------------------------------------------------------------
# User scripts (up --script FILE) + Daytona forwarding (up --with-daytona)
# ----------------------------------------------------------------------------
emit_script_launcher() { # in-sandbox: start user-script.sh in tmux window 'script'
cat <<'DV_SCRIPTLAUNCH'
#!/usr/bin/env bash
# dv-script — run ~/.devflow/user-script.sh detach-safe (tmux window 'script')
set -u
export PATH="$HOME/.local/bin:$HOME/.devflow/bin:$PATH"
WD="$(cat "$HOME/.devflow/workdir" 2>/dev/null || echo "$HOME")"
"$HOME/.devflow/bin/dv-ensure" 2>/dev/null || true
if command -v tmux >/dev/null 2>&1 && tmux has-session -t dv 2>/dev/null; then
  tmux kill-window -t dv:script 2>/dev/null || true
  tmux new-window -d -t dv -n script -c "$WD" "$HOME/.devflow/bin/dv-script-exec"
  echo "script started in tmux window 'script'"
else
  nohup "$HOME/.devflow/bin/dv-script-exec" >/dev/null 2>&1 &
  echo "script started headless (log: ~/.devflow/script.log)"
fi
DV_SCRIPTLAUNCH
}

emit_script_exec() { # in-sandbox: the actual runner — tee to log, report exit
cat <<'DV_SCRIPTEXEC'
#!/usr/bin/env bash
set -u
export PATH="$HOME/.local/bin:$HOME/.devflow/bin:$PATH"
cd "$(cat "$HOME/.devflow/workdir" 2>/dev/null || echo "$HOME")" 2>/dev/null || cd "$HOME"
LOG="$HOME/.devflow/script.log"
bash "$HOME/.devflow/user-script.sh" 2>&1 | tee "$LOG"
ec="${PIPESTATUS[0]}"
printf '[devflow script exit: %s]\n' "$ec" >> "$LOG"
if [ -n "${TMUX:-}" ]; then
  printf '[devflow script exit: %s] — window stays open for inspection (Ctrl-b d detaches)\n' "$ec"
  exec bash
fi
exit "$ec"
DV_SCRIPTEXEC
}

run_user_script() { # NAME LOCAL_FILE — upload + launch; best-effort (caller warns)
  local name="$1" file="$2" launch_output
  step "uploading ${C_BOLD}$(basename "$file")${C_RESET} → running in tmux window 'script'…"
  dt_push_file "$name" "/tmp/.dv-user-script" < "$file" || return 1
  emit_script_launcher | dt_push_file "$name" "/tmp/.dv-script" || return 1
  emit_script_exec | dt_push_file "$name" "/tmp/.dv-script-exec" || return 1
  if ! launch_output="$(dt_run "$name" 'mkdir -p "$HOME/.devflow/bin" && mv /tmp/.dv-user-script "$HOME/.devflow/user-script.sh" && mv /tmp/.dv-script "$HOME/.devflow/bin/dv-script" && mv /tmp/.dv-script-exec "$HOME/.devflow/bin/dv-script-exec" && chmod +x "$HOME/.devflow/user-script.sh" "$HOME/.devflow/bin/dv-script" "$HOME/.devflow/bin/dv-script-exec" && "$HOME/.devflow/bin/dv-script"' 60 2>&1)"; then
    [ -z "$launch_output" ] || printf '%s\n' "$launch_output" >&2
    return 1
  fi
  ok "script running — watch: ${C_BOLD}devflow peek $name -w script${C_RESET} · log: devflow exec $name -- 'cat ~/.devflow/script.log'"
  return 0
}

sandbox_daytona_key() { # sets DT_SANDBOX_KEY: durable, VALIDATED API key (mints + caches once)
  # requires resolve_daytona_api to have run (DT_API_KEY/DT_API_URL/DT_ORG_ID set)
  DT_SANDBOX_KEY=""
  if [ -n "$DEVFLOW_DAYTONA_SANDBOX_KEY" ]; then
    if dt_key_valid "$DEVFLOW_DAYTONA_SANDBOX_KEY"; then
      DT_SANDBOX_KEY="$DEVFLOW_DAYTONA_SANDBOX_KEY"; return 0
    fi
    warn "cached devflow-sandboxes key was revoked — minting a fresh one"
  fi
  case "$DT_API_KEY" in
    dtn_*)  # already a durable key (env var or api-key login) — but verify it
      if dt_key_valid "$DT_API_KEY"; then DT_SANDBOX_KEY="$DT_API_KEY"; return 0; fi
      warn "local Daytona API key is stale (check DAYTONA_API_KEY in your shell env) — minting a fresh one"
      ;;
  esac
  # mint a dedicated, revocable, sandbox-scoped key and cache it (0600 secrets).
  # bearer: prefer the browser-login OAuth token; /api-keys needs a live credential
  local bearer="${DT_OAUTH_TOKEN:-$DT_API_KEY}" resp val
  [ -n "$DT_ORG_ID" ] || { warn "no active Daytona organization in CLI config (run: daytona login)"; return 1; }
  resp="$(curl -fsSL -X POST -H "Authorization: Bearer $bearer" \
          -H "X-Daytona-Organization-ID: $DT_ORG_ID" -H "Content-Type: application/json" \
          -d '{"name":"devflow-sandboxes","permissions":["write:sandboxes","delete:sandboxes"]}' \
          "$DT_API_URL/api-keys" 2>/dev/null)" || {
    # name may already exist from a lost secrets file — replace it (we own the name)
    curl -fsSL -X DELETE -H "Authorization: Bearer $bearer" \
      -H "X-Daytona-Organization-ID: $DT_ORG_ID" \
      "$DT_API_URL/api-keys/devflow-sandboxes" >/dev/null 2>&1
    resp="$(curl -fsSL -X POST -H "Authorization: Bearer $bearer" \
            -H "X-Daytona-Organization-ID: $DT_ORG_ID" -H "Content-Type: application/json" \
            -d '{"name":"devflow-sandboxes","permissions":["write:sandboxes","delete:sandboxes"]}' \
            "$DT_API_URL/api-keys" 2>/dev/null)" || { warn "could not mint a Daytona API key (run: daytona login)"; return 1; }
  }
  val="$(printf '%s' "$resp" | jq -r '.value // empty')"
  [ -n "$val" ] || { warn "unexpected api-keys response"; return 1; }
  config_set "$SECRETS_FILE" DEVFLOW_DAYTONA_SANDBOX_KEY "$val"
  DEVFLOW_DAYTONA_SANDBOX_KEY="$val"
  DT_SANDBOX_KEY="$val"
  step "minted Daytona API key 'devflow-sandboxes' (scope: sandboxes; revoke: app.daytona.io/dashboard/keys)"
}

forward_daytona() { # NAME — daytona CLI + API auth + devflow itself, inside the sandbox
  local name="$1"
  resolve_daytona_api || { warn "no local Daytona credentials (run: daytona login)"; return 1; }
  sandbox_daytona_key || return 1
  local fwd_key="$DT_SANDBOX_KEY"
  step "forwarding Daytona control into ${C_BOLD}$name${C_RESET} (CLI + API key + devflow — ~30s)…"
  local dtv
  dtv="$(daytona version 2>/dev/null | sed -n 's/.*v\([0-9][0-9.]*\).*/\1/p' | head -1)"
  [ -n "$dtv" ] || dtv="$DT_PIN_VERSION"
  # same config schema the daytona CLI writes; 0600 like every devflow secret
  local org_field=""
  [ -n "$DT_ORG_ID" ] && org_field=",\"activeOrganizationId\":\"$DT_ORG_ID\""
  printf '{"activeProfile":"default","profiles":[{"id":"default","name":"default","api":{"url":"%s","key":"%s"}%s}]}' \
      "$DT_API_URL" "$fwd_key" "$org_field" \
    | dt_push_file "$name" "/tmp/.dv-daytona-config" || return 1
  dt_push_file "$name" "/tmp/.dv-devflow" < "$0" || return 1
  # the sandbox image ships its own `daytona` binary (the in-sandbox daemon on
  # /usr/local/bin) — so install the real CLI unconditionally at ~/.local/bin
  # (which shadows it on PATH) and sanity-check it actually IS the CLI
  dt_run "$name" 'mkdir -p "$HOME/.local/bin" "$HOME/.config/daytona" && mv /tmp/.dv-daytona-config "$HOME/.config/daytona/config.json" && chmod 600 "$HOME/.config/daytona/config.json" && mv /tmp/.dv-devflow "$HOME/.local/bin/devflow" && chmod +x "$HOME/.local/bin/devflow" && ln -sf "$HOME/.local/bin/devflow" "$HOME/.local/bin/dv" && { [ -x "$HOME/.local/bin/daytona" ] || { curl -fsSL "https://github.com/daytona/clients/releases/download/v'"$dtv"'/daytona-linux-amd64" -o "$HOME/.local/bin/daytona" && chmod +x "$HOME/.local/bin/daytona" && timeout 10 "$HOME/.local/bin/daytona" version 2>/dev/null | grep -q "Daytona CLI"; }; } && { command -v jq >/dev/null 2>&1 || { curl -fsSL "https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64" -o "$HOME/.local/bin/jq" && chmod +x "$HOME/.local/bin/jq"; }; }' 240 || return 1
  ok "sandbox can now run ${C_BOLD}daytona${C_RESET} + ${C_BOLD}devflow${C_RESET} — new sandboxes it makes are ${C_BOLD}siblings${C_RESET} on your account (bill + need cleanup: devflow rm)"
  return 0
}

# ----------------------------------------------------------------------------
# Commands
# ----------------------------------------------------------------------------
set_forwarding_options() { # AWS_PROFILE SECRET_ENV_NAMES ALLOW_STATIC ENV_ITEMS
  DEVFLOW_AWS_PROFILE="$1"
  DEVFLOW_SECRET_ENV_NAMES="$2"
  DEVFLOW_ALLOW_STATIC_AWS="$3"
  DEVFLOW_ENV_ITEMS="${4:-}"
  _HARVESTED=0
  if [ -n "$DEVFLOW_AWS_PROFILE" ]; then
    need_cmd aws "install AWS CLI v2"
    need_cmd jq "brew install jq"
  fi
}

refresh_forwarded_auth() { # NAME [RUN_TOOLS]
  local name="$1" run_tools="${2:-0}"
  ensure_running "$name"
  step "re-syncing auth and explicitly forwarded credentials into '$name'…"
  upload_provisioner "$name" 1
  if [ "$run_tools" = 1 ]; then
    run_phase "$name" tools "" "" "" "" "core" \
      || die "sandbox tools phase failed; auth was not refreshed"
  fi
  run_phase "$name" auth "" "" "" "" "core" \
    || die "sandbox auth phase failed"
  ok "auth refreshed in '$name'"
}

create_linked_sandbox() { # NAME PARENT AUTO_STOP SNAPSHOT AGENT HARNESS REPO TEAM ROLE MODE
  local name="$1" parent="$2" auto_stop="$3" snapshot="$4" agent="$5"
  local harness="$6" repo="$7" team="$8" role="$9" mode="${10}"
  local parent_id labels payload resp created_id
  need_cmd curl "install curl"
  resolve_daytona_api || die "linked teams need Daytona API credentials — run: daytona login"
  parent_id="$(dt_info_json "$parent" | jq -r '.id // .sandboxId // empty')"
  [ -n "$parent_id" ] || die "could not resolve linked-team parent '$parent'"
  case "$auto_stop" in ''|*[!0-9]*) die "--auto-stop must be a non-negative integer" ;; esac

  labels="$(jq -n \
    --arg agent "$agent" --arg harness "$harness" --arg repo "$repo" \
    --arg team "$team" --arg role "$role" --arg mode "$mode" \
    '{"devflow":"1","devflow.agent":$agent,"devflow.harness":$harness,
      "devflow.team":$team,"devflow.team.role":$role,"devflow.team.mode":$mode}
      + (if $repo == "" then {} else {"devflow.repo":$repo} end)')"
  payload="$(jq -n \
    --arg name "$name" --arg parent "$parent_id" --arg snapshot "$snapshot" \
    --arg auto_stop "$auto_stop" --argjson labels "$labels" \
    '{name:$name, linkedSandbox:$parent, autoDeleteInterval:0,
      autoStopInterval:($auto_stop|tonumber), snapshot:$snapshot, labels:$labels}')"

  if [ -n "$DT_ORG_ID" ]; then
    resp="$(curl -fsSL -X POST \
      -H "Authorization: Bearer $DT_API_KEY" \
      -H "X-Daytona-Organization-ID: $DT_ORG_ID" \
      -H "Content-Type: application/json" \
      -d "$payload" "$DT_API_URL/sandbox" 2>/dev/null)" \
      || die "linked sandbox create failed (team '$team', role '$role')"
  else
    resp="$(curl -fsSL -X POST \
      -H "Authorization: Bearer $DT_API_KEY" \
      -H "Content-Type: application/json" \
      -d "$payload" "$DT_API_URL/sandbox" 2>/dev/null)" \
      || die "linked sandbox create failed (team '$team', role '$role')"
  fi
  created_id="$(printf '%s' "$resp" | jq -r '.id // .sandboxId // empty' 2>/dev/null)"
  [ -n "$created_id" ] || die "Daytona returned no sandbox id for team '$team' role '$role'"
}

cmd_up() {
  local repo="" name="" branch="" agent="$DEVFLOW_AGENT" task="" attach=1 fresh=0 blank=0
  local size="" cpu="$DEVFLOW_CPU" memory="$DEVFLOW_MEMORY" disk="$DEVFLOW_DISK" auto_stop="$DEVFLOW_AUTO_STOP"
  local snapshot="$DEVFLOW_SNAPSHOT" explicit_resources=0 harness="$DEVFLOW_HARNESS"
  local script="" with_daytona=0 aws_profile="" secret_env_names="" env_items="" allow_static_aws=0
  local team="" team_role="" team_mode="" linked_parent=""
  local size_explicit=0 snapshot_explicit=0 agent_explicit=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--agent)   need_val "$1" "${2:-}"; agent="$2"; agent_explicit=1; shift 2 ;;
      -H|--harness) need_val "$1" "${2:-}"; harness="$2"; shift 2 ;;
      -n|--name)    need_val "$1" "${2:-}"; name="$2"; shift 2 ;;
      -b|--branch)  need_val "$1" "${2:-}"; branch="$2"; shift 2 ;;
      -m|--task)    need_val "$1" "${2:-}"; task="$2"; shift 2 ;;
      -s|--size)    need_val "$1" "${2:-}"; size="$2"; size_explicit=1; shift 2 ;;
      --cpu)        need_val "$1" "${2:-}"; cpu="$2"; explicit_resources=1; shift 2 ;;      # legacy
      --memory)     need_val "$1" "${2:-}"; memory="$2"; explicit_resources=1; shift 2 ;;   # legacy
      --disk)       need_val "$1" "${2:-}"; disk="$2"; explicit_resources=1; shift 2 ;;     # legacy
      --auto-stop)  need_val "$1" "${2:-}"; auto_stop="$2"; shift 2 ;;
      --snapshot)   need_val "$1" "${2:-}"; snapshot="$2"; snapshot_explicit=1; shift 2 ;;
      --script)     need_val "$1" "${2:-}"; script="$2"; shift 2 ;;
      --aws-profile) need_val "$1" "${2:-}"; aws_profile="$2"; shift 2 ;;
      --secret-env) need_val "$1" "${2:-}"; secret_env_names="${secret_env_names}${secret_env_names:+ }$2"; shift 2 ;;
      --env) need_val "$1" "${2:-}"; env_items="${env_items}${env_items:+ }$(printf '%s' "$2" | b64_encode)"; shift 2 ;;
      --allow-static-aws) allow_static_aws=1; shift ;;
      --with-daytona) with_daytona=1; shift ;;
      --team)        need_val "$1" "${2:-}"; team="$2"; shift 2 ;;
      --team-role)   need_val "$1" "${2:-}"; team_role="$2"; shift 2 ;;
      --team-mode)   need_val "$1" "${2:-}"; team_mode="$2"; shift 2 ;;
      --linked-parent) need_val "$1" "${2:-}"; linked_parent="$2"; shift 2 ;;
      --no-attach|--detach) attach=0; shift ;;
      --fresh)      fresh=1; shift ;;
      --blank)      blank=1; shift ;;
      --pick)       repo="__PICK__"; shift ;;
      -h|--help)    usage_up; return 0 ;;
      -*)           die "unknown flag for up: $1 (see: devflow up --help)" ;;
      *)            # a positional that names a local file is a script to run
                    if [ -z "$script" ] && [ -f "$1" ]; then script="$1"
                    else repo="$1"; fi
                    shift ;;
    esac
  done
  [ -n "$script" ] && [ ! -f "$script" ] && die "script not found: $script"
  set_forwarding_options "$aws_profile" "$secret_env_names" "$allow_static_aws" "$env_items"
  # Resolve and validate credentials before creating anything billable.
  if [ -n "$aws_profile$secret_env_names$env_items" ]; then harvest_all; fi

  case "$agent" in claude|codex|both|none) ;; *) die "invalid --agent '$agent' (claude|codex|both|none)" ;; esac
  case "$harness" in auto|omc|omx|both|core|none) ;; *) die "invalid --harness '$harness' (auto|omc|omx|both|core|none)" ;; esac
  harness="$(resolve_harness "$agent" "$harness")"

  # --- size (a custom snapshot brings its own; else pick a Daytona size class) ---
  if [ "$size_explicit" = 1 ] && [ "$snapshot_explicit" = 0 ] && [ -n "$snapshot" ]; then
    step "explicit --size overrides configured snapshot '$snapshot'"
    snapshot=""
  fi
  if [ -n "$snapshot" ]; then
    if [ -n "$size" ] || [ "$explicit_resources" = 1 ]; then
      step "note: --size/--cpu/--memory/--disk ignored — snapshot '$snapshot' has its size baked in (want another? devflow snapshot build --size ${size:-small|medium|large}, or --snapshot to pick)"
    fi
  else
    if [ -z "$size" ] && [ "$explicit_resources" = 1 ]; then
      size="$(size_for_resources "$cpu" "$memory" "$disk")"
      step "note: Daytona sizes sandboxes in classes now — --cpu/--memory/--disk map to --size $size ($(size_desc "$size"))"
    elif [ -z "$size" ]; then
      size="$(default_size)"
    fi
    case "$size" in small|medium|large) ;; *) die "invalid --size '$size' (small|medium|large)" ;; esac
  fi

  require_daytona_cli
  need_cmd jq "brew install jq"
  dt_auth_check || die "not logged in to Daytona — run: devflow setup   (or: daytona login)"

  # --- resolve repo ---
  if [ "$blank" = 1 ]; then
    repo=""
  elif [ "$repo" = "__PICK__" ]; then
    pick_repo; repo="$REPO_PICKED"
  elif [ -n "$repo" ]; then
    local norm
    norm="$(repo_from_arg "$repo")"
    [ -n "$norm" ] || die "could not parse repo '$repo' — expected owner/name or a GitHub URL"
    repo="$norm"
  else
    repo="$(current_repo)"
    if [ -n "$repo" ]; then
      step "using current repo: ${C_BOLD}$repo${C_RESET}"
    elif [ -t 0 ]; then
      pick_repo; repo="$REPO_PICKED"
    fi
  fi

  # --- name ---
  if [ -z "$name" ]; then
    if [ -n "$repo" ]; then name="dv-$(sanitize_name "${repo##*/}")"
    else name="dv-scratch"; fi
  else
    name="$(sanitize_name "$name")"
  fi

  # --- existing sandbox? ---
  local st
  st="$(sandbox_state "$name")"
  if [ "$st" != "missing" ]; then
    if [ "$fresh" = 1 ]; then
      step "recreating '$name' (--fresh)…"
      dt delete "$name" >/dev/null 2>&1 || true
    else
      say "sandbox '$name' already exists ($st). (--fresh recreates, -n NAME makes another)"
      local needs_remote=0 reprovisioned=0
      if [ "$with_daytona" = 1 ] || [ -n "$script$task$aws_profile$secret_env_names$env_items" ]; then
        needs_remote=1
      elif [ "$attach" = 1 ] && [ -t 0 ]; then
        needs_remote=1
      fi
      [ "$needs_remote" = 1 ] && ensure_running "$name"
      if [ "$needs_remote" = 1 ] && ! sandbox_is_provisioned "$name"; then
        step "sandbox provisioning is incomplete or outdated — resuming all phases…"
        provision_sandbox "$name" "$agent" "$repo" "$branch" "$task" "$harness"
        ok "provisioned"
        [ -n "$task" ] && verify_agent_task_started "$name"
        reprovisioned=1
      fi
      if [ "$reprovisioned" = 0 ] && [ -n "$aws_profile$secret_env_names$env_items" ]; then
        refresh_forwarded_auth "$name" "$([ -n "$aws_profile" ] && printf 1 || printf 0)"
      fi
      if [ "$reprovisioned" = 0 ] && [ -n "$task" ]; then
        if [ "$agent_explicit" = 1 ]; then
          queue_agent_task "$name" "$task" "$agent"
        else
          queue_agent_task "$name" "$task"
        fi
      fi
      [ "$with_daytona" = 1 ] && { forward_daytona "$name" || warn "daytona forwarding failed"; }
      [ -n "$script" ] && { run_user_script "$name" "$script" || warn "script launch failed"; }
      if [ -n "$task" ]; then
        ok "agent working in $name"
        step "watch: ${C_BOLD}devflow peek $name${C_RESET} · state: ${C_BOLD}devflow status $name${C_RESET}"
      fi
      if [ "$attach" = 1 ] && [ -t 0 ]; then
        cmd_attach "$name"
        return $?
      fi
      ok "up. attach anytime, from any machine:  ${C_BOLD}devflow attach $name${C_RESET}"
      step "web terminal:   ${C_BOLD}$(sandbox_web_url "$name")${C_RESET}"
      return 0
    fi
  fi

  local size_note
  size_note="size=$size ($(size_desc "$size"))"
  [ -n "$snapshot" ] && size_note="snapshot=$snapshot"
  say "spinning up ${C_BOLD}$name${C_RESET}  ${C_DIM}agent=$agent harness=$harness repo=${repo:-none} $size_note auto-stop=${auto_stop}m${C_RESET}"
  auth_summary

  # --- create (never pass raw resources: the API rejects them with snapshots,
  # and even the default image is a snapshot — sizes live in the snapshot) ---
  local create_args
  create_args=(create "--name=$name" "--auto-stop=$auto_stop"
               --label devflow=1 --label "devflow.agent=$agent"
               --label "devflow.harness=$harness")
  [ -n "$repo" ] && create_args+=(--label "devflow.repo=$repo")
  [ -n "$team" ] && create_args+=(--label "devflow.team=$team")
  [ -n "$team_role" ] && create_args+=(--label "devflow.team.role=$team_role")
  [ -n "$team_mode" ] && create_args+=(--label "devflow.team.mode=$team_mode")
  if [ -n "$snapshot" ]; then
    create_args+=("--snapshot=$snapshot")
  else
    create_args+=("--snapshot=daytona-$size")
  fi
  [ -n "$DEVFLOW_TARGET" ] && create_args+=("--target=$DEVFLOW_TARGET")

  local create_output=""
  step "creating sandbox…"
  if [ -n "$linked_parent" ]; then
    create_linked_sandbox "$name" "$linked_parent" "$auto_stop" \
      "${snapshot:-daytona-$size}" "$agent" "$harness" "$repo" \
      "$team" "$team_role" "$team_mode"
  else
    if ! create_output="$(dt "${create_args[@]}" 2>&1)"; then
      [ -z "$create_output" ] || printf '%s\n' "$create_output" >&2
      die "sandbox create failed (check quota/billing at app.daytona.io)"
    fi
  fi
  wait_for_state "$name" started 300
  ok "sandbox running"
  step "web terminal:   ${C_BOLD}$(sandbox_web_url "$name")${C_RESET}"

  provision_sandbox "$name" "$agent" "$repo" "$branch" "$task" "$harness"
  ok "provisioned"
  [ -n "$task" ] && verify_agent_task_started "$name"

  [ "$with_daytona" = 1 ] && { forward_daytona "$name" \
    || warn "daytona forwarding failed — the sandbox can't manage sibling sandboxes"; }
  [ -n "$script" ] && { run_user_script "$name" "$script" \
    || warn "script launch failed — session is still up (retry: devflow up -n $name --script $script)"; }

  [ -n "$DEVFLOW_AUTO_HANDOFF" ] && { auto_handoff "$name" || true; }

  if [ -n "$task" ]; then
    ok "agent working in $name"
    step "watch: ${C_BOLD}devflow peek $name${C_RESET} · state: ${C_BOLD}devflow status $name${C_RESET}"
  fi

  if [ "$attach" = 1 ] && [ -t 0 ]; then
    cmd_attach "$name"
  else
    ok "up. attach anytime, from any machine:  ${C_BOLD}devflow attach $name${C_RESET}"
  fi
}

cmd_attach() {
  require_daytona_cli
  need_cmd jq "brew install jq"
  dt_auth_check || die "not logged in to Daytona — run: devflow setup"
  local name
  name="$(resolve_name "${1:-}")" || exit 1
  [ -n "$name" ] || exit 1
  ensure_running "$name"
  # if the sandbox restarted, this recreates the tmux session + resumes the agent
  dt_run "$name" '"$HOME/.devflow/bin/dv-ensure" 2>/dev/null || true' 60 >/dev/null 2>&1 || true
  say "attaching to ${C_BOLD}$name${C_RESET} ${C_DIM}(detach: Ctrl-b d — the session keeps running)${C_RESET}"
  exec daytona ssh "$name"
}

cmd_ssh() {
  require_daytona_cli
  need_cmd jq "brew install jq"
  local name
  name="$(resolve_name "${1:-}")" || exit 1
  ensure_running "$name"
  exec daytona ssh "$name"
}

sandbox_web_url() { # NAME [PORT] -> stable browser URL
  local name="$1" port="${2:-22222}" slug domain
  slug="${name#dv-}"
  slug="$(sanitize_name "$slug")"
  case "$port" in ''|*[!0-9]*) die "invalid preview port: $port" ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "invalid preview port: $port"
  [ "$port" = 22222 ] || slug="${slug}--${port}"
  domain="${DEVFLOW_DOMAIN#https://}"
  domain="${domain#http://}"
  domain="${domain%/}"
  [ -n "$domain" ] || die "DEVFLOW_DOMAIN is empty"
  printf 'https://%s.%s\n' "$slug" "$domain"
}

cmd_web() {
  local name="" port=22222 want_open=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --open) want_open=1; shift ;;
      --port) need_val "$1" "${2:-}"; port="$2"; shift 2 ;;
      --port=*) port="${1#--port=}"; shift ;;
      -h|--help) printf 'devflow web [NAME] [--port PORT] [--open] — print a stable terminal or app URL\n'; return 0 ;;
      -*) die "unknown web flag: $1" ;;
      *)  [ -z "$name" ] || die "unexpected web argument: $1"
          name="$1"; shift ;;
    esac
  done
  name="$(resolve_name "$name")" || exit 1
  local url
  url="$(sandbox_web_url "$name" "$port")"
  printf '%s\n' "$url"
  if [ "$want_open" = 1 ]; then
    open_file "$url" || warn "couldn't open a browser; use: $url"
  fi
}

# Mint a tokenized `ssh …@ssh.app.daytona.io` line via Daytona's ssh-access
# API. Prints ONLY the ssh line on stdout (so it's safe in $(…)); dies on
# stderr on any failure. Caller handles resolve_name + ensure_running.
# Shared by `ssh-command` and `mobile`.
resolve_daytona_api() { # sets DT_API_KEY / DT_API_URL / DT_ORG_ID; rc 1 if no credential
  # browser logins store an OAuth token (api.key is null) — the API accepts it
  # as a Bearer too; api-key logins store api.key. Env vars override the file.
  DT_API_KEY="${DAYTONA_API_KEY:-}"
  DT_API_URL="${DAYTONA_API_URL:-https://app.daytona.io/api}"
  DT_ORG_ID=""
  DT_OAUTH_TOKEN=""
  local cfg u
  for cfg in "$HOME/Library/Application Support/daytona/config.json" \
             "${XDG_CONFIG_HOME:-$HOME/.config}/daytona/config.json"; do
    [ -f "$cfg" ] || continue
    [ -z "$DT_API_KEY" ] && DT_API_KEY="$(jq -r '. as $c | ($c.activeProfile // "default") as $a
               | ($c.profiles // [])[] | select((.id // .name) == $a or .name == $a)
               | (.api.key // .api.token.accessToken // empty)' "$cfg" 2>/dev/null | head -1)"
    DT_OAUTH_TOKEN="$(jq -r '. as $c | ($c.activeProfile // "default") as $a
               | ($c.profiles // [])[] | select((.id // .name) == $a or .name == $a)
               | (.api.token.accessToken // empty)' "$cfg" 2>/dev/null | head -1)"
    u="$(jq -r '. as $c | ($c.activeProfile // "default") as $a
               | ($c.profiles // [])[] | select((.id // .name) == $a or .name == $a)
               | (.api.url // empty)' "$cfg" 2>/dev/null | head -1)"
    [ -n "$u" ] && DT_API_URL="$u"
    DT_ORG_ID="$(jq -r '. as $c | ($c.activeProfile // "default") as $a
               | ($c.profiles // [])[] | select((.id // .name) == $a or .name == $a)
               | (.activeOrganizationId // empty)' "$cfg" 2>/dev/null | head -1)"
    [ -n "$DT_API_KEY" ] && break
  done
  [ -n "$DT_API_KEY" ]
}

dt_key_valid() { # KEY — does the API accept it? (org is implied by the key)
  curl -fsS -o /dev/null -H "Authorization: Bearer $1" "$DT_API_URL/sandbox" 2>/dev/null
}

mint_ssh_command() { # NAME EXPIRES_MIN -> ssh line on stdout
  local name="$1" expires="$2"
  need_cmd jq "brew install jq"
  need_cmd curl "install curl"

  resolve_daytona_api \
    || die "no Daytona API key available — use 'devflow ssh $name' instead, or set DAYTONA_API_KEY"
  local api_key="$DT_API_KEY" api_url="$DT_API_URL"

  local sandbox_id resp
  sandbox_id="$(dt_info_json "$name" | jq -r '.id // .sandboxId // empty')"
  [ -n "$sandbox_id" ] || die "could not resolve sandbox id for '$name'"
  resp="$(curl -fsSL -X POST -H "Authorization: Bearer $api_key" \
          "$api_url/sandbox/$sandbox_id/ssh-access?expiresInMinutes=$expires" 2>/dev/null)" \
    || die "ssh-access API call failed — fall back to: devflow ssh $name  (a stale DAYTONA_API_KEY env var overrides your login — unset it if set)"
  local sshcmd token
  sshcmd="$(printf '%s' "$resp" | jq -r '.sshCommand // empty')"
  token="$(printf '%s' "$resp" | jq -r '.token // empty')"
  if [ -z "$sshcmd" ] && [ -n "$token" ]; then
    sshcmd="ssh $token@ssh.app.daytona.io"
  fi
  [ -n "$sshcmd" ] || die "unexpected ssh-access response — fall back to: devflow ssh $name"
  printf '%s\n' "$sshcmd"
}

cmd_ssh_command() { # print a plain `ssh` command usable from any machine
  local name="" expires=1440
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires) need_val "$1" "${2:-}"; expires="$2"; shift 2 ;;
      *) name="$1"; shift ;;
    esac
  done
  name="$(resolve_name "$name")" || exit 1
  ensure_running "$name"
  local sshcmd
  sshcmd="$(mint_ssh_command "$name" "$expires")" || exit 1
  say "valid for ${expires}m — run from any machine with plain ssh:"
  printf '%s\n' "$sshcmd"
}

# Print FILE minus the managed block delimited by BEGIN/END marker lines.
strip_managed_block() { # FILE BEGIN END
  [ -f "$1" ] || return 0
  awk -v b="$2" -v e="$3" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$1"
}

# Managed ~/.ssh/config Host block: after this, plain `ssh dv-NAME` works —
# and so does anything built on ssh config: VS Code / Cursor Remote-SSH,
# scp, rsync. Idempotent (re-run replaces the block, e.g. after token
# expiry); --remove deletes it and touches nothing else in the file.
cmd_ssh_config() {
  local name="" expires=1440 cfgfile="$HOME/.ssh/config" remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires) need_val "$1" "${2:-}"; expires="$2"; shift 2 ;;
      --file)    need_val "$1" "${2:-}"; cfgfile="$2"; shift 2 ;;
      --remove)  remove=1; shift ;;
      -h|--help) printf 'devflow ssh-config [NAME] [--expires MIN] [--file PATH] [--remove] — managed Host block: plain `ssh NAME` + editor Remote-SSH\n'; return 0 ;;
      *)         name="$1"; shift ;;
    esac
  done

  if [ "$remove" = 1 ]; then
    # no resolve/mint — must work even after the sandbox is gone
    [ -n "$name" ] || die "usage: devflow ssh-config NAME --remove"
    local tmp_rm
    tmp_rm="$(mktemp "${TMPDIR:-/tmp}/devflow.XXXXXX")"
    strip_managed_block "$cfgfile" "# >>> devflow $name >>>" "# <<< devflow $name <<<" > "$tmp_rm"
    mv "$tmp_rm" "$cfgfile"
    chmod 600 "$cfgfile" 2>/dev/null || true
    ok "removed Host $name from $cfgfile"
    return 0
  fi

  name="$(resolve_name "$name")" || exit 1
  ensure_running "$name"
  local sshcmd uri target user host port=22
  sshcmd="$(mint_ssh_command "$name" "$expires")" || exit 1
  uri="$(ssh_uri_from_command "$sshcmd")"
  [ -n "$uri" ] || die "couldn't parse user@host from: $sshcmd"
  target="${uri#ssh://}"
  user="${target%%@*}"
  host="${target#*@}"
  case "$host" in *:*) port="${host##*:}"; host="${host%%:*}" ;; esac

  local begin="# >>> devflow $name >>>" end="# <<< devflow $name <<<" tmp
  mkdir -p "$(dirname "$cfgfile")"
  chmod 700 "$(dirname "$cfgfile")" 2>/dev/null || true
  tmp="$(mktemp "${TMPDIR:-/tmp}/devflow.XXXXXX")"
  strip_managed_block "$cfgfile" "$begin" "$end" > "$tmp"
  {
    printf '%s\n' "$begin"
    printf 'Host %s\n' "$name"
    printf '  HostName %s\n' "$host"
    printf '  Port %s\n' "$port"
    printf '  User %s\n' "$user"
    printf '  StrictHostKeyChecking accept-new\n'
    printf '%s\n' "$end"
  } >> "$tmp"
  mv "$tmp" "$cfgfile"
  chmod 600 "$cfgfile"

  ok "ssh config written: ${C_BOLD}Host $name${C_RESET} → $cfgfile ${C_DIM}(token valid ${expires}m)${C_RESET}"
  step "terminal:        ${C_BOLD}ssh $name${C_RESET}   (lands in the live tmux agent)"
  step "VS Code/Cursor:  Remote-SSH: Connect to Host… → $name ${C_DIM}(or: code --remote ssh-remote+$name /home/daytona/$DEVFLOW_WORKROOT)${C_RESET}"
  step "after expiry, refresh with:  ${C_BOLD}devflow ssh-config $name --expires 10080${C_RESET}"
}

# --- phone hand-off helpers (devflow mobile) --------------------------------

# ssh://user@host[:port] URI from an `ssh …` command line. Mobile SSH apps
# (Termius, Blink, ConnectBot, …) register the ssh:// scheme, so a QR of the
# URI opens the session in one camera-tap. Prints nothing if the command has
# no user@host target.
ssh_uri_from_command() { # SSHCMD
  local w target="" port="" prev=""
  # shellcheck disable=SC2086  # word-splitting the command line is the point
  for w in $1; do
    case "$w" in *@*) target="$w" ;; esac
    [ "$prev" = "-p" ] && port="$w"
    prev="$w"
  done
  [ -n "$target" ] || return 0
  printf 'ssh://%s%s' "$target" "${port:+:$port}"
}

# Render PAYLOAD as a terminal QR via qrencode — generated locally, so the
# token never touches a third-party service. Quiet rc-1 when qrencode is
# missing or fails; the caller prints its own fallback hint.
emit_qr() { # PAYLOAD -> indented QR on stdout
  have_cmd qrencode || return 1
  local qrtype=UTF8 out
  [ -n "$C_BOLD" ] && qrtype=ANSIUTF8   # paints true black/white, any theme
  out="$(qrencode -t "$qrtype" "$1" 2>/dev/null)" || return 1
  [ -n "$out" ] || return 1
  printf '%s\n' "$out" | sed 's/^/  /'
}

copy_to_clipboard() { # TEXT -> rc 0 if a clipboard tool took it
  if have_cmd pbcopy;  then printf '%s' "$1" | pbcopy 2>/dev/null && return 0; fi
  if have_cmd wl-copy; then printf '%s' "$1" | wl-copy 2>/dev/null && return 0; fi
  if have_cmd xclip;   then printf '%s' "$1" | xclip -selection clipboard 2>/dev/null && return 0; fi
  return 1
}

open_file() { # FILE -> open in the OS default app (best-effort)
  if have_cmd open; then open "$1" 2>/dev/null
  elif have_cmd xdg-open; then xdg-open "$1" 2>/dev/null
  else return 1; fi
}

# Self-contained HTML "reconnect pass" for when the phone isn't at hand at
# mint time: print it, AirDrop it later, or park it in a synced folder and
# open it from the phone's Files app. 0600 — it embeds a live token.
write_mobile_pass() { # FILE NAME SSHCMD URI EXPIRES_MIN
  local file="$1" name="$2" sshcmd="$3" uri="$4" expires="$5"
  local svg="" qrblock minted
  if [ -n "$uri" ] && have_cmd qrencode; then
    svg="$(qrencode -t SVG -s 8 -o - "$uri" 2>/dev/null)" || svg=""
  fi
  if [ -n "$svg" ]; then
    qrblock="<div class=\"qr\">$svg</div>"
  else
    qrblock="<p class=\"dim\"><em>(no QR — qrencode wasn't available when this pass was minted)</em></p>"
  fi
  minted="$(date)"
  ( umask 177
    cat > "$file" <<DV_MOBILE_PASS
<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>devflow reconnect pass — $name</title>
<style>
  body{font-family:-apple-system,system-ui,sans-serif;max-width:34em;margin:3em auto;padding:0 1em;color:#111;background:#fff}
  h1{font-size:1.3em}
  code{font-family:ui-monospace,Menlo,monospace;background:#f4f4f4;padding:.5em .7em;border-radius:6px;display:block;word-break:break-all;font-size:1.05em}
  .qr{margin:1.2em 0}
  .dim{color:#666;font-size:.9em}
  .warn{color:#8a4b00;background:#fff4e0;padding:.6em .8em;border-radius:6px;font-size:.9em}
</style>
<h1>devflow reconnect pass — $name</h1>
<p class="dim">minted $minted · token valid $expires minutes · any SSH login lands in the
live tmux agent (detach: Ctrl-b d)</p>
$qrblock
<p>scan with a phone camera (opens in Termius / Blink / ConnectBot), or run:</p>
<code>$sshcmd</code>
<p class="dim">no SSH app? browser terminal: <a href="https://app.daytona.io">app.daytona.io</a> → $name → Terminal</p>
<p class="warn">this file contains a live SSH token — treat it like a password; it expires
on its own, but delete it after use anyway.</p>
DV_MOBILE_PASS
  ) || die "could not write $file"
  chmod 600 "$file" 2>/dev/null || true
}

# One-time pairing for the push channel: mint a private high-entropy ntfy
# topic (the topic IS the password — ntfy's documented model), store it in
# the 0600 secrets file, and walk the phone through subscribing. Works for
# every laptop/phone combo: curl on macOS/Linux, ntfy app on Android/iOS.
setup_push_channel() {
  need_cmd curl "install curl"
  local topic="${DEVFLOW_NTFY_TOPIC:-}"
  if [ -z "$topic" ]; then
    topic="devflow-$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
    config_set "$SECRETS_FILE" DEVFLOW_NTFY_TOPIC "$topic"
    DEVFLOW_NTFY_TOPIC="$topic"
  fi
  say "push channel — one-time phone setup (works Android + iPhone, from macOS + Linux)"
  printf '\n'
  step "1) install the ${C_BOLD}ntfy${C_RESET} app — Android: Play/F-Droid · iPhone: App Store (free, open source)"
  step "2) in the app: Subscribe to topic — scan this or type it:"
  emit_qr "$DEVFLOW_NTFY_URL/$topic" || true
  printf '     %s%s/%s%s\n' "$C_BOLD" "$DEVFLOW_NTFY_URL" "$topic" "$C_RESET"
  printf '     %sthe topic name is the password — anyone who has it can read your pushes (kept 0600 in devflow secrets)%s\n' "$C_DIM" "$C_RESET"
  step "3) repeat on any other phone/tablet — same topic, they all get the pushes"
  printf '\n'
  if curl -fsS -X POST -H "X-Title: devflow" \
       -d "push channel works — 'devflow mobile --send push' lands here from any of your machines" \
       "$DEVFLOW_NTFY_URL/$topic" >/dev/null 2>&1; then
    ok "test notification sent — it should be on your phone now"
  else
    warn "test push failed — check network, then: devflow mobile --send push"
  fi
  step "self-hosting? point it at your server:  devflow config set DEVFLOW_NTFY_URL https://ntfy.example.com"
}

handoff_body() { # NAME SSHCMD URI EXPIRES_MIN -> message body on stdout
  printf 'devflow reconnect — %s\n%s\n' "$1" "$2"
  [ -n "$3" ] && printf 'one-tap: %s\n' "$3"
  printf 'minted %s · valid %sm · lands in the live tmux agent (detach: Ctrl-b d)\nno SSH app? %s' \
    "$(date)" "$4" "$(sandbox_web_url "$1")"
}

# Send the reconnect info through a channel that already syncs to the phone —
# no phone-in-hand needed at mint time; it's waiting there when you pick it
# up. Channels: ntfy push (any laptop → any phone, tap opens the SSH app),
# 1Password CLI (op), Bitwarden CLI (bw, needs BW_SESSION), Apple Notes via
# iCloud (osascript). auto = first available in that order. Prints the
# channel label on success; dies with a fix-it hint on an explicit target,
# falls through silently in auto mode.
send_handoff() { # TARGET(auto|push|op|bw|note) TITLE BODY URI -> channel label on stdout
  local target="$1" title="$2" body="$3" uri="$4"
  if [ "$target" = push ] || { [ "$target" = auto ] && [ -n "${DEVFLOW_NTFY_TOPIC:-}" ]; }; then
    if [ "$target" = push ] && [ -z "${DEVFLOW_NTFY_TOPIC:-}" ]; then
      die "push channel not set up — run: devflow mobile --setup-push"
    fi
    need_cmd curl "install curl"
    # X-Click: tapping the notification opens the SSH app via the ssh:// URI
    if curl -fsS -X POST -H "X-Title: $title" -H "X-Click: ${uri:-https://app.daytona.io}" \
         -d "$body" "$DEVFLOW_NTFY_URL/$DEVFLOW_NTFY_TOPIC" >/dev/null 2>&1; then
      printf 'push (ntfy)'; return 0
    fi
    [ "$target" = push ] && die "push failed — check network / DEVFLOW_NTFY_URL ($DEVFLOW_NTFY_URL)"
  fi
  if [ "$target" = op ] || { [ "$target" = auto ] && have_cmd op; }; then
    [ "$target" = op ] && need_cmd op "brew install 1password-cli"
    local operr=""
    if operr="$(op item create --category "Secure Note" --title "$title" "notesPlain=$body" 2>&1 >/dev/null)"; then
      printf '1Password'; return 0
    fi
    [ "$target" = op ] && die "op item create failed: ${operr:-unknown error} — try 'op signin' (or enable the 1Password app's CLI integration)"
  fi
  if [ "$target" = bw ] || { [ "$target" = auto ] && have_cmd bw && [ -n "${BW_SESSION:-}" ]; }; then
    [ "$target" = bw ] && need_cmd bw "brew install bitwarden-cli"
    local enc=""
    if enc="$(bw --nointeraction get template item 2>/dev/null \
          | jq --arg t "$title" --arg n "$body" '.type=2 | .secureNote={type:0} | .name=$t | .notes=$n' 2>/dev/null \
          | bw --nointeraction encode 2>/dev/null)" \
        && [ -n "$enc" ] && bw --nointeraction create item "$enc" >/dev/null 2>&1; then
      printf 'Bitwarden'; return 0
    fi
    [ "$target" = bw ] && die "bw create failed — unlock first: export BW_SESSION=\"\$(bw unlock --raw)\""
  fi
  if [ "$target" = note ] || { [ "$target" = auto ] && [ "$(uname 2>/dev/null)" = Darwin ] && have_cmd osascript; }; then
    [ "$target" = note ] && need_cmd osascript "Apple Notes hand-off is macOS-only"
    local body_html
    body_html="$(printf '%s\n' "$body" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' | awk '{printf "%s<br>", $0}')"
    if osascript - "$title" "$body_html" >/dev/null 2>&1 <<'DV_NOTE_AS'
on run argv
  tell application "Notes" to make new note with properties {name:(item 1 of argv), body:(item 2 of argv)}
end run
DV_NOTE_AS
    then printf 'Apple Notes (iCloud)'; return 0; fi
    [ "$target" = note ] && die "couldn't create the note — allow Terminal to control Notes (System Settings → Privacy & Security → Automation)"
  fi
  die "no hand-off channel available — install the 1Password CLI (op) or Bitwarden CLI (bw + BW_SESSION), or use Apple Notes on macOS. Zero-prep fallbacks: app.daytona.io from any browser, or 'devflow mobile --out FILE'"
}

# DEVFLOW_AUTO_HANDOFF: fire-and-forget hand-off at the end of every `up` —
# the reconnect line lands on the phone without being asked, so forgetting to
# run `devflow mobile` before leaving costs nothing. Best-effort by design:
# a failed mint/send warns and never blocks the session.
auto_handoff() { # NAME
  local name="$1" sshcmd="" uri="" body="" chan=""
  sshcmd="$(mint_ssh_command "$name" 1440 2>/dev/null)" \
    || { warn "auto-handoff: couldn't mint an ssh token — run 'devflow mobile' manually"; return 1; }
  uri="$(ssh_uri_from_command "$sshcmd")"
  body="$(handoff_body "$name" "$sshcmd" "$uri" 1440)"
  chan="$(send_handoff "$DEVFLOW_AUTO_HANDOFF" "devflow · $name" "$body" "$uri" 2>/dev/null)" \
    || { warn "auto-handoff: send failed (channel: $DEVFLOW_AUTO_HANDOFF) — run 'devflow mobile --send'"; return 1; }
  ok "auto-handoff: reconnect line sent via $chan"
}

cmd_mobile() { # hand the session to your phone: camera-scannable QR + ssh line + fallbacks
  local name="" expires=1440 want_qr=1 want_copy=1 want_open=0 outfile="" send_target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --expires)   need_val "$1" "${2:-}"; expires="$2"; shift 2 ;;
      --out)       need_val "$1" "${2:-}"; outfile="$2"; shift 2 ;;
      --open)      want_open=1; shift ;;
      --send)      send_target=auto
                   case "${2:-}" in push|op|bw|note) send_target="$2"; shift ;; esac
                   shift ;;
      --setup-push) setup_push_channel; return $? ;;
      --no-qr)     want_qr=0; shift ;;
      --no-copy)   want_copy=0; shift ;;
      -h|--help)   printf 'devflow mobile [NAME] [--expires MIN] [--send [push|op|bw|note]] [--setup-push] [--out FILE [--open]] [--no-qr] [--no-copy] — hand the session to your phone\n'; return 0 ;;
      *)           name="$1"; shift ;;
    esac
  done
  [ "$want_open" = 1 ] && [ -z "$outfile" ] && die "--open requires --out FILE"
  name="$(resolve_name "$name")" || exit 1
  ensure_running "$name"
  local sshcmd
  sshcmd="$(mint_ssh_command "$name" "$expires")" || exit 1

  local uri="" copied=0
  uri="$(ssh_uri_from_command "$sshcmd")"
  [ -n "$outfile" ] && write_mobile_pass "$outfile" "$name" "$sshcmd" "$uri" "$expires"
  local sent_via=""
  if [ -n "$send_target" ]; then
    local body
    body="$(handoff_body "$name" "$sshcmd" "$uri" "$expires")"
    sent_via="$(send_handoff "$send_target" "devflow · $name" "$body" "$uri")" || exit 1
  fi
  [ "$want_copy" = 1 ] && copy_to_clipboard "$sshcmd" && copied=1

  say "reconnect to ${C_BOLD}$name${C_RESET} from your phone or any other machine"
  printf '\n'
  if [ "$want_qr" = 1 ]; then
    local qr=""
    [ -n "$uri" ] && qr="$(emit_qr "$uri")" || true
    if [ -n "$qr" ]; then
      step "point your phone's camera at the QR — one tap opens the live session"
      printf '     %sworks with any ssh:// app: Termius · Blink · ConnectBot (Termux: use the line below)%s\n' "$C_DIM" "$C_RESET"
      printf '\n%s\n\n' "$qr"
    else
      warn "no QR — install qrencode (brew install qrencode / apt install qrencode); the paths below still work"
    fi
  fi
  step "1) Any SSH app — Android: Termux · iOS: Blink/Termius · Mac/Linux: built-in ssh"
  printf '     %s%s%s\n' "$C_BOLD" "$sshcmd" "$C_RESET"
  [ "$copied" = 1 ] && printf '     %s→ already on your clipboard (Universal Clipboard pastes it on a nearby iPhone/iPad)%s\n' \
         "$C_DIM" "$C_RESET"
  printf '     %svalid %sm (pass --expires MIN for longer) · lands straight in the live agent · detach: Ctrl-b d%s\n' \
         "$C_DIM" "$expires" "$C_RESET"
  printf '\n'
  step "2) Full devflow — Android (Termux / UserLAnd Ubuntu) or another Mac/Linux"
  printf '     %scurl -fsSL https://devflow.sh/install | sh%s\n' "$C_DIM" "$C_RESET"
  printf '     %sdaytona login && devflow attach %s%s   (also restarts it if stopped)\n' "$C_DIM" "$name" "$C_RESET"
  printf '\n'
  step "3) Just a browser — $(sandbox_web_url "$name")"
  printf '\n'
  if [ -n "$sent_via" ]; then
    ok "sent via ${C_BOLD}$sent_via${C_RESET} — it's already waiting on your phone"
  fi
  if [ -n "$outfile" ]; then
    ok "reconnect pass saved: ${C_BOLD}$outfile${C_RESET} — AirDrop it later, park it in a synced folder, or print it"
    printf '     %scontains the live token (chmod 600) — treat it like a password%s\n' "$C_DIM" "$C_RESET"
    if [ "$want_open" = 1 ]; then
      open_file "$outfile" || warn "couldn't auto-open $outfile"
    fi
  fi
  if [ -z "$sent_via" ] && [ -z "$outfile" ]; then
    step "phone not on you right now?  ${C_BOLD}devflow mobile --send${C_RESET} → push notification / password manager / Apple Notes ${C_DIM}(one-time: --setup-push)${C_RESET}"
  fi
  step "peek without attaching:  ${C_BOLD}devflow peek $name${C_RESET}"
}

cmd_exec() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: devflow exec NAME -- CMD…"
  shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: devflow exec NAME -- CMD…"
  ensure_running "$name"
  dt_run "$name" "$*" 0
}

cmd_peek() {
  local name="" lines=40 window=agent raw=0 prefer_final=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--lines) need_val "$1" "${2:-}"; lines="$2"; shift 2 ;;
      --lines=*) lines="${1#--lines=}"; shift ;;
      -w|--window) need_val "$1" "${2:-}"; window="$2"; shift 2 ;;
      --window=*) window="${1#--window=}"; shift ;;
      --raw) raw=1; prefer_final=0; shift ;;
      -h|--help)
        printf 'usage: devflow peek [NAME] [-n|--lines N] [-w|--window W] [--raw]\n'
        return 0 ;;
      -*) die "unknown flag for peek: $1" ;;
      *) [ -z "$name" ] || die "peek accepts at most one sandbox name"; name="$1"; shift ;;
    esac
  done
  case "$lines" in ''|*[!0-9]*) die "peek --lines/-n must be a number from 1 to 1000" ;; esac
  [ "$lines" -ge 1 ] && [ "$lines" -le 1000 ] \
    || die "peek --lines/-n must be a number from 1 to 1000"
  case "$window" in
    ''|*[!a-zA-Z0-9_.-]*) die "peek window may contain only letters, numbers, dot, underscore, and hyphen" ;;
  esac
  name="$(resolve_name "$name")" || exit 1
  local st payload remote history meta source agent content cleaned
  st="$(sandbox_state "$name")"
  if [ "$st" != "started" ]; then
    say "'$name' is ${st} — nothing running to peek at. ${C_DIM}devflow attach $name restarts it.${C_RESET}"
    return 0
  fi
  history=$((lines * 4))
  [ "$history" -le 4000 ] || history=4000
  remote="window=$window; prefer_final=$prefer_final; history=$history; "
  remote="${remote}"'run="$HOME/.devflow/run"; state="$(sed -n "s/^state=//p" "$run/status" 2>/dev/null | head -1)"; agent="$(sed -n "s/^agent=//p" "$run/status" 2>/dev/null | head -1)"; [ -n "$state" ] || state=not-started; [ -n "$agent" ] || agent=unknown; source=pane; if [ "$prefer_final" = 1 ] && [ "$window" = agent ] && [ "$agent" = codex ] && [ -s "$run/last-message.txt" ]; then case "$state" in completed|failed) source=final ;; esac; fi; if [ "$source" = pane ] && ! tmux list-windows -t dv -F "#{window_name}" 2>/dev/null | grep -Fxq "$window"; then source=missing; fi; printf "__DEVFLOW_PEEK_META__ state=%s agent=%s source=%s window=%s\n" "$state" "$agent" "$source" "$window"; printf "__DEVFLOW_PEEK_BEGIN__\n"; case "$source" in final) tail -n "$history" "$run/last-message.txt" ;; pane) tmux capture-pane -p -J -t "dv:$window" -S "-$history" 2>/dev/null ;; missing) printf "window %s is not running\n" "$window" ;; esac; printf "\n__DEVFLOW_PEEK_END__\n"'
  if ! payload="$(dt_run "$name" "$remote" 60 2>&1)"; then
    [ -z "$payload" ] || printf '%s\n' "$payload" >&2
    die "could not read '$window' from '$name'"
  fi
  meta="$(printf '%s\n' "$payload" | sed -n '/^__DEVFLOW_PEEK_META__ /{p;q;}')"
  if [ -z "$meta" ]; then
    [ -z "$payload" ] || printf '%s\n' "$payload" >&2
    die "could not read '$window' from '$name'"
  fi
  st="$(peek_meta_field "$meta" state)"
  agent="$(peek_meta_field "$meta" agent)"
  source="$(peek_meta_field "$meta" source)"
  content="$(printf '%s\n' "$payload" | awk '$0 == "__DEVFLOW_PEEK_BEGIN__" { inside=1; next } $0 == "__DEVFLOW_PEEK_END__" { exit } inside { print }')"

  if [ "$raw" = 1 ]; then
    printf '%s\n' "$content" | trim_peek_padding | tail -n "$lines"
    return 0
  fi

  printf '%s%s%s  %s%s · %s · %s%s\n' \
    "$C_BOLD" "$name" "$C_RESET" "$C_DIM" "$window" "$agent" "$(ui_state_value "$st")" "$C_RESET"
  [ "$source" != final ] || printf '%sfinal response%s\n' "$C_DIM" "$C_RESET"
  printf '\n'
  cleaned="$(printf '%s\n' "$content" | clean_peek_output | tail -n "$lines")"
  if [ -n "$cleaned" ]; then printf '%s\n' "$cleaned"
  else printf '%s(no output yet)%s\n' "$C_DIM" "$C_RESET"; fi
}

cmd_status() {
  local name="" raw=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --raw) raw=1; shift ;;
      -h|--help) echo "usage: devflow status [NAME] [--raw]"; return 0 ;;
      -*) die "unknown flag for status: $1" ;;
      *) [ -z "$name" ] || die "status accepts at most one sandbox name"; name="$1"; shift ;;
    esac
  done
  name="$(resolve_name "$name")" || exit 1
  local st details agent_state agent alive tmux_state started completed exit_code
  st="$(sandbox_state "$name")"
  if [ "$raw" = 1 ]; then printf 'sandbox_state=%s\n' "$st"
  else ui_title "$name"; ui_row "sandbox" "$(ui_state_value "$st")"; fi
  [ "$st" = "started" ] || return 0
  if ! details="$(dt_run "$name" 'run="$HOME/.devflow/run"; field() { sed -n "s/^$1=//p" "$run/status" 2>/dev/null | head -1; }; state="$(field state)"; agent="$(field agent)"; pid="$(field pid)"; started="$(field started_at)"; completed="$(field completed_at)"; exit_code="$(field exit_code)"; prompt_sha="$(field prompt_sha256)"; alive=no; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && alive=yes; [ "$state" = running ] && [ "$alive" = no ] && state=stale; [ -n "$state" ] || state=not-started; tmux_state=absent; tmux has-session -t dv 2>/dev/null && tmux_state=running; printf "agent_state=%s\nagent=%s\nprocess_alive=%s\ntmux_session=%s\nstarted_at=%s\ncompleted_at=%s\nexit_code=%s\nprompt_sha256=%s\n" "$state" "${agent:-unknown}" "$alive" "$tmux_state" "${started:-}" "${completed:-}" "${exit_code:-}" "${prompt_sha:-}"' 60 2>&1)"; then
    [ -z "$details" ] || printf '%s\n' "$details" >&2
    die "could not read status from '$name'"
  fi
  if [ "$raw" = 1 ]; then
    printf '%s\n' "$details" | awk -F= '
      $1 == "agent_state" || $1 == "agent" || $1 == "process_alive" ||
      $1 == "tmux_session" || $1 == "started_at" ||
      $1 == "completed_at" || $1 == "exit_code" ||
      $1 == "prompt_sha256" { print }
    '
    return 0
  fi
  agent_state="$(kv_field "$details" agent_state)"
  agent="$(kv_field "$details" agent)"
  alive="$(kv_field "$details" process_alive)"
  tmux_state="$(kv_field "$details" tmux_session)"
  started="$(kv_field "$details" started_at)"
  completed="$(kv_field "$details" completed_at)"
  exit_code="$(kv_field "$details" exit_code)"
  ui_row "task" "$(ui_state_value "${agent_state:-unknown}")${C_DIM} · ${agent:-unknown}${C_RESET}"
  ui_row "process" "$([ "$alive" = yes ] && printf alive || printf stopped)"
  ui_row "session" "tmux ${tmux_state:-absent}"
  [ -z "$started" ] || ui_row "started" "$started"
  [ -z "$completed" ] || ui_row "finished" "$completed"
  [ -z "$exit_code" ] || ui_row "exit" "$exit_code"
}

cmd_ls() {
  require_daytona_cli
  need_cmd jq "brew install jq"
  dt_auth_check || die "not logged in to Daytona — run: devflow setup"
  local json count
  json="$(devflow_sandboxes_json)"
  count="$(printf '%s' "$json" | jq 'length')"
  if [ "$count" = "0" ]; then
    say "no devflow sandboxes yet. start one:  ${C_BOLD}devflow up${C_RESET}"
    return 0
  fi
  printf '%s\n' "${C_BOLD}NAME                     STATE      AGENT   REPO                              CPU/MEM${C_RESET}"
  printf '%s' "$json" | jq -r '.[] | [
      (.name // .id // "?"),
      (.state // .status // "?"),
      ((.labels // {})["devflow.agent"] // "-"),
      ((.labels // {})["devflow.repo"] // "-"),
      (((.cpu // "?") | tostring) + "c/" + ((.memory // "?") | tostring) + "g")
    ] | @tsv' \
  | while IFS=$'\t' read -r n s a r c; do
      local color="$C_DIM"
      [ "$s" = "started" ] && color="$C_GREEN"
      printf '%-24s %s%-10s%s %-7s %-33s %s\n' "$n" "$color" "$s" "$C_RESET" "$a" "$r" "$c"
    done
}

cmd_stop() {
  need_cmd jq "brew install jq"
  if [ "${1:-}" = "--all" ]; then
    local n
    devflow_sandboxes_json | jq -r '.[] | (.name // .id // empty)' | while read -r n; do
      [ -n "$n" ] || continue
      step "stopping $n…"
      dt stop "$n" </dev/null >/dev/null 2>&1 || true
    done
    ok "all devflow sandboxes stopped"
    return 0
  fi
  local name
  name="$(resolve_name "${1:-}")" || exit 1
  dt_quiet stop "$name" || die "could not stop '$name'"
  ok "stopped '$name' — disk preserved; 'devflow attach $name' restarts and resumes the agent"
}

cmd_rm() {
  need_cmd jq "brew install jq"
  local force=0 all=0 name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      --all) all=1; shift ;;
      *) name="$1"; shift ;;
    esac
  done
  if [ "$all" = 1 ]; then
    if [ "$force" != 1 ]; then confirm "delete ALL devflow sandboxes (unpushed work in them is lost)?" || exit 1; fi
    local n
    devflow_sandboxes_json | jq -r '.[] | (.name // .id // empty)' | while read -r n; do
      [ -n "$n" ] || continue
      step "deleting $n…"
      dt delete "$n" </dev/null >/dev/null 2>&1 || true
    done
    ok "all devflow sandboxes deleted"
    return 0
  fi
  name="$(resolve_name "$name")" || exit 1
  if [ "$force" != 1 ]; then confirm "delete sandbox '$name'? unpushed work in it is lost" || exit 1; fi
  dt_quiet delete "$name" || die "could not delete '$name'"
  ok "deleted '$name'"
}

cmd_sync() {
  need_cmd jq "brew install jq"
  local name="" aws_profile="" secret_env_names="" env_items="" allow_static_aws=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --aws-profile) need_val "$1" "${2:-}"; aws_profile="$2"; shift 2 ;;
      --secret-env) need_val "$1" "${2:-}"; secret_env_names="${secret_env_names}${secret_env_names:+ }$2"; shift 2 ;;
      --env) need_val "$1" "${2:-}"; env_items="${env_items}${env_items:+ }$(printf '%s' "$2" | b64_encode)"; shift 2 ;;
      --allow-static-aws) allow_static_aws=1; shift ;;
      -h|--help)
        echo "usage: devflow sync [NAME] [--aws-profile PROFILE] [--secret-env VARIABLE] [--env NAME=VALUE] [--allow-static-aws]"
        return 0 ;;
      -*) die "unknown flag for sync: $1" ;;
      *) [ -z "$name" ] || die "sync accepts at most one sandbox name"; name="$1"; shift ;;
    esac
  done
  set_forwarding_options "$aws_profile" "$secret_env_names" "$allow_static_aws" "$env_items"
  [ -n "$aws_profile$secret_env_names$env_items" ] && harvest_all
  name="$(resolve_name "$name")" || exit 1
  refresh_forwarded_auth "$name" "$([ -n "$aws_profile" ] && printf 1 || printf 0)"
}

# ----------------------------------------------------------------------------
# Multi-agent teams: one sandbox harness or linked Daytona sandboxes
# ----------------------------------------------------------------------------
normalize_team_name() {
  local team="${1#dv-}" clean
  clean="$(sanitize_name "$team")"
  printf '%s' "$clean" | cut -c1-20
}

normalize_team_role() {
  local clean
  clean="$(sanitize_name "$1")"
  printf '%s' "$clean" | cut -c1-16
}

team_sandboxes_json() { # TEAM (empty = all team sandboxes)
  local team="${1:-}"
  devflow_sandboxes_json | jq --arg team "$team" '
    [ .[] | select((((.labels // {})["devflow.team"] // "") != "")
      and ($team == "" or ((.labels // {})["devflow.team"] == $team))) ]'
}

team_role_sandbox() { # TEAM ROLE -> sandbox name
  local team="$1" role="$2" json names count
  json="$(team_sandboxes_json "$team")"
  names="$(printf '%s' "$json" | jq -r --arg role "$role" '
    .[] | select(((.labels // {})["devflow.team.role"] // "") == $role)
    | (.name // .id // empty)')"
  count="$(printf '%s\n' "$names" | grep -c . 2>/dev/null || true)"
  [ "$count" = 1 ] || die "team '$team' has no unique role '$role' (check: devflow team status $team)"
  printf '%s\n' "$names"
}

team_add_worker() { # CURRENT_SPECS ROLE=TASK -> updated base64 specs
  local specs="$1" spec="$2" role task encoded
  case "$spec" in *=*) role="${spec%%=*}"; task="${spec#*=}" ;; *)
    die "--worker expects ROLE=TASK" ;;
  esac
  [ -n "$role" ] && [ -n "$task" ] || die "--worker expects non-empty ROLE=TASK"
  role="$(normalize_team_role "$role")"
  [ "$role" != "leader" ] || die "worker role 'leader' is reserved"
  if [ -n "$specs" ]; then
    local existing decoded existing_role
    for existing in $specs; do
      decoded="$(printf '%s' "$existing" | b64_decode)"
      existing_role="${decoded%%	*}"
      [ "$existing_role" != "$role" ] || die "duplicate worker role '$role'"
    done
  fi
  encoded="$(printf '%s\t%s' "$role" "$task" | b64_encode)"
  printf '%s%s%s' "$specs" "${specs:+ }" "$encoded"
}

usage_team() {
cat <<EOF
devflow team up [REPO] [flags]
  --mode one|linked       one sandbox harness (default) or one linked sandbox per agent
  -m, --task TEXT         team goal / leader task
  -w, --worker ROLE=TASK  named worker and task (repeatable)
      --agents N          total agents; creates worker-1..N-1 from the team goal
  -n, --name NAME         team name (default: repo name)
  -a, --agent A           claude | codex | both
  -H, --harness H         auto | omc | omx | both | core
  -s, --size S            small | medium | large
  -b, --branch B          base branch
      --snapshot S        custom snapshot
      --auto-stop MIN     0 = disabled
      --blank             no repository
      --fresh             recreate existing team sandboxes
      --attach            attach to the leader when ready

Manage:
  devflow team ls
  devflow team status TEAM
  devflow team ui TEAM [--once|--plain]
  devflow team task TEAM ROLE "new task"
  devflow team send TEAM ROLE "message"
  devflow team inbox TEAM [ROLE]
  devflow team handoff TEAM FROM TO ["next task"] [--brief FILE] [--agent A]
  devflow team connect TEAM       add/repair inboxes on an existing linked team
  devflow team peek TEAM [ROLE]
  devflow team attach TEAM [ROLE]
  devflow team rm TEAM [-f]
EOF
}

cmd_team_up() {
  local repo="" team="" mode="one" task="" worker_specs="" agents=""
  local agent="$DEVFLOW_AGENT" harness="$DEVFLOW_HARNESS" size="" branch=""
  local snapshot="" auto_stop="$DEVFLOW_AUTO_STOP" blank=0 fresh=0 attach=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) need_val "$1" "${2:-}"; mode="$2"; shift 2 ;;
      -m|--task) need_val "$1" "${2:-}"; task="$2"; shift 2 ;;
      -w|--worker) need_val "$1" "${2:-}"; worker_specs="$(team_add_worker "$worker_specs" "$2")" || exit 1; shift 2 ;;
      --agents) need_val "$1" "${2:-}"; agents="$2"; shift 2 ;;
      -n|--name) need_val "$1" "${2:-}"; team="$2"; shift 2 ;;
      -a|--agent) need_val "$1" "${2:-}"; agent="$2"; shift 2 ;;
      -H|--harness) need_val "$1" "${2:-}"; harness="$2"; shift 2 ;;
      -s|--size) need_val "$1" "${2:-}"; size="$2"; shift 2 ;;
      -b|--branch) need_val "$1" "${2:-}"; branch="$2"; shift 2 ;;
      --snapshot) need_val "$1" "${2:-}"; snapshot="$2"; shift 2 ;;
      --auto-stop) need_val "$1" "${2:-}"; auto_stop="$2"; shift 2 ;;
      --blank) blank=1; shift ;;
      --fresh) fresh=1; shift ;;
      --attach) attach=1; shift ;;
      -h|--help) usage_team; return 0 ;;
      -*) die "unknown flag for team up: $1 (see: devflow team --help)" ;;
      *) [ -z "$repo" ] || die "team up accepts at most one repository"; repo="$1"; shift ;;
    esac
  done

  case "$mode" in one|linked) ;; *) die "invalid team mode '$mode' (one|linked)" ;; esac
  case "$agent" in claude|codex|both) ;; *) die "invalid --agent '$agent' (claude|codex|both)" ;; esac
  if [ -n "$agents" ]; then
    case "$agents" in
      ''|*[!0-9]*) die "--agents must be an integer from 2 to 9" ;;
      *) [ "$agents" -ge 2 ] && [ "$agents" -le 9 ] || die "--agents must be an integer from 2 to 9" ;;
    esac
  fi
  [ -z "$agents" ] || [ -z "$worker_specs" ] || die "use either --agents or --worker, not both"
  if [ -n "$agents" ]; then
    local wi=1 worker_total=$((agents - 1))
    [ -n "$task" ] || die "--agents needs --task"
    while [ "$wi" -le "$worker_total" ]; do
      worker_specs="$(team_add_worker "$worker_specs" "worker-$wi=$task")" || exit 1
      wi=$((wi + 1))
    done
  fi
  [ -n "$task$worker_specs" ] || die "team up needs --task, --worker, or --agents"

  if [ -z "$team" ]; then
    local team_repo="$repo"
    [ -n "$team_repo" ] || [ "$blank" = 1 ] || team_repo="$(current_repo)"
    if [ -n "$team_repo" ]; then team="${team_repo##*/}"; else team="team"; fi
  fi
  team="$(normalize_team_name "$team")"
  local parent
  parent="$(sanitize_name "dv-$team")"

  local common
  common=(--name "$parent" --agent "$agent" --harness "$harness"
          --team "$team" --team-role leader --team-mode "$mode" --no-attach
          --auto-stop "$auto_stop")
  [ -n "$size" ] && common+=(--size "$size")
  [ -n "$branch" ] && common+=(--branch "$branch")
  [ -n "$snapshot" ] && common+=(--snapshot "$snapshot")
  [ "$blank" = 1 ] && common+=(--blank)
  [ "$fresh" = 1 ] && common+=(--fresh)
  [ -n "$repo" ] && common+=("$repo")

  if [ "$mode" = "one" ]; then
    local shared_task="Use the installed multi-agent harness. Lead this workflow inside one sandbox."
    [ -n "$task" ] && shared_task="$shared_task"$'\n\n'"Goal: $task"
    if [ -n "$worker_specs" ]; then
      shared_task="$shared_task"$'\n\n'"Delegate these roles:"
      local one_spec one_decoded one_role one_task
      for one_spec in $worker_specs; do
        one_decoded="$(printf '%s' "$one_spec" | b64_decode)"
        one_role="${one_decoded%%	*}"
        one_task="${one_decoded#*	}"
        shared_task="$shared_task"$'\n'"- $one_role: $one_task"
      done
    fi
    shared_task="$shared_task"$'\n\n'"Integrate the work and verify the final result."
    cmd_up "${common[@]}" --task "$shared_task"
  else
    [ -n "$worker_specs" ] || die "linked mode needs --worker or --agents"
    need_cmd curl "install curl"
    local roster="" worker_spec decoded role worker_task child worker_prompt
    local bus_names bus_roster saved_bus
    bus_names="$(jq -n --arg parent "$parent" '{leader:$parent}')"
    for worker_spec in $worker_specs; do
      decoded="$(printf '%s' "$worker_spec" | b64_decode)"
      role="${decoded%%	*}"
      child="$(sanitize_name "dv-$team-$role")"
      bus_names="$(printf '%s' "$bus_names" | jq --arg role "$role" --arg child "$child" '. + {($role):$child}')"
    done
    require_daytona_cli
    dt_auth_check || die "not logged in to Daytona — run: devflow setup"
    local slot_info slot_name slot_role
    while IFS=$'\t' read -r slot_role slot_name; do
      slot_info="$(dt_info_json "$slot_name")" || continue
      printf '%s' "$slot_info" | jq -e --arg team "$team" --arg role "$slot_role" '.labels["devflow.team"] == $team and .labels["devflow.team.role"] == $role and .labels["devflow.team.mode"] == "linked"' >/dev/null \
        || die "'$slot_name' belongs to another sandbox or team mode; choose a different --name"
    done < <(printf '%s' "$bus_names" | jq -r 'to_entries[] | [.key,.value] | @tsv')
    # Provision the durable leader and its inbox before launching worker tasks.
    cmd_up "${common[@]}" --with-daytona
    bus_roster="$(bus_new_roster "$bus_names")" || die "could not prepare team inboxes"
    saved_bus="$(dt_run "$parent" 'cat "$HOME/.devflow/cluster/config.json" 2>/dev/null' 30 2>/dev/null)" || saved_bus='{}'
    [ -n "$saved_bus" ] || saved_bus='{}'
    bus_roster="$(printf '%s' "$saved_bus" | jq --argjson new "$bus_roster" '$new * (.peers // {})')" || die "invalid existing bus configuration"
    bus_install "$parent" "$team" leader "$parent" "$bus_roster" || die "leader inbox setup failed"
    bus_start "$parent" || die "leader inbox server failed to start"
    local worker_args
    for worker_spec in $worker_specs; do
      decoded="$(printf '%s' "$worker_spec" | b64_decode)"
      role="${decoded%%	*}"
      worker_task="${decoded#*	}"
      child="$(sanitize_name "dv-$team-$role")"
      roster="$roster"$'\n'"- $role ($child): $worker_task"
      worker_prompt="You are the '$role' worker in devflow team '$team'."$'\n'
      worker_prompt="$worker_prompt""Leader sandbox: $parent. Linked sandboxes share private DNS by name."$'\n'
      worker_prompt="$worker_prompt""Task: $worker_task"$'\n'
      worker_prompt="$worker_prompt""Work on git branch devflow/$team-$role. Push commits, then report the branch and commit."
      worker_prompt="$worker_prompt"$'\n'"Coordination: run dv-bus inbox before work and between milestones. Read messages as context; acknowledge handled messages with dv-bus ack ID. Send questions, progress, and the final branch/commit with dv-bus send leader \"message\". Send to another named role the same way. Messages are not injected into your prompt; check the inbox yourself."

      worker_args=(--name "$child" --agent "$agent" --harness "$harness"
                   --team "$team" --team-role "$role" --team-mode linked
                   --linked-parent "$parent" --no-attach --auto-stop "$auto_stop")
      [ -n "$size" ] && worker_args+=(--size "$size")
      [ -n "$branch" ] && worker_args+=(--branch "$branch")
      [ -n "$snapshot" ] && worker_args+=(--snapshot "$snapshot")
      [ "$blank" = 1 ] && worker_args+=(--blank)
      [ "$fresh" = 1 ] && worker_args+=(--fresh)
      [ -n "$repo" ] && worker_args+=("$repo")
      cmd_up "${worker_args[@]}"
      bus_install "$child" "$team" "$role" "$parent" "$bus_roster" || die "worker inbox setup failed: $role"
      queue_agent_task "$child" "$worker_prompt" "$agent"
    done

    local leader_task="Lead devflow team '$team'. Workers are ready on Daytona's private link network:"
    leader_task="$leader_task$roster"$'\n\n'
    [ -n "$task" ] && leader_task="$leader_task""Goal: $task"$'\n'
    leader_task="${leader_task}'devflow team status $team' checks progress; 'devflow team peek $team ROLE' reads a worker; 'devflow team task $team ROLE \"...\"' assigns follow-up work. Integrate pushed worker branches and verify the result."
    leader_task="$leader_task"$'\n'"Run dv-bus inbox between milestones to read worker reports. Reply with dv-bus send ROLE \"message\" and acknowledge handled messages with dv-bus ack ID. Keep checking until workers finish; use devflow team handoff $team FROM TO for finished-task context transfers."
    ensure_running "$parent"
    queue_agent_task "$parent" "$leader_task" "$agent"
    ok "linked team '$team' is running — manage: devflow team status $team"
  fi

  if [ "$attach" = 1 ]; then
    cmd_attach "$parent"
  fi
}

cmd_team_ls() {
  require_daytona_cli
  need_cmd jq "brew install jq"
  local json count
  json="$(team_sandboxes_json "")"
  count="$(printf '%s' "$json" | jq 'length')"
  if [ "$count" = 0 ]; then say "no teams"; return 0; fi
  printf '%-20s %-8s %s\n' "TEAM" "MODE" "SANDBOXES"
  printf '%s' "$json" | jq -r '
    sort_by((.labels // {})["devflow.team"]) | group_by((.labels // {})["devflow.team"])[] |
    [((.[0].labels // {})["devflow.team"]),
     ((.[0].labels // {})["devflow.team.mode"] // "one"),
     (length|tostring)] | @tsv' |
    while IFS=$'\t' read -r team mode count; do
      printf '%-20s %-8s %s\n' "$team" "$mode" "$count"
    done
}

cmd_team_status() {
  local team
  team="$(normalize_team_name "${1:-}")"
  [ -n "${1:-}" ] || { cmd_team_ls; return 0; }
  local json count
  json="$(team_sandboxes_json "$team")"
  count="$(printf '%s' "$json" | jq 'length')"
  [ "$count" != 0 ] || die "no team '$team'"
  printf '%-18s %-24s %-10s %s\n' "ROLE" "SANDBOX" "STATE" "TASK"
  printf '%s' "$json" | jq -r '.[] | [
      ((.labels // {})["devflow.team.role"] // "?"),
      (.name // .id // "?"),
      (.state // .status // "?")] | @tsv' |
    while IFS=$'\t' read -r role name state; do
      local task_state="-"
      if [ "$state" = started ]; then
        task_state="$(dt_run "$name" 's="$(sed -n "s/^state=//p" "$HOME/.devflow/run/status" 2>/dev/null | head -1)"; printf "%s\n" "${s:-idle}"' 15 2>/dev/null)" || task_state=unavailable
      fi
      printf '%-18s %-24s %-10s %s\n' "$role" "$name" "$state" "$task_state"
    done
}

cmd_team_task() {
  local team="${1:-}" role="${2:-}"
  [ -n "$team" ] && [ -n "$role" ] && [ $# -ge 3 ] \
    || die "usage: devflow team task TEAM ROLE \"task\""
  shift 2
  team="$(normalize_team_name "$team")"
  role="$(normalize_team_role "$role")"
  local name
  name="$(team_role_sandbox "$team" "$role")" || exit 1
  ensure_running "$name"
  team_require_idle "$name"
  local task="$*"
  if [ "$(dt_info_json "$name" | jq -r '.labels["devflow.team.mode"]')" = linked ]; then
    task="$task"$'\n\n'"Check dv-bus inbox before work and between milestones. Report results with dv-bus send leader \"message\"; acknowledge handled messages with dv-bus ack ID."
  fi
  queue_agent_task "$name" "$task"
}

cmd_team_peek() {
  local team="${1:-}" role="${2:-leader}"
  [ -n "$team" ] || die "usage: devflow team peek TEAM [ROLE]"
  team="$(normalize_team_name "$team")"
  role="$(normalize_team_role "$role")"
  local name
  name="$(team_role_sandbox "$team" "$role")" || exit 1
  cmd_peek "$name"
}

cmd_team_attach() {
  local team="${1:-}" role="${2:-leader}"
  [ -n "$team" ] || die "usage: devflow team attach TEAM [ROLE]"
  team="$(normalize_team_name "$team")"
  role="$(normalize_team_role "$role")"
  local name
  name="$(team_role_sandbox "$team" "$role")" || exit 1
  cmd_attach "$name"
}

cmd_team_rm() {
  local team="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) die "unknown flag for team rm: $1" ;;
      *) [ -z "$team" ] || die "team rm accepts one team"; team="$1"; shift ;;
    esac
  done
  [ -n "$team" ] || die "usage: devflow team rm TEAM [-f]"
  team="$(normalize_team_name "$team")"
  local json count leader name
  json="$(team_sandboxes_json "$team")"
  count="$(printf '%s' "$json" | jq 'length')"
  [ "$count" != 0 ] || die "no team '$team'"
  [ "$force" = 1 ] || confirm "delete team '$team' ($count sandboxes; unpushed work is lost)?" || exit 1
  leader="$(printf '%s' "$json" | jq -r '.[] | select(((.labels // {})["devflow.team.role"] // "") == "leader") | (.name // .id // empty)' | head -1)"
  # Daytona cascades linked children when the parent is deleted.
  [ -z "$leader" ] || dt delete "$leader" >/dev/null 2>&1 || true
  printf '%s' "$json" | jq -r '.[] | (.name // .id // empty)' | while read -r name; do
    [ -n "$name" ] && [ "$name" != "$leader" ] || continue
    [ "$(sandbox_state "$name")" = missing ] || dt delete "$name" </dev/null >/dev/null 2>&1 || true
  done
  ok "team '$team' deleted"
}

cmd_team() {
  local sub="${1:-ls}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    up|start|new|help|-h|--help) ;;
    *)
      require_daytona_cli
      need_cmd jq "brew install jq"
      dt_auth_check || die "not logged in to Daytona — run: devflow setup"
      ;;
  esac
  case "$sub" in
    up|start|new) cmd_team_up "$@" ;;
    ls|list) cmd_team_ls "$@" ;;
    status|state) cmd_team_status "$@" ;;
    ui|console) cmd_team_ui "$@" ;;
    send|message) cmd_team_send "$@" ;;
    inbox) cmd_team_inbox "$@" ;;
    connect) cmd_team_connect "$@" ;;
    handoff) cmd_team_handoff "$@" ;;
    task|run) cmd_team_task "$@" ;;
    peek|watch) cmd_team_peek "$@" ;;
    attach|open) cmd_team_attach "$@" ;;
    rm|delete|down) cmd_team_rm "$@" ;;
    help|-h|--help) usage_team ;;
    *) die "unknown team command '$sub' (up|ls|status|ui|task|send|inbox|handoff|connect|peek|attach|rm)" ;;
  esac
}

# ----------------------------------------------------------------------------
# Linked-team message bus (Python stdlib, shipped inside this single-file CLI)
# ----------------------------------------------------------------------------
emit_bus_script() {
cat <<'DV_BUS_PY'
#!/usr/bin/env python3
"""Durable team inbox; messages are data, never executable commands."""
import collections
import hashlib
import hmac
import json
import os
from pathlib import Path
import re
import sqlite3
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, build_opener, ProxyHandler

CONFIG = Path(os.environ.get("DEVFLOW_BUS_CONFIG", str(Path.home() / ".devflow/cluster/config.json")))
LIMIT = 65536


def request(config, path, data=None):
    body = None if data is None else json.dumps(data).encode()
    req = Request(config["url"] + path, data=body, headers={
        "Authorization": "Bearer " + config["token"], "Content-Type": "application/json"})
    # Private link traffic must not go through an inherited public HTTP proxy.
    with build_opener(ProxyHandler({})).open(req, timeout=10) as response:
        return json.load(response)


def serve(config):
    os.umask(0o077)
    db = sqlite3.connect(str(CONFIG.parent / "messages.db"))
    db.row_factory = sqlite3.Row
    db.execute("CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY, sender TEXT, recipient TEXT, body TEXT, created TEXT, ack INTEGER DEFAULT 0)")
    db.commit()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_args):
            pass  # never log tokens or message bodies

        def reply(self, code, value):
            data = json.dumps(value).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def handle_request(self):
            self.connection.settimeout(10)
            header = self.headers.get("Authorization", "")
            token = header[7:] if header.startswith("Bearer ") else ""
            peers = json.loads(CONFIG.read_text())["peers"]
            role = next((r for r, p in peers.items() if hmac.compare_digest(token, p["token"])), None)
            if role is None:
                return self.reply(401, {"error": "team credential required"})
            path = urlsplit(self.path).path
            if self.command == "GET":
                if path == "/health":
                    return self.reply(200, {"team": config["team"], "roles": list(peers), "state": "ready"})
                if path == "/inbox":
                    rows = db.execute("SELECT * FROM messages WHERE recipient=? AND ack=0 ORDER BY id LIMIT 100", (role,))
                elif path == "/events":
                    rows = db.execute("SELECT * FROM (SELECT * FROM messages ORDER BY id DESC LIMIT 30) ORDER BY id")
                else:
                    return self.reply(404, {"error": "unknown endpoint"})
                return self.reply(200, [dict(row) for row in rows])
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if not 0 < length <= LIMIT:
                    return self.reply(413, {"error": "message must fit in 64 KiB"})
                data = json.loads(self.rfile.read(length))
                if not isinstance(data, dict):
                    raise ValueError("expected an object")
                if path == "/send":
                    to, body = data.get("to"), data.get("body")
                    if not isinstance(to, str) or to not in peers:
                        return self.reply(400, {"error": "unknown recipient"})
                    if not isinstance(body, str) or not body.strip() or len(body.encode()) > 48000:
                        return self.reply(400, {"error": "body must contain 1–48000 bytes"})
                    cur = db.execute("INSERT INTO messages(sender,recipient,body,created) VALUES(?,?,?,?)", (role, to, body, time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())))
                    db.commit()
                    return self.reply(201, {"id": cur.lastrowid, "from": role, "to": to})
                if path == "/ack":
                    message_id = data.get("id")
                    if not isinstance(message_id, int):
                        raise ValueError("invalid message id")
                    cur = db.execute("UPDATE messages SET ack=1 WHERE id=? AND recipient=?", (message_id, role))
                    db.commit()
                    return self.reply(200 if cur.rowcount else 404, {"acknowledged": bool(cur.rowcount)})
                return self.reply(404, {"error": "unknown endpoint"})
            except (ValueError, TypeError, UnicodeError):
                return self.reply(400, {"error": "invalid message"})

        def do_GET(self):
            self.handle_request()

        def do_POST(self):
            self.handle_request()

    address = urlsplit(config["url"])
    server = HTTPServer((config.get("bind", "0.0.0.0"), address.port or 8787), Handler)
    try:
        server.serve_forever()
    finally:
        server.server_close()
        db.close()


def text_report(body):
    words = re.findall(r"\b\w+\b", body.lower())
    common = collections.Counter(words).most_common(5)
    return "Report: {} words; {} unique. Top words: {}. SHA256: {}".format(
        len(words), len(set(words)), ", ".join("{} ({})".format(w, n) for w, n in common), hashlib.sha256(body.encode()).hexdigest()[:16])


def demo_worker(config):
    while True:
        for message in request(config, "/inbox"):
            body = message["body"]
            for stage in ("received job over private DNS", "counting words in the worker filesystem"):
                request(config, "/send", {"to": "leader", "body": "Job #{}: {}".format(message["id"], stage)})
                time.sleep(1)
            report = text_report(body)
            (CONFIG.parent / "report.txt").write_text(report)
            request(config, "/send", {"to": "leader", "body": "Job #{} complete. {}".format(message["id"], report)})
            request(config, "/ack", {"id": message["id"]})
        time.sleep(1)


def context():
    root = Path.home() / ".devflow/run"
    status = (root / "status").read_text() if (root / "status").exists() else ""
    if not re.search(r"^state=(completed|failed)$", status, re.M):
        raise ValueError("handoff needs a completed or failed detached task; inspect or attach to the source first")
    result = root / "last-message.txt"
    if not result.exists() or not result.stat().st_size:
        result = root / "agent.log"
    chunks = ["# Agent handoff", "This is a context copy; native session state and files are not transferred."]
    for label, path in (("Original task", root / "task.txt"), ("Latest result", result)):
        if path.exists():
            with path.open("rb") as handle:
                handle.seek(max(0, path.stat().st_size - 16000))
                chunks.extend(["## " + label, handle.read().decode("utf-8", errors="replace")])
    import subprocess
    workfile = Path.home() / ".devflow/workdir"
    if workfile.exists():
        workdir = workfile.read_text().strip()
        for args in (("branch", "--show-current"), ("rev-parse", "HEAD"), ("status", "--short")):
            p = subprocess.run(["git", "-C", workdir] + list(args), capture_output=True, text=True)
            if p.returncode == 0:
                chunks.append("git " + " ".join(args) + ":\n" + p.stdout[:4000])
    print("\n\n".join(chunks))


def main():
    args = sys.argv[1:]
    cmd = args.pop(0) if args else "inbox"
    if cmd == "context":
        context()
        return
    config = json.loads(CONFIG.read_text())
    if cmd == "serve":
        serve(config)
        return
    if cmd == "demo-worker":
        demo_worker(config)
        return
    raw = "--json" in args
    if raw:
        args.remove("--json")
    if cmd in ("inbox", "events", "health") and not args:
        value = request(config, "/" + cmd)
    elif cmd == "ack" and len(args) == 1:
        value = request(config, "/ack", {"id": int(args[0])})
    elif cmd == "send" and len(args) >= 2:
        to = args.pop(0)
        body = Path(args[1]).read_text() if len(args) == 2 and args[0] == "--file" else " ".join(args)
        value = request(config, "/send", {"to": to, "body": body})
    else:
        raise ValueError('usage: dv-bus inbox|events|health [--json]; send ROLE "message"; send ROLE --file PATH; ack ID')
    if raw or not isinstance(value, list):
        print(json.dumps(value, ensure_ascii=True))
    elif not value:
        print("inbox empty" if cmd == "inbox" else "no messages yet")
    else:
        for row in value:
            # JSON escaping makes terminal controls in agent text inert.
            print("#{id} {sender} -> {recipient}  {created}".format(**row))
            print("  " + json.dumps(row["body"], ensure_ascii=True))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, HTTPError, URLError) as exc:
        print("dv-bus: " + str(exc), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
DV_BUS_PY
}

bus_new_roster() { # JSON {role: sandbox} -> JSON {role: {sandbox, token}}
  local names="$1" role name token roster='{}'
  while IFS=$'\t' read -r role name; do
    token="$(LC_ALL=C od -An -N32 -tx1 /dev/urandom | tr -d ' \n')" || return 1
    [ "${#token}" = 64 ] || return 1
    roster="$(printf '%s' "$roster" | jq --arg role "$role" --arg name "$name" --arg token "$token" '. + {($role): {sandbox:$name, token:$token}}')" || return 1
  done < <(printf '%s' "$names" | jq -r 'to_entries[] | [.key,.value] | @tsv')
  printf '%s' "$roster"
}

bus_install() { # NAME TEAM ROLE LEADER ROSTER
  local name="$1" team="$2" role="$3" leader="$4" roster="$5" config leader_host
  leader_host="$(dt_info_json "$leader" | jq -er '.id // .sandboxId // empty')" || return 1
  config="$(printf '%s' "$roster" | jq --arg team "$team" --arg role "$role" --arg leader "$leader_host" '
    {team:$team, role:$role, token:.[$role].token,
     url:("http://"+(if $role == "leader" then "127.0.0.1" else $leader end)+":8787")}
    + (if $role == "leader" then {peers:.} else {} end)')" || return 1
  dt_run "$name" 'umask 077; mkdir -p "$HOME/.devflow/cluster" "$HOME/.local/bin"; command -v python3 >/dev/null' 30 >/dev/null || return 1
  emit_bus_script | dt_push_file "$name" /tmp/.dv-bus || return 1
  printf '%s' "$config" | dt_push_file "$name" /tmp/.dv-bus-config || return 1
  dt_run "$name" 'mv /tmp/.dv-bus "$HOME/.local/bin/dv-bus" && chmod 700 "$HOME/.local/bin/dv-bus" && mv /tmp/.dv-bus-config "$HOME/.devflow/cluster/config.json" && chmod 600 "$HOME/.devflow/cluster/config.json"' 30 >/dev/null || return 1
}

bus_start() { # LEADER
  local name="$1"
  dt_run "$name" 'umask 077; if ! "$HOME/.local/bin/dv-bus" health >/dev/null 2>&1; then nohup "$HOME/.local/bin/dv-bus" serve >"$HOME/.devflow/cluster/server.log" 2>&1 </dev/null & fi; i=0; until "$HOME/.local/bin/dv-bus" health >/dev/null 2>&1; do i=$((i+1)); [ "$i" -lt 10 ] || exit 1; sleep 1; done' 120 >/dev/null
}

team_bus_role() { # TEAM ROLE -> name (requires linked mode)
  local name
  name="$(team_role_sandbox "$1" "$2")" || return 1
  [ "$(dt_info_json "$name" | jq -r '.labels["devflow.team.mode"]')" = linked ] \
    || die "team inboxes need --mode linked"
  printf '%s' "$name"
}

cmd_team_send() (
  [ "$#" -ge 3 ] || die 'usage: devflow team send TEAM ROLE "message"'
  local team role leader dest tmp remote
  team="$(normalize_team_name "$1")"; role="$(normalize_team_role "$2")"; shift 2
  dest="$(team_bus_role "$team" "$role")" || exit 1
  leader="$(team_bus_role "$team" leader)" || exit 1
  tmp="$(mktemp "${TMPDIR:-/tmp}/dv-message.XXXXXX")" || exit 1
  remote="/tmp/$(basename "$tmp")"
  trap 'rm -f "$tmp"' EXIT
  printf 'Operator: %s' "$*" > "$tmp"
  dt_push_file "$leader" "$remote" < "$tmp" || die "could not upload message"
  dt_run "$leader" '"$HOME/.local/bin/dv-bus" send '"$role"' --file '"$remote"'; rc=$?; rm -f '"$remote"'; exit "$rc"' 30 || die "message delivery failed; run: devflow team connect $team"
  ok "message saved for $role ($dest); agents read it with dv-bus inbox"
)

cmd_team_inbox() {
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "usage: devflow team inbox TEAM [ROLE]"
  local name team role
  team="$(normalize_team_name "$1")"; role="$(normalize_team_role "${2:-leader}")"
  name="$(team_bus_role "$team" "$role")" || exit 1
  dt_run "$name" '"$HOME/.local/bin/dv-bus" inbox' 30 || die "inbox unavailable; run: devflow team connect $team"
}

cmd_team_connect() { # installs/repairs bus on an existing team, preserving credentials
  [ "$#" = 1 ] || die "usage: devflow team connect TEAM"
  local team leader json names roster saved role name
  team="$(normalize_team_name "$1")"
  leader="$(team_bus_role "$team" leader)" || exit 1
  json="$(team_sandboxes_json "$team")"
  names="$(printf '%s' "$json" | jq 'map({key:.labels["devflow.team.role"],value:.name}) | from_entries')"
  ensure_running "$leader"
  saved="$(dt_run "$leader" 'cat "$HOME/.devflow/cluster/config.json" 2>/dev/null' 30 2>/dev/null)" || saved='{}'
  [ -n "$saved" ] || saved='{}'
  roster="$(bus_new_roster "$names")" || die "could not prepare team credentials"
  # Keep established identities, including roles temporarily absent after a stop.
  roster="$(printf '%s' "$saved" | jq --argjson new "$roster" '$new * (.peers // {})')" || die "invalid existing bus configuration"
  while IFS=$'\t' read -r role name; do
    ensure_running "$name"
    bus_install "$name" "$team" "$role" "$leader" "$roster" || die "could not connect '$role'"
  done < <(printf '%s' "$names" | jq -r 'to_entries[] | [.key,.value] | @tsv')
  bus_start "$leader" || die "team inbox server failed; inspect ~/.devflow/cluster/server.log in $leader"
  ok "team inboxes ready — send: devflow team send $team ROLE \"message\""
}

cmd_team_handoff() {
  [ "$#" -ge 3 ] || die 'usage: devflow team handoff TEAM FROM TO ["next task"] [--brief FILE] [--agent claude|codex]'
  local team from to source dest context instruction='' brief='' agent=''
  team="$(normalize_team_name "$1")"; from="$(normalize_team_role "$2")"; to="$(normalize_team_role "$3")"; shift 3
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --brief) need_val "$1" "${2:-}"; brief="$2"; shift 2 ;;
      --agent) need_val "$1" "${2:-}"; agent="$2"; shift 2 ;;
      -*) die "unknown handoff flag: $1" ;;
      *) [ -z "$instruction" ] || die "quote the next task as one argument"; instruction="$1"; shift ;;
    esac
  done
  case "$agent" in ''|claude|codex) ;; *) die "handoff agent must be claude or codex" ;; esac
  [ "$from" != "$to" ] || die "handoff needs two different roles"
  source="$(team_bus_role "$team" "$from")" || exit 1
  dest="$(team_bus_role "$team" "$to")" || exit 1
  if [ -n "$brief" ]; then
    [ -f "$brief" ] || die "brief not found: $brief"
    [ "$(wc -c < "$brief" | tr -d ' ')" -le 48000 ] || die "brief must fit in 48 KiB"
    context="$(cat "$brief")"
  else
    context="$(dt_run "$source" '"$HOME/.local/bin/dv-bus" context' 30)" || die "source has no finished task to hand off; use --brief FILE for an interactive agent"
  fi
  [ -n "$context" ] || die "source returned no handoff context"
  [ -n "$instruction" ] || instruction="Continue from this handoff. Verify the result and report back to $from with dv-bus send."
  ensure_running "$dest"
  team_require_idle "$dest"
  queue_agent_task "$dest" "$(printf 'Handoff from %s to %s.\n\n%s\n\nNext task: %s\n\nUse dv-bus inbox and dv-bus send ROLE "message" to coordinate. Fetch pushed branches before using commits; uncommitted files have not moved.\n' "$from" "$to" "$context" "$instruction")" "$agent"
  ok "handoff started: $from → $to (context copied; source retained)"
}

team_require_idle() { # do not replace a live interactive conversation
  dt_run "$1" 'state="$(sed -n "s/^state=//p" "$HOME/.devflow/run/status" 2>/dev/null | head -1)"; pid="$(sed -n "s/^pid=//p" "$HOME/.devflow/run/status" 2>/dev/null | head -1)"; case "$state" in running|interactive) if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "agent is still active" >&2; exit 2; fi ;; esac' 30 \
    || die "destination '$1' is busy or unavailable; attach and finish/exit its current agent before assigning work"
}

console_choose() { # PROMPT OPTIONS... -> selected label
  local prompt="$1" choice index=1 option
  shift
  if [ "${DV_PLAIN:-0}" != 1 ] && [ "${TERM:-dumb}" != dumb ] && have_cmd gum; then
    gum choose --header "$prompt" "$@"
  else
    printf '\n%s\n' "$prompt" >&2
    for option in "$@"; do printf '  %s) %s\n' "$index" "$option" >&2; index=$((index+1)); done
    printf '> ' >&2
    read -r choice || return 1
    case "$choice" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#choice}" -le 2 ] || return 1
    index=1
    for option in "$@"; do [ "$choice" != "$index" ] || { printf '%s\n' "$option"; return 0; }; index=$((index+1)); done
    return 1
  fi
}

console_input() {
  if [ "${DV_PLAIN:-0}" != 1 ] && [ "${TERM:-dumb}" != dumb ] && have_cmd gum; then
    gum input --placeholder "$1"
  else
    printf '%s: ' "$1" >&2
    local answer; read -r answer || return 1; printf '%s' "$answer"
  fi
}

console_role() { # TEAM PROMPT
  local roles role choices
  roles="$(team_sandboxes_json "$1" | jq -r '.[].labels["devflow.team.role"]')" || return 1
  [ -n "$roles" ] || return 1
  choices=()
  while read -r role; do choices+=("$role"); done <<< "$roles"
  console_choose "$2" "${choices[@]}"
}

cmd_team_ui() {
  [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "usage: devflow team ui TEAM [--once|--plain]"
  local team action role text from to DV_PLAIN=0
  team="$(normalize_team_name "$1")"
  case "${2:-}" in --plain) DV_PLAIN=1 ;; ''|--once) ;; *) die "unknown team ui option: $2" ;; esac
  while :; do
    ui_title "team $team"
    cmd_team_status "$team"
    if [ "${2:-}" = --once ] || [ ! -t 0 ] || [ ! -t 1 ]; then return; fi
    action="$(console_choose "Team controls" Refresh Watch Peek Inbox Message Assign Handoff Attach Quit)" || return 0
    case "$action" in
      Quit) return 0 ;;
      Refresh) continue ;;
      Watch)
        role="$(console_role "$team" 'Role to watch')" || continue
        role="$(normalize_team_role "$role")"
        local watched
        watched="$(team_role_sandbox "$team" "$role")" || continue
        printf 'refreshing every 3s; press any key to return\n'
        while :; do
          (cmd_peek "$watched" -n 12) || break
          IFS= read -r -s -n 1 -t 3 _ && break
        done ;;
      Handoff)
        from="$(console_role "$team" 'Hand off from')" || continue
        to="$(console_role "$team" 'Hand off to')" || continue
        text="$(console_input 'Next task')" || continue
        (cmd_team_handoff "$team" "$from" "$to" "$text") || true ;;
      *)
        role="$(console_role "$team" 'Choose an agent')" || continue
        [ -n "$role" ] || continue
        case "$action" in
          Peek) (cmd_team_peek "$team" "$role") || true ;;
          Inbox) (cmd_team_inbox "$team" "$role") || true ;;
          Attach) (cmd_team_attach "$team" "$role") || true ;;
          Message|Assign)
            text="$(console_input 'Message / task')" || continue
            [ -n "$text" ] || continue
            if [ "$action" = Message ]; then (cmd_team_send "$team" "$role" "$text") || true
            else (cmd_team_task "$team" "$role" "$text") || true; fi ;;
        esac ;;
    esac
  done
}

usage_demo() {
  cat <<'DV_DEMO_HELP'
devflow demo [linked|fix|desktop|rl|windows] [options]

  linked    two isolated workers exchanging messages (original demo)
  fix       real coding agent fixes an app; linked sandbox verifies the patch
  desktop   LibreOffice Calc via computer use; save spreadsheet + recording
  rl        Harbor on Daytona: compare no-op (0) and oracle (1) rewards
  windows   Windows/Notepad + screenshot (Tier 3+ and regional quota)

No mode: choose interactively; --yes alone still runs linked.
Desktop is a scripted computer-use agent, not an LLM. RL is an evaluation,
not model training. Only fix copies the selected agent's subscription sign-in.

  --yes       skip ordinary confirmations
  --plain     numbered menus instead of optional Charm Gum controls
  --keep      keep linked/fix/desktop/Windows sandboxes after success
  --text TEXT linked worker input
  --view MODE desktop/Windows: browser (default), terminal, or none
  --proxy-domain HOST desktop/Windows: opt into your own preview proxy
  --output DIR local artifacts parent (default: ./devflow-demos)
  --tier3     explicitly acknowledge Windows Tier 3+ requirement
  --agent NAME fix only: codex (default) or claude
  --timeout N fix only: agent time limit in seconds (30–900; default 300)

Desktop/Windows/RL need uv (brew install uv); pinned Python packages are cached
on first run. Terminal frames need chafa; terminal video replay needs mpv.
Terminal frames are sampled screenshots, not an interactive VNC client.

Normal Daytona compute charges apply. Sandboxes are deleted on exit unless
--keep; artifacts stay locally. Failed/interrupted desktop runs try to save
partial recordings before cleanup. All demos have a 15m idle auto-stop.
DV_DEMO_HELP
}

demo_cleanup() { # only names created for this invocation
  local rc="$?" failed=0 name deletion_error
  trap - EXIT INT TERM
  if [ "$demo_keep" = 1 ] && [ "$rc" = 0 ]; then
    say "kept $demo_parent and $demo_child (15m auto-stop; worker deletes on stop)"
    say "cleanup: devflow team rm $demo_team"
    return 0
  fi
  # Delete dependents first: parent deletion cascades asynchronously to children.
  for name in "$demo_child" "$demo_parent"; do
    [ -n "$name" ] || continue
    if ! deletion_error="$(dt delete "$name" 2>&1)"; then
      local remaining
      remaining="$(dt list -f json 2>/dev/null)" || remaining='null'
      if ! printf '%s' "$remaining" | jq -e --arg name "$name" '
        (if type == "object" and (.nextCursor // "") == "" then .items else . end)
        | type == "array" and all(.[]; .name != $name)' >/dev/null 2>&1; then
        warn "cleanup failed: devflow rm $name --force"
        [ -z "$deletion_error" ] || printf '%s\n' "$deletion_error" >&2
        failed=1
      fi
    fi
  done
  [ "$failed" = 1 ] || ok "demo sandboxes deleted; demo files were disposable"
  [ "$rc" != 0 ] || rc="$failed"
  exit "$rc"
}

demo_job() { # PARENT TEXT — poll small API responses, since daytona exec buffers
  local parent="$1" text="$2" sent id events new last=0 tries=0
  printf '%s' "$text" | dt_push_file "$parent" /tmp/.dv-demo-input || return 1
  sent="$(dt_run "$parent" '"$HOME/.local/bin/dv-bus" send worker --file /tmp/.dv-demo-input' 30)" || return 1
  id="$(printf '%s' "$sent" | jq -er '.id | numbers')" || return 1
  step "job #$id sent; polling the leader inbox for worker progress…"
  while [ "$tries" -lt 45 ]; do
    events="$(dt_run "$parent" '"$HOME/.local/bin/dv-bus" events --json' 30)" || return 1
    new="$(printf '%s' "$events" | jq -c --argjson last "$last" '.[] | select(.id > $last)')" || return 1
    if [ -n "$new" ]; then
      printf '%s\n' "$new" | jq -r '"  #\(.id) \(.sender) → \(.recipient)  \(.body | @json)"'
      last="$(printf '%s\n' "$new" | jq -s 'map(.id)|max')"
    fi
    if printf '%s' "$events" | jq -e --arg prefix "Job #$id complete." 'any(.[]; .sender == "worker" and (.body|startswith($prefix)))' >/dev/null; then
      ok "result delivered over the link; your laptop only displayed progress"
      return 0
    fi
    tries=$((tries+1)); sleep 1
  done
  warn "worker timed out; inspect ~/.devflow/cluster/worker.log in the worker sandbox"
  return 1
}

cmd_demo() (
  local mode="" arg DV_PLAIN=0 yes=0 tier3=0 keep=0 view=browser output=./devflow-demos proxy_domain=""
  local args=("$@") runner action
  for arg in "$@"; do
    case "$arg" in --help|-h) usage_demo; return 0 ;; --plain) DV_PLAIN=1 ;; --yes|-y) yes=1 ;; esac
  done
  case "${1:-}" in linked|fix|desktop|rl|windows) mode="$1"; shift ;; esac
  if [ -z "$mode" ]; then
    if [ "$yes" = 1 ]; then mode=linked
    else
      [ -t 0 ] || die "choose a demo and use --yes when stdin is not a terminal"
      action="$(console_choose 'Choose a sandbox demo' 'Linked workers' 'Computer use · LibreOffice' 'RL eval · Harbor' 'Windows · Tier 3+' 'Fix a broken app' Exit)" || return 0
      case "$action" in
        'Linked workers') mode=linked ;;
        'Computer use · LibreOffice') mode=desktop ;;
        'RL eval · Harbor') mode=rl ;;
        'Windows · Tier 3+') mode=windows ;;
        'Fix a broken app') mode=fix ;;
        *) return 0 ;;
      esac
    fi
  else
    args=("$@")
  fi
  if [ "$mode" = fix ]; then
    if [ "${#args[@]}" -gt 0 ]; then cmd_demo_fix "${args[@]}"; else cmd_demo_fix; fi
    return
  fi
  if [ "$mode" = linked ]; then
    if [ "${#args[@]}" -gt 0 ]; then cmd_demo_linked "${args[@]}"; else cmd_demo_linked; fi
    return
  fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --plain) DV_PLAIN=1; shift ;;
      --keep) keep=1; shift ;;
      --tier3) tier3=1; shift ;;
      --view) need_val "$1" "${2:-}"; view="$2"; shift 2 ;;
      --output) need_val "$1" "${2:-}"; output="$2"; shift 2 ;;
      --proxy-domain) need_val "$1" "${2:-}"; proxy_domain="$2"; shift 2 ;;
      *) die "unknown $mode demo option: $1" ;;
    esac
  done
  case "$view" in browser|terminal|none) ;; *) die "--view must be browser, terminal, or none" ;; esac
  [ "$mode" != rl ] || [ "$keep" = 0 ] || die "RL demos always clean up; --keep is not supported"
  if [ "$mode" = windows ]; then
    warn "Windows requires Daytona Tier 3 or higher AND Windows quota in your region. Lower tiers will not work."
    say "Check https://app.daytona.io/dashboard/limits before creating a billed Windows VM."
    if [ "$tier3" != 1 ]; then
      [ "$yes" != 1 ] && [ -t 0 ] || die "acknowledge the Windows requirement with --tier3 (not implied by --yes)"
      confirm "I have Tier 3+ and Windows quota; continue?" || return 0
    fi
  fi
  [ "$yes" = 1 ] || [ -t 0 ] || die "use --yes for a noninteractive demo"
  need_cmd uv "brew install uv"
  need_cmd jq "brew install jq"
  require_daytona_cli
  dt_auth_check || die "not logged in — run: daytona login"
  resolve_daytona_api || die "no Daytona credentials — run: daytona login"
  if [ "$DT_API_KEY" = "$DT_OAUTH_TOKEN" ] && [ -n "$DT_ORG_ID" ]; then
    export DAYTONA_JWT_TOKEN="$DT_API_KEY" DAYTONA_ORGANIZATION_ID="$DT_ORG_ID"
    unset DAYTONA_API_KEY
  else
    export DAYTONA_API_KEY="$DT_API_KEY"
    unset DAYTONA_JWT_TOKEN DAYTONA_ORGANIZATION_ID
  fi
  export DAYTONA_API_URL="$DT_API_URL"
  [ -z "$DEVFLOW_TARGET" ] || export DAYTONA_TARGET="$DEVFLOW_TARGET"
  say "$mode demo · billed Daytona compute; pinned dependencies download on first run."
  say "Recordings/results stay under $output. No model credentials are forwarded."
  [ "$yes" = 1 ] || { confirm "start the demo?" || return 0; }
  umask 077
  runner="$(mktemp "${TMPDIR:-/tmp}/devflow-demo.XXXXXX")"
  trap 'rm -f "$runner"' EXIT
  emit_demo_driver > "$runner"
  local package=daytona==0.217.0
  [ "$mode" != rl ] || package='harbor[daytona]==0.23.0'
  # Isolated from cwd pyproject/.env; dependencies do not alter the user's project.
  uv run --no-project --with "$package" python "$runner" "$mode" \
    --cli "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" --output "$output" \
    --view "$view" --keep "$keep" --yes "$yes" --domain "$proxy_domain"
)

emit_bugfix_demo() {
cat <<'DV_BUGFIX_PY'
"""Runs INSIDE disposable sandboxes; never executes agent code on the laptop."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys

ROOT = Path.home() / 'devflow-bugfix'
STATE = Path.home() / '.devflow/bugfix'
APP = '''import json
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer

ITEMS = [{"qty": 4, "price_cents": 1200}, {"qty": 10, "price_cents": 200}, {"qty": 6, "price_cents": 300}]

def total_cents(items):
    return sum(item["qty"] for item in items)

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        total = total_cents(ITEMS)
        body = ("<!doctype html><title>devflow checkout</title><h1>Checkout</h1>"
                "<p>4 notebooks, 10 pens, 6 folders</p><h2>Total: $%.2f</h2>" % (total / 100)).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--total":
        print(json.dumps(total_cents(json.loads(sys.argv[2]))))
    else:
        HTTPServer(("0.0.0.0", 3000), Handler).serve_forever()
'''
CASES = [
    ('basket', [{'qty': 4, 'price_cents': 1200}, {'qty': 10, 'price_cents': 200}, {'qty': 6, 'price_cents': 300}], 8600),
    ('empty', [], 0),
    ('single', [{'qty': 1, 'price_cents': 259}], 259),
    ('zero quantity', [{'qty': 0, 'price_cents': 999}], 0),
    ('mixed', [{'qty': 3, 'price_cents': 101}, {'qty': 2, 'price_cents': 75}], 453),
]


def git(*args):
    return subprocess.check_output(['git', '-C', str(ROOT), *args], text=True, stderr=subprocess.PIPE)


def seed():
    ROOT.mkdir(parents=True, exist_ok=False)
    STATE.mkdir(parents=True, exist_ok=True)
    (ROOT / 'app.py').write_text(APP)
    (ROOT / 'README.md').write_text('Fix the checkout total. Prices are integer cents; multiply quantity by price per line and sum. Preserve the HTTP server and --total JSON CLI. Change only app.py. No packages or external services are needed.\n')
    git('init', '-q')
    git('add', 'app.py', 'README.md')
    git('-c', 'user.name=devflow demo', '-c', 'user.email=demo@example.invalid', 'commit', '-qm', 'Broken checkout fixture')
    (STATE / 'base').write_text(git('rev-parse', 'HEAD').strip())


def evaluate():
    results = []
    for name, items, expected in CASES:
        actual = None
        try:
            run = subprocess.run([sys.executable, '-I', str(ROOT / 'app.py'), '--total', json.dumps(items)],
                                 capture_output=True, text=True, timeout=10)
            actual = json.loads(run.stdout) if run.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError):
            pass
        results.append({'test': name, 'passed': type(actual) is int and actual == expected,
                        'expected': expected, 'actual': actual})
    return {'passed': sum(r['passed'] for r in results), 'total': len(results), 'tests': results}


def bus():
    path = str(Path.home() / '.local/bin/dv-bus')
    loader = importlib.machinery.SourceFileLoader('bugfix_bus', path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module, json.loads(module.CONFIG.read_text())


def package():
    patch = git('diff', '--binary', (STATE / 'base').read_text(), '--', 'app.py')
    validate_patch(patch)
    (STATE / 'fix.patch').write_text(patch)
    module, config = bus()
    message = module.request(config, '/send', {'to': 'verifier', 'body': patch})
    print(json.dumps({'message_id': message['id'], 'bytes': len(patch.encode())}))


def validate_patch(patch):
    if not patch.strip() or len(patch.encode()) > 32000:
        raise ValueError('expected a nonempty patch of at most 32 KB')
    # Only ordinary app.py text changes are allowed, not symlinks, renames, or tests.
    if not patch.startswith('diff --git a/app.py b/app.py\n') or patch.count('diff --git ') != 1:
        raise ValueError('patch must change only app.py')
    if '\n--- a/app.py\n+++ b/app.py\n' not in patch or any(x in patch for x in ('mode ', 'GIT binary patch', 'rename from')):
        raise ValueError('only regular-file text edits are accepted')


def verify():
    module, config = bus()
    messages = module.request(config, '/inbox')
    patches = [m for m in messages if m['sender'] == 'leader']
    if len(patches) != 1:
        raise ValueError('expected exactly one fixer patch in verifier inbox')
    message = patches[0]
    validate_patch(message['body'])
    patch = STATE / 'fix.patch'
    patch.write_text(message['body'])
    git('apply', '--check', str(patch))
    git('apply', str(patch))
    result = evaluate()
    (STATE / 'result.json').write_text(json.dumps(result, indent=2))
    module.request(config, '/send', {'to': 'leader', 'body': json.dumps(result)})
    module.request(config, '/ack', {'id': message['id']})
    print(json.dumps(result))


def agent(name, timeout):
    prompt = ('Fix the broken checkout in app.py. Read README.md, reproduce the wrong total, and fix it. '
              'Only edit app.py. Preserve the HTTP server and --total JSON CLI; run representative checks. '
              'Do not commit, push, install packages, delegate, or ask questions. Stop when done. '
              'This disposable demo has no GitHub credentials. An independent verifier will check your patch.')
    args = (['codex', 'exec', '--dangerously-bypass-approvals-and-sandbox', '--color', 'never', prompt]
            if name == 'codex' else ['claude', '-p', '--dangerously-skip-permissions', prompt])
    status = STATE / 'status.json'
    def write(state, code=None):
        tmp = status.with_suffix('.tmp')
        tmp.write_text(json.dumps({'state': state, 'exit_code': code}))
        tmp.replace(status)
    write('running')
    try:
        with (STATE / 'agent.log').open('w') as log:
            child = subprocess.Popen(args, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            try:
                code = child.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
                write('timeout', 124)
                return
        write('completed' if code == 0 else 'failed', code)
    except Exception:
        write('failed', 1)
        raise


if __name__ == '__main__':
    os.umask(0o077)
    command = sys.argv[1]
    if command == 'seed': seed()
    elif command == 'evaluate': print(json.dumps(evaluate()))
    elif command == 'package': package()
    elif command == 'verify': verify()
    elif command == 'agent': agent(sys.argv[2], int(sys.argv[3]))
    else: raise ValueError('unknown demo action')
DV_BUGFIX_PY
}

demo_fix_cleanup() {
  local rc="$?"
  trap '' INT TERM
  if [ -n "$demo_parent" ]; then
    dt_run "$demo_parent" 'cat "$HOME/.devflow/bugfix/agent.log" 2>/dev/null || true' 30 > "$folder/agent.log" 2>/dev/null || true
    dt_run "$demo_parent" 'cat "$HOME/.devflow/bugfix/status.json" 2>/dev/null || true' 30 > "$folder/status.json" 2>/dev/null || true
  fi
  say "Artifacts: $folder"
  (exit "$rc")
  demo_cleanup
}

cmd_demo_fix() (
  local yes=0 DV_PLAIN=0 demo_keep=0 demo_parent="" demo_child="" demo_team=""
  local agent=codex timeout=300 output=./devflow-demos view=browser folder name roster result state last="" log="" deadline
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --plain) DV_PLAIN=1; shift ;;
      --keep) demo_keep=1; shift ;;
      --agent) need_val "$1" "${2:-}"; agent="$2"; shift 2 ;;
      --timeout) need_val "$1" "${2:-}"; timeout="$2"; shift 2 ;;
      --output) need_val "$1" "${2:-}"; output="$2"; shift 2 ;;
      --view) need_val "$1" "${2:-}"; view="$2"; shift 2 ;;
      *) die "unknown fix demo option: $1" ;;
    esac
  done
  case "$agent" in codex|claude) ;; *) die "fix --agent must be codex or claude" ;; esac
  case "$timeout" in ''|*[!0-9]*|0*) die "--timeout must be 30–900 seconds" ;; esac
  [ "${#timeout}" -le 3 ] && [ "$timeout" -ge 30 ] && [ "$timeout" -le 900 ] || die "--timeout must be 30–900 seconds"
  case "$view" in browser|none) ;; *) die "fix --view must be browser or none" ;; esac
  [ "$yes" = 1 ] || [ -t 0 ] || die "use --yes for a noninteractive demo"
  require_daytona_cli
  need_cmd jq "brew install jq"
  dt_auth_check || die "not logged in — run: daytona login"
  # Only the selected model subscription crosses into the fixer, never cloud/GitHub credentials.
  set_forwarding_options '' '' 0 ''
  harvest_all
  GH_TOKEN_VAL=""; GIT_NAME="devflow demo"; GIT_EMAIL="demo@example.invalid"
  if [ "$agent" = codex ]; then
    [ -n "$CODEX_AUTH_B64" ] || die "sign into Codex locally first"
    CLAUDE_MODE=none; CLAUDE_TOKEN=""; CLAUDE_CREDS_B64=""
  else
    [ "$CLAUDE_MODE" != none ] || die "sign into Claude Code locally first (or run: dv token)"
    CODEX_AUTH_B64=""
  fi
  ui_title "devflow demo · fix a broken app"
  say "Coordinator (this terminal) → fixer ($agent) → independent verifier"
  say "Creates two billed linked sandboxes. Copies only $agent sign-in to the fixer; uses your subscription."
  say "One repair attempt, ${timeout}s agent limit. Patch and test results are saved locally; no repository is touched."
  [ "$yes" = 1 ] || { confirm "start the demo?" || return 0; }
  umask 077
  mkdir -p "$output" || exit 1
  folder="$(mktemp -d "$output/fix.XXXXXX")" || exit 1
  folder="$(cd "$folder" && pwd)"
  # Keep repeated CLI upgrade notices out of the live agent feed; retain full diagnostics.
  dt() {
    local diagnostics rc=0
    diagnostics="$(mktemp "$folder/daytona.XXXXXX")" || return 1
    command daytona "$@" 2>"$diagnostics" || rc=$?
    cat "$diagnostics" >> "$folder/daytona.log"
    if grep -q 'Daytona CLI .* is outdated' "$diagnostics" && [ ! -f "$folder/.update-notice" ]; then
      warn "Daytona CLI update available; full diagnostics: $folder/daytona.log"
      : > "$folder/.update-notice"
    fi
    sed '/^time=.*level=warning msg="Daytona CLI .* is outdated/d' "$diagnostics" >&2
    rm -f "$diagnostics"
    return "$rc"
  }
  demo_team="fix-$(date +%s)-$RANDOM"
  demo_parent="dv-$demo_team"; demo_child="$demo_parent-verifier"
  [ "$(sandbox_state "$demo_parent")" = missing ] && [ "$(sandbox_state "$demo_child")" = missing ] || die "demo name collision; retry"
  printf '%s\n%s\n' "$demo_parent" "$demo_child" > "$folder/sandboxes.txt"
  trap demo_fix_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  step "1/5 · coordinator: creating isolated fixer and verifier"
  local create_args=(create "--name=$demo_parent" --snapshot=daytona-medium --auto-stop=15 --label=devflow=1 "--label=devflow.team=$demo_team" --label=devflow.team.role=leader --label=devflow.team.mode=linked)
  [ -z "$DEVFLOW_TARGET" ] || create_args+=("--target=$DEVFLOW_TARGET")
  dt_quiet "${create_args[@]}" || die "fixer creation failed"
  wait_for_state "$demo_parent" started 180
  create_linked_sandbox "$demo_child" "$demo_parent" 15 daytona-small none core '' "$demo_team" verifier linked
  wait_for_state "$demo_child" started 180
  for name in "$demo_parent" "$demo_child"; do
    emit_bugfix_demo | dt_push_file "$name" /tmp/.dv-bugfix.py || exit 1
    dt_run "$name" 'python3 /tmp/.dv-bugfix.py seed' 30 || exit 1
  done
  roster="$(bus_new_roster "$(jq -n --arg p "$demo_parent" --arg c "$demo_child" '{leader:$p,verifier:$c}')")" || exit 1
  bus_install "$demo_parent" "$demo_team" leader "$demo_parent" "$roster" || exit 1
  bus_start "$demo_parent" || exit 1
  bus_install "$demo_child" "$demo_team" verifier "$demo_parent" "$roster" || exit 1
  dt_run "$demo_child" '"$HOME/.local/bin/dv-bus" health' 30 >/dev/null || die "private link unavailable"
  step "2/5 · verifier: reproducing the broken checkout before any agent edits"
  result="$(dt_run "$demo_child" 'python3 /tmp/.dv-bugfix.py evaluate' 90)" || exit 1
  printf '%s\n' "$result" > "$folder/before.json"
  printf '%s' "$result" | jq -e '.passed == 2 and .total == 5' >/dev/null || die "fixture did not produce its expected 3 failures"
  printf '%s' "$result" | jq -r '.tests[] | "  \(if .passed then "PASS" else "FAIL" end) \(.test): expected \(.expected), got \(.actual)"'
  step "3/5 · fixer: installing tools and applying selected subscription auth"
  upload_provisioner "$demo_parent" 1 || exit 1
  run_phase_clean "$demo_parent" tools "$agent" '' '' '' core || die "fixer tools failed"
  run_phase_clean "$demo_parent" auth "$agent" '' '' '' core || die "fixer auth failed"
  dt_run "$demo_parent" 'umask 077; export PATH="$HOME/.local/bin:$PATH"; [ ! -f "$HOME/.devflow/env" ] || . "$HOME/.devflow/env"; nohup python3 /tmp/.dv-bugfix.py agent '"$agent $timeout"' >"$HOME/.devflow/bugfix/runner.log" 2>&1 </dev/null &' 30 || exit 1
  deadline=$(( $(date +%s) + timeout + 60 ))
  while :; do
    result="$(dt_run "$demo_parent" 'cat "$HOME/.devflow/bugfix/status.json" 2>/dev/null || printf "{}"' 30)" || die "could not read fixer status"
    state="$(printf '%s' "$result" | jq -r '.state // "starting"')" || exit 1
    log="$(dt_run "$demo_parent" 'tail -n 8 "$HOME/.devflow/bugfix/agent.log" 2>/dev/null || true' 30)" || exit 1
    if [ "$log" != "$last" ]; then printf '%s\n' "$log" | clean_peek_output; last="$log"; fi
    case "$state" in completed) break ;; failed|timeout) die "fixer $state; inspect artifacts in $folder" ;; esac
    [ "$(date +%s)" -lt "$deadline" ] || die "fixer did not finish within the time limit"
    sleep 2
  done
  step "4/5 · handoff: patch travels over private DNS to the verifier"
  dt_run "$demo_parent" 'python3 /tmp/.dv-bugfix.py package' 30 > "$folder/handoff.json" || die "agent did not produce an acceptable patch"
  dt_run "$demo_parent" 'cat "$HOME/.devflow/bugfix/fix.patch"' 30 > "$folder/fix.patch" || exit 1
  dt_run "$demo_parent" 'cat "$HOME/.devflow/bugfix/agent.log"' 30 > "$folder/agent.log" || exit 1
  result="$(dt_run "$demo_child" 'python3 /tmp/.dv-bugfix.py verify' 90)" || die "patch verification failed"
  printf '%s\n' "$result" > "$folder/after.json"
  printf '%s' "$result" | jq -r '.tests[] | "  \(if .passed then "PASS" else "FAIL" end) \(.test): expected \(.expected), got \(.actual)"'
  printf '%s' "$result" | jq -e '.passed == .total and .total == 5' >/dev/null || die "independent tests rejected the patch (see after.json)"
  dt_run "$demo_parent" '"$HOME/.local/bin/dv-bus" events --json' 30 > "$folder/messages.json" || exit 1
  step "5/5 · verifier: all 5 tests passed; starting the repaired app on port 3000"
  dt_run "$demo_child" 'nohup python3 "$HOME/devflow-bugfix/app.py" >"$HOME/.devflow/bugfix/server.log" 2>&1 </dev/null & ' 30 || exit 1
  dt_run "$demo_child" 'i=0; until curl -fsS http://127.0.0.1:3000/; do i=$((i+1)); [ "$i" -lt 10 ] || exit 1; sleep 1; done' 30 > "$folder/preview.html" || die "repaired app did not start"
  local url="" preview
  preview="$(dt preview-url "$demo_child" --port=3000 --expires=900 2>/dev/null)" || preview=""
  url="$(printf '%s\n' "$preview" | awk '{for(i=1;i<=NF;i++) if ($i ~ /^https:\/\//) {print $i; exit}}')"
  if [ -n "$url" ]; then
    printf '%s\n' "$url" > "$folder/preview-url.txt"
    say "Private 15m preview link saved in $folder/preview-url.txt (anyone with that link can access this demo)."
    [ "$view" != browser ] || open_file "$url" || warn "could not open preview; use the saved link"
  else
    warn "could not create preview link; Daytona dashboard → $demo_child → preview port 3000"
  fi
  ok "3 failing tests → 5 passing tests. Artifacts: $folder"
  if [ "$yes" != 1 ]; then
    console_choose 'Inspect the app, then finish' Finish >/dev/null || true
  fi
)

emit_demo_driver() {
cat <<'DV_DEMO_PY'
"""Local demo controller. Embedded so curl and Homebrew remain single-file installs."""
import argparse
import base64
import json
import os
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid
import webbrowser
import xml.etree.ElementTree as ET
import zipfile


def note(text):
    print(f"  ▸ {text}", flush=True)


def private_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    path.chmod(0o600)


def command(args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def remote(cli, name, script, timeout=60):
    # Keep every devflow-managed remote shell operation behind the exec-style probe.
    return command([cli, '__demo-exec', name, script, str(timeout)],
                   capture_output=True, timeout=timeout + 30).stdout


def verify_sheet(path):
    ns = {'t': 'urn:oasis:names:tc:opendocument:xmlns:table:1.0',
          'o': 'urn:oasis:names:tc:opendocument:xmlns:office:1.0'}
    with zipfile.ZipFile(path) as archive:
        root = ET.fromstring(archive.read('content.xml'))
    cells = root.findall('.//t:table-cell', ns)
    text = [''.join(c.itertext()) for c in cells]
    for value in ('Item', 'Units', 'Price', 'Total', 'Notebooks', 'Pens', 'Folders', 'Grand total'):
        if value not in text:
            raise RuntimeError(f'Spreadsheet verification failed: missing {value}')
    formulas = [c for c in cells if c.get('{%s}formula' % ns['t'])]
    if len(formulas) < 4 or not any(c.get('{%s}value' % ns['o']) == '86' for c in formulas):
        raise RuntimeError('Spreadsheet formulas did not calculate the expected total (86)')


class Desktop:
    def __init__(self, args, client, folder):
        self.args, self.client, self.folder = args, client, folder
        self.name = 'dv-demo-' + args.mode + '-' + uuid.uuid4().hex[:10]
        self.sandbox = None
        self.recording = None
        self.created = False
        self.allocated = False
        self.run_id = uuid.uuid4().hex
        self.finished = False
        self.steps = []

    def frame(self, label):
        self.steps.append({'step': label, 'time': time.time()})
        private_write(self.folder / 'steps.json', json.dumps(self.steps, indent=2))
        shot = self.sandbox.computer_use.screenshot.take_full_screen(request_timeout=30)
        path = self.folder / 'desktop.png'
        path.write_bytes(base64.b64decode(shot.screenshot))
        path.chmod(0o600)
        if self.args.view == 'terminal' and sys.stdout.isatty() and shutil.which('chafa'):
            command(['chafa', '--format=symbols', '--size=80x24', str(path)], timeout=15)
        note(label)

    def key(self, key):
        keyboard = self.sandbox.computer_use.keyboard
        if '+' in key:
            keyboard.hotkey(key, request_timeout=30)
        else:
            keyboard.press({'Return': 'enter', 'Escape': 'esc'}.get(key, key.lower()), request_timeout=30)
        time.sleep(0.3)

    def type(self, text):
        self.sandbox.computer_use.keyboard.type(text, request_timeout=30)

    def wait_window(self, title, attempts=30):
        for _ in range(attempts):
            windows = self.sandbox.computer_use.display.get_windows(request_timeout=30)
            if title.lower() in str(windows).lower():
                return
            time.sleep(1)
        self.frame(f'Window timeout · {title}')
        raise RuntimeError(f'{title} window did not appear; see desktop.png')

    def preview_url(self):
        if self.args.domain:
            domain = self.args.domain.removeprefix('https://').removeprefix('http://').rstrip('/')
            url = f'https://{self.name.removeprefix("dv-")}--6080.{domain}/vnc.html?autoconnect=true&resize=scale'
            note('Live VNC (your custom preview proxy): ' + url)
            return url
        try:
            signed = self.sandbox.create_signed_preview_url(6080, expires_in_seconds=900, request_timeout=30).url
            parts = urlsplit(signed)
            query = parse_qsl(parts.query) + [('autoconnect', 'true'), ('resize', 'scale')]
            url = urlunsplit(parts._replace(path=parts.path.rstrip('/') + '/vnc.html', query=urlencode(query)))
            private_write(self.folder / 'preview-url.txt', url + '\n')
            note('Native Daytona VNC link saved in preview-url.txt (15m bearer link; keep private).')
            return url
        except Exception as exc:
            note(f'Native preview unavailable ({type(exc).__name__}); use Daytona dashboard VNC.')
            return None

    def run(self):
        windows = self.args.mode == 'windows'
        snapshot = 'windows-small' if windows else 'daytona-medium'
        # Names are random and never reused. Retain the name before create, including API timeouts.
        private_write(self.folder / 'sandbox.txt', self.name + '\n')
        create = ['daytona', 'create', '--name=' + self.name, '--snapshot=' + snapshot,
                  '--auto-stop=15', '--label=devflow=1', '--label=devflow.demo=' + self.args.mode,
                  '--label=devflow.demo.run=' + self.run_id]
        if os.environ.get('DAYTONA_TARGET'):
            create.append('--target=' + os.environ['DAYTONA_TARGET'])
        note(f'Creating {snapshot}: {self.name}')
        self.created = True
        result = subprocess.run(create, capture_output=True, text=True, timeout=300)
        private_write(self.folder / 'create.log', result.stdout + result.stderr)
        if result.returncode:
            raise RuntimeError('Sandbox create failed; see create.log (check tier, regional quota, and snapshot availability)')
        self.allocated = True
        self.sandbox = self.client.get(self.name)
        if not windows:
            note('Installing LibreOffice Calc (first boot can take a few minutes)')
            remote(self.args.cli, self.name,
                   'command -v libreoffice >/dev/null || { sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq libreoffice-calc; }', 600)
        note('Starting desktop' if windows else 'Starting desktop and recording before any GUI actions')
        self.sandbox.computer_use.start(request_timeout=120)
        if windows:
            note('Windows saves screenshots, not video: native recording is not reliable on this platform. Use the Linux desktop demo for MP4 recording.')
            note('Waiting for the Windows shell to finish signing in')
            self.wait_window('Program Manager', attempts=120)
        else:
            self.recording = self.sandbox.computer_use.recording.start('devflow-' + self.args.mode, request_timeout=60)
        url = self.preview_url()
        note('Fallback: Daytona dashboard → ' + self.name + ' → VNC')
        if self.args.view == 'browser' and url:
            webbrowser.open(url)
        elif self.args.view == 'terminal' and not shutil.which('chafa'):
            note('chafa not installed; showing progress only. Install: brew install chafa')
        self.frame('Windows · desktop ready' if windows else 'Recording · desktop ready')
        if windows:
            self.key('win+r'); self.wait_window('Run')
            self.type('notepad'); self.key('Return')
            self.wait_window('Notepad')
            self.type('Hello from devflow!\n\nThis is a real Windows VM in Daytona.\nComputer-use keyboard actions created this note.\nA screenshot of this desktop will be saved locally.')
            self.frame('Windows · typed into Notepad through the computer-use API')
        else:
            self.key('alt+F2')
            self.type('libreoffice --calc --norestore --nofirststartwizard')
            self.key('Return'); self.wait_window('LibreOffice Calc')
            time.sleep(2)
            self.key('Escape'); self.key('ctrl+Home')
            rows = [('Item', 'Units', 'Price', 'Total'),
                    ('Notebooks', '4', '12', '=B2*C2'),
                    ('Pens', '10', '2', '=B3*C3'),
                    ('Folders', '6', '3', '=B4*C4'),
                    ('Grand total', '', '', '=SUM(D2:D4)')]
            for n, row in enumerate(rows):
                self.key('ctrl+Home')
                for _ in range(n): self.key('Down')
                for column, value in enumerate(row):
                    if value: self.type(value)
                    self.key('Tab' if column < 3 else 'Return')
                self.frame(f'Calc · row {n + 1}/{len(rows)} entered with keyboard actions')
            self.key('ctrl+Home'); self.key('shift+space'); self.key('ctrl+b'); self.key('ctrl+Home')
            self.key('ctrl+shift+s'); time.sleep(2)
            self.key('ctrl+a'); self.type('/tmp/devflow-demo.ods'); self.key('Return')
            time.sleep(3)
            self.frame('Calc · saving spreadsheet and checking calculated reward data')
            # Download bytes, then verify the actual saved GUI document, never synthesize it.
            remote(self.args.cli, self.name, 'test -s /tmp/devflow-demo.ods', 30)
            path = self.folder / 'spreadsheet.ods'
            self.sandbox.fs.download_file('/tmp/devflow-demo.ods', str(path))
            verify_sheet(path)
            note('Verified spreadsheet: 3 line items, formulas, grand total 86')
        time.sleep(2)
        self.finished = True

    def finalize(self):
        # Best-effort artifact recovery must happen before deleting the desktop.
        saved = self.recording is None
        if self.recording:
            try:
                note('Stopping recording and downloading recording.mp4')
                self.sandbox.computer_use.recording.stop(self.recording.id, request_timeout=120)
                self.sandbox.computer_use.recording.download(self.recording.id, str(self.folder / 'recording.mp4'))
                saved = True
            except Exception as exc:
                note(f'Recording recovery failed ({type(exc).__name__}). Keeping sandbox to avoid losing video.')
        keep = (self.args.keep == '1' and self.finished) or not saved
        if self.created and not keep:
            if not self.allocated:
                # A timed-out create might have allocated remotely; a duplicate
                # name error must never result in deleting someone else's box.
                info = subprocess.run(['daytona', 'info', self.name, '-f', 'json'],
                                      capture_output=True, text=True, timeout=30)
                if info.returncode == 0:
                    data = json.loads(info.stdout)
                    if data.get('labels', {}).get('devflow.demo.run') != self.run_id:
                        raise RuntimeError(f'Refusing cleanup of unowned sandbox {self.name}')
                else:
                    note('Create outcome unconfirmed; inspect Daytona for ' + self.name)
                    return
            result = subprocess.run(['daytona', 'delete', self.name], capture_output=True, text=True, timeout=120)
            if result.returncode:
                # Creation may have failed before allocation; only confirm absence from a successful list.
                listing = subprocess.run(['daytona', 'list', '-f', 'json'], capture_output=True, text=True, timeout=30)
                try:
                    items = json.loads(listing.stdout)
                    complete = isinstance(items, list) or not items.get('nextCursor')
                    if isinstance(items, dict): items = items['items']
                    absent = listing.returncode == 0 and complete and all(s.get('name') != self.name for s in items)
                except (ValueError, TypeError, AttributeError):
                    absent = False
                if not absent:
                    raise RuntimeError(f'Cleanup failed. Run: devflow rm {self.name} --force')
            note('Demo sandbox deleted; local artifacts preserved')
        elif self.created:
            note(f'Kept {self.name} (15m idle auto-stop; storage may still be billed). Cleanup: dv rm {self.name} --force')
        if not saved:
            raise RuntimeError('Recording was not downloaded; recover it via Daytona Screen Recordings')


def make_eval_task(folder):
    task = folder / 'task'
    files = {
        'task.toml': '''schema_version = "1.4"
[task]
name = "devflow/sum-sales"
version = "1.0.0"
[verifier]
timeout_sec = 60
[agent]
timeout_sec = 60
[environment]
build_timeout_sec = 180
cpus = 1
memory_mb = 1024
storage_mb = 3072
''',
        'instruction.md': 'Write the sum of 48, 20, and 18 as a decimal integer to /tmp/answer.txt.\n',
        # Harbor uses su root for its log directories. The regular Daytona image
        # defaults to a non-root desktop user, so use a tiny root-owned eval image.
        'environment/Dockerfile': 'FROM ubuntu:24.04\nUSER root\nWORKDIR /app\n',
        'solution/solve.sh': '#!/bin/bash\nset -eu\nprintf "86\\n" > /tmp/answer.txt\n',
        'tests/test.sh': '''#!/bin/bash
set -eu
mkdir -p /logs/verifier
if [ "$(cat /tmp/answer.txt 2>/dev/null || true)" = 86 ]; then
  printf '1\\n' > /logs/verifier/reward.txt
else
  printf '0\\n' > /logs/verifier/reward.txt
fi
''',
    }
    for name, content in files.items():
        private_write(task / name, content)
    return task


def eval_rewards(folder):
    rewards = []
    for path in folder.rglob('result.json'):
        data = json.loads(path.read_text())
        if 'verifier_result' not in data:
            continue
        if data.get('exception_info'):
            raise RuntimeError(f'Harbor trial failed: see {path}')
        value = (data.get('verifier_result') or {}).get('rewards', {}).get('reward')
        if value is None:
            raise RuntimeError(f'Harbor trial did not produce a reward: {path}')
        rewards.append(float(value))
    if len(rewards) != 1:
        raise RuntimeError(f'Expected one scored trial, found {len(rewards)} in {folder}')
    return rewards[0]


def run_eval(folder):
    task = make_eval_task(folder)
    note('RL evaluation: task → isolated rollout → verifier → reward. No model training or LLM calls.')
    scores = {}
    for agent, expected in [('nop', 0), ('oracle', 1)]:
        note(f'{agent}: building a small root-owned eval environment; expected reward {expected}')
        args = ['harbor', 'run', '--path', str(task), '--agent', agent, '--env', 'daytona',
                '--n-concurrent', '1', '--n-attempts', '1', '--max-retries', '0', '--delete',
                '--jobs-dir', str(folder / agent), '--job-name', 'eval',
                '--ek', 'auto_stop_interval_mins=15', '--ek', 'auto_delete_interval_mins=0']
        # Harbor owns its environment lifecycle, including deletion after each trial.
        child_env = dict(os.environ, HARBOR_TELEMETRY='0')
        # Keep Harbor's progress/table live, but retain dependency tracebacks in
        # the run folder instead of filling the console with shutdown chatter.
        error_log = (folder / (agent + '-stderr.log')).open('w')
        child = subprocess.Popen(args, start_new_session=True, env=child_env, stderr=error_log)
        try:
            rc = child.wait(timeout=900)
        except (KeyboardInterrupt, subprocess.TimeoutExpired):
            os.killpg(child.pid, signal.SIGINT)
            try:
                child.wait(timeout=45)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
            note('Interrupted Harbor; inspect Daytona for remaining trials. They auto-stop at 15m idle and delete on stop.')
            raise
        finally:
            error_log.close()
        if rc:
            raise RuntimeError(f'Harbor {agent} failed (exit {rc}); inspect {folder / agent}')
        scores[agent] = eval_rewards(folder / agent)
        note(f'{agent} reward: {scores[agent]:g}')
        if scores[agent] != expected:
            raise RuntimeError(f'Unexpected {agent} reward; inspect the verifier artifacts')
    private_write(folder / 'rewards.json', json.dumps(scores, indent=2))
    note('Reward comparison: no-op 0 → oracle 1. A training loop could consume this signal; this demo only evaluates.')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('mode', choices=['desktop', 'windows', 'rl'])
    parser.add_argument('--cli', required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--view', default='browser')
    parser.add_argument('--keep', default='0')
    parser.add_argument('--yes', default='0')
    parser.add_argument('--domain', default='')
    args = parser.parse_args()
    os.umask(0o077)
    parent = Path(args.output).expanduser().resolve()
    parent.mkdir(parents=True, exist_ok=True)
    folder = Path(tempfile.mkdtemp(prefix=args.mode + '-', dir=parent))
    note('Artifacts: ' + str(folder))
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    controller = None
    try:
        if args.mode == 'rl':
            run_eval(folder)
        else:
            from daytona import Daytona, DaytonaConfig
            client = Daytona(DaytonaConfig(api_key=os.environ.get('DAYTONA_API_KEY'),
                             jwt_token=os.environ.get('DAYTONA_JWT_TOKEN'),
                             organization_id=os.environ.get('DAYTONA_ORGANIZATION_ID'),
                             api_url=os.environ.get('DAYTONA_API_URL')))
            controller = Desktop(args, client, folder)
            try:
                controller.run()
            finally:
                old_int = signal.getsignal(signal.SIGINT)
                old_term = signal.getsignal(signal.SIGTERM)
                signal.signal(signal.SIGINT, signal.SIG_IGN)
                signal.signal(signal.SIGTERM, signal.SIG_IGN)
                try:
                    controller.finalize()
                finally:
                    signal.signal(signal.SIGINT, old_int)
                    signal.signal(signal.SIGTERM, old_term)
                    # The pinned sync SDK has no close(); AsyncDaytona does.
                    close = getattr(client, 'close', None)
                    if close is not None:
                        close()
        note('Demo complete · ' + str(folder))
    except (Exception, KeyboardInterrupt) as exc:
        # SDK exceptions can include request details: never dump credentials or bearer URLs.
        detail = str(exc) if isinstance(exc, RuntimeError) else type(exc).__name__
        print('Demo failed: ' + detail + '. Artifacts: ' + str(folder), file=sys.stderr)
        return 130 if isinstance(exc, KeyboardInterrupt) else 1
    video = folder / 'recording.mp4'
    if video.exists() and args.yes != '1' and sys.stdin.isatty():
        choice = input('Replay: [t] terminal (mpv), [o] open video, [Enter] finish: ').strip().lower()
        if choice == 't':
            if shutil.which('mpv'):
                command(['mpv', '--no-config', '--vo=tct', '--really-quiet', str(video)])
            else:
                note('Install terminal replay: brew install mpv')
        elif choice == 'o':
            command(['open' if sys.platform == 'darwin' else 'xdg-open', str(video)])
    return 0


if __name__ == '__main__':
    sys.exit(main())
DV_DEMO_PY
}

cmd_demo_linked() (
  local yes=0 DV_PLAIN=0 demo_keep=0 demo_parent="" demo_child="" demo_team=""
  local text='Sandboxes let agents run code. Linked sandboxes let agents work together. Each sandbox keeps its own files.'
  local action roster output suffix
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --plain) DV_PLAIN=1; shift ;;
      --keep) demo_keep=1; shift ;;
      --text) need_val "$1" "${2:-}"; text="$2"; shift 2 ;;
      --help|-h) usage_demo; return 0 ;;
      *) die "unknown demo option: $1 (see: devflow demo --help)" ;;
    esac
  done
  [ "$yes" = 1 ] || [ -t 0 ] || die "use --yes for a noninteractive demo"
  require_daytona_cli
  need_cmd jq "brew install jq"
  dt_auth_check || die "not logged in — run: daytona login"
  ui_title "devflow demo · two computers, one job"
  say "Dispatcher → private network → worker → report"
  say "Creates two small Daytona sandboxes; normal compute charges apply."
  say "Deletes resources on exit unless --keep. No repository or subscription credentials are copied."
  if [ "$yes" != 1 ]; then
    action="$(console_choose 'Ready?' 'Create sandboxes' Cancel)" || return 0
    [ "$action" = 'Create sandboxes' ] || return 0
  fi
  suffix="$(date +%s)-$RANDOM"
  demo_team="demo-$suffix"
  # Names must also fit the team-name limit used by team commands.
  demo_team="$(normalize_team_name "$demo_team")"
  demo_parent="dv-$demo_team"; demo_child="$demo_parent-worker"
  [ "$(sandbox_state "$demo_parent")" = missing ] && [ "$(sandbox_state "$demo_child")" = missing ] || die "demo name collision; retry"
  trap demo_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  step "1/4 · creating dispatcher $demo_parent"
  local create_args
  create_args=(create "--name=$demo_parent" --snapshot=daytona-small --auto-stop=15
    --label devflow=1 --label "devflow.team=$demo_team" --label devflow.team.role=leader --label devflow.team.mode=linked --label devflow.agent=none)
  [ -z "$DEVFLOW_TARGET" ] || create_args+=("--target=$DEVFLOW_TARGET")
  if ! output="$(dt "${create_args[@]}" 2>&1)"; then printf '%s\n' "$output" >&2; die "demo dispatcher creation failed"; fi
  wait_for_state "$demo_parent" started 120
  step "creating linked worker $demo_child"
  create_linked_sandbox "$demo_child" "$demo_parent" 15 daytona-small none core '' "$demo_team" worker linked
  wait_for_state "$demo_child" started 120
  step "2/4 · proving filesystems are separate"
  dt_run "$demo_parent" 'printf dispatcher > /tmp/devflow-demo-owner' 30 || exit 1
  dt_run "$demo_child" 'test ! -e /tmp/devflow-demo-owner && printf worker > /tmp/devflow-demo-owner' 30 || die "filesystem isolation check failed"
  output="$(dt_run "$demo_parent" 'cat /tmp/devflow-demo-owner' 30)" || exit 1
  [ "$output" = dispatcher ] || die "dispatcher file unexpectedly changed"
  ok "same path, different contents: worker changes stay inside the worker"
  step "3/4 · connecting the private message inbox"
  roster="$(bus_new_roster "$(jq -n --arg p "$demo_parent" --arg c "$demo_child" '{leader:$p,worker:$c}')")" || exit 1
  bus_install "$demo_parent" "$demo_team" leader "$demo_parent" "$roster" || die "dispatcher setup failed"
  bus_start "$demo_parent" || die "inbox service failed to start"
  bus_install "$demo_child" "$demo_team" worker "$demo_parent" "$roster" || die "worker setup failed"
  dt_run "$demo_child" '"$HOME/.local/bin/dv-bus" health && { umask 077; nohup "$HOME/.local/bin/dv-bus" demo-worker >"$HOME/.devflow/cluster/worker.log" 2>&1 </dev/null & }' 30 || die "worker cannot reach dispatcher over private DNS"
  step "4/4 · dispatching a text report (real Python worker, no LLM)"
  demo_job "$demo_parent" "$text" || exit 1
  say "The worker saved report.txt on its own disk and sent the result to the leader."
  if [ "$yes" != 1 ]; then
    while :; do
      action="$(console_choose 'Explore the sandboxes' 'Run another job' 'Read worker report' 'Read messages' Finish)" || break
      case "$action" in
        'Run another job') text="$(console_input 'Text to analyze')" || continue; [ -n "$text" ] || continue; demo_job "$demo_parent" "$text" || exit 1 ;;
        'Read worker report') dt_run "$demo_child" 'cat "$HOME/.devflow/cluster/report.txt"' 30 || exit 1 ;;
        'Read messages') dt_run "$demo_parent" '"$HOME/.local/bin/dv-bus" events' 30 || exit 1 ;;
        Finish) break ;;
      esac
    done
  fi
  ok "demo complete · isolated files, linked networking, remote work, returned results"
)

cmd_token() {
  need_cmd claude "curl -fsSL https://claude.ai/install.sh | bash"
  say "launching ${C_BOLD}claude setup-token${C_RESET} — approve in the browser, then copy the token it prints."
  claude setup-token || warn "setup-token exited non-zero"
  printf '%s' "paste token (sk-ant-oat01-…, input hidden): "
  local tok
  read -rs tok || true
  printf '\n'
  [ -n "$tok" ] || die "no token entered"
  case "$tok" in
    sk-ant-oat01-*) ;;
    *) warn "that doesn't look like a setup-token (expected sk-ant-oat01-…) — storing anyway" ;;
  esac
  config_set "$SECRETS_FILE" DEVFLOW_CLAUDE_TOKEN "$tok"
  ok "stored in $SECRETS_FILE (600). New sandboxes use it; refresh existing ones with: devflow sync"
}

cmd_config() {
  case "${1:-list}" in
    list)
      say "config file: $CONFIG_FILE"
      if [ -f "$CONFIG_FILE" ]; then sed 's/^/  /' "$CONFIG_FILE"; else echo "  (defaults — nothing set)"; fi
      ;;
    get)  [ -n "${2:-}" ] || die "usage: devflow config get KEY"
          eval "printf '%s\n' \"\${$2:-}\"" ;;
    set)  [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "usage: devflow config set KEY VALUE"
          config_set "$CONFIG_FILE" "$2" "$3"; ok "$2 set" ;;
    edit) mkdir -p "$CONFIG_DIR"; "${EDITOR:-vi}" "$CONFIG_FILE" ;;
    *)    die "usage: devflow config [list|get KEY|set KEY VALUE|edit]" ;;
  esac
}

cmd_dashboard() {
  local url="https://app.daytona.io"
  if have_cmd open; then open "$url"; elif have_cmd xdg-open; then xdg-open "$url"; else say "$url"; fi
}

# ----------------------------------------------------------------------------
# setup & doctor
# ----------------------------------------------------------------------------
check_row() { # LABEL STATUS DETAIL
  local label="$1" status="$2" detail="${3:-}"
  case "$status" in
    ok)   printf '  %s %-26s %s\n' "${C_GREEN}✓${C_RESET}" "$label" "${C_DIM}$detail${C_RESET}" ;;
    warn) printf '  %s %-26s %s\n' "${C_YELLOW}!${C_RESET}" "$label" "$detail" ;;
    fail) printf '  %s %-26s %s\n' "${C_RED}✗${C_RESET}" "$label" "$detail" ;;
  esac
}

cmd_doctor() {
  say "$DEVFLOW_VERSION — environment check"
  echo
  printf '%s\n' "${C_BOLD}local tools${C_RESET}"
  local spec c fix daytona_have
  if have_cmd daytona; then
    daytona_have="$(daytona_cli_version)"
    if [ -z "$daytona_have" ] || version_lt "$daytona_have" "$DT_MIN_VERSION"; then
      check_row "daytona" warn "v${daytona_have:-unknown} at $(command -v daytona) — update: curl -fsSL https://devflow.sh/install | sh"
    else
      check_row "daytona" ok "v$daytona_have · $(command -v daytona)"
    fi
  else
    check_row "daytona" fail "missing — curl -fsSL https://devflow.sh/install | sh"
  fi
  for spec in "jq|brew install jq" "git|xcode-select --install / apt install git" "gh|brew install gh" "fzf|brew install fzf (optional: nicer pickers)" "qrencode|brew install qrencode (optional: scan-to-phone QR in 'devflow mobile')"; do
    c="${spec%%|*}"; fix="${spec#*|}"
    if have_cmd "$c"; then check_row "$c" ok "$(command -v "$c")"
    else
      case "$c" in fzf|qrencode) check_row "$c" warn "missing — $fix" ;; *) check_row "$c" fail "missing — $fix" ;; esac
    fi
  done
  local handoff=""
  [ -n "${DEVFLOW_NTFY_TOPIC:-}" ] && handoff="push (ntfy)"
  have_cmd op && handoff="${handoff:+$handoff · }1Password"
  have_cmd bw && handoff="${handoff:+$handoff · }Bitwarden"
  [ "$(uname 2>/dev/null)" = Darwin ] && have_cmd osascript && handoff="${handoff:+$handoff · }Apple Notes"
  if [ -n "$handoff" ]; then
    check_row "phone hand-off" ok "devflow mobile --send → $handoff"
  else
    check_row "phone hand-off" warn "none — run 'devflow mobile --setup-push' (any phone), or brew install 1password-cli"
  fi
  echo
  printf '%s\n' "${C_BOLD}accounts${C_RESET}"
  if have_cmd daytona && dt_auth_check; then
    check_row "daytona" ok "logged in"
  else
    check_row "daytona" fail "daytona login   (API keys: app.daytona.io/dashboard/keys)"
  fi
  if have_cmd gh && gh auth status >/dev/null 2>&1; then
    check_row "github (gh)" ok "$(gh api user -q .login 2>/dev/null || echo 'logged in')"
  else
    check_row "github (gh)" fail "gh auth login"
  fi
  harvest_all
  case "$CLAUDE_MODE" in
    token) check_row "claude (subscription)" ok "long-lived token configured" ;;
    creds) check_row "claude (subscription)" ok "local credentials found (tip: devflow token)" ;;
    *)     check_row "claude (subscription)" warn "none — run 'devflow token' (or log in to claude locally)" ;;
  esac
  # shellcheck disable=SC2088  # display text, not a path
  if [ -n "$CODEX_AUTH_B64" ]; then check_row "codex (chatgpt)" ok "~/.codex/auth.json present"
  else check_row "codex (chatgpt)" warn "none — run 'codex' locally, sign in with ChatGPT"; fi
  echo
  printf '%s\n' "${C_BOLD}defaults${C_RESET}"
  check_row "agent" ok "$DEVFLOW_AGENT"
  check_row "harness" ok "$DEVFLOW_HARNESS (auto → omc for claude, omx for codex)"
  local dsize; dsize="$(default_size)"
  check_row "size" ok "$dsize ($(size_desc "$dsize"))"
  check_row "auto-stop" ok "${DEVFLOW_AUTO_STOP}m (0 = runs until 'devflow stop')"
  [ -n "$DEVFLOW_AUTO_HANDOFF" ] && check_row "auto-handoff" ok "$DEVFLOW_AUTO_HANDOFF (every 'up' sends the reconnect line to your phone)"
  [ -n "$DEVFLOW_SNAPSHOT" ] && check_row "snapshot" ok "$DEVFLOW_SNAPSHOT"
  echo
  say "ready? try:  ${C_BOLD}devflow up${C_RESET}"
}

cmd_setup() {
  say "$DEVFLOW_VERSION setup — cloud agent sessions on your subscriptions"
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  echo

  step "1/5 dependencies…"
  local missing="" c daytona_have
  for c in daytona jq git gh qrencode; do have_cmd "$c" || missing="$missing $c"; done
  if [ -n "$missing" ]; then
    if have_cmd brew; then
      if confirm "install missing tools via Homebrew:$missing?"; then
        for c in $missing; do
          case "$c" in
            daytona) brew install daytonaio/cli/daytona ;;
            *)       brew install "$c" ;;
          esac
        done
      fi
    else
      warn "missing:$missing — install them and re-run devflow setup"
    fi
  fi
  if have_cmd daytona; then
    daytona_have="$(daytona_cli_version)"
    if [ -z "$daytona_have" ] || version_lt "$daytona_have" "$DT_MIN_VERSION"; then
      warn "Daytona CLI v${daytona_have:-unknown} is too old (need v$DT_MIN_VERSION+)"
      if have_cmd brew && confirm "upgrade Daytona and repair the ~/.local/bin PATH shadow?"; then
        upgrade_daytona_cli || warn "upgrade failed — run: curl -fsSL https://devflow.sh/install | sh"
        daytona_have="$(daytona_cli_version)"
      fi
    fi
  fi
  if [ -n "${daytona_have:-}" ] && ! version_lt "$daytona_have" "$DT_MIN_VERSION"; then
    ok "dependencies"
  else
    warn "Daytona still needs an update — run: curl -fsSL https://devflow.sh/install | sh"
  fi

  step "2/5 Daytona account (sandbox cloud — \$200 free compute for new accounts)…"
  if have_cmd daytona && dt_auth_check; then
    ok "already logged in to Daytona"
  else
    say "a browser opens to sign in / sign up at app.daytona.io"
    if confirm "run 'daytona login' now?"; then
      dt login || warn "login failed — alternative: daytona login --api-key KEY (app.daytona.io/dashboard/keys)"
    else
      warn "skipped — run 'daytona login' before 'devflow up'"
    fi
  fi

  step "3/5 Claude Code subscription auth…"
  harvest_all
  case "$CLAUDE_MODE" in
    token) ok "long-lived token already configured" ;;
    creds)
      ok "local subscription credentials detected — they'll be copied into sandboxes"
      say "recommended: a dedicated 1-year token avoids login races between laptop and sandbox."
      if confirm "create one now with 'claude setup-token'?"; then cmd_token; fi
      ;;
    *)
      warn "no Claude credentials found"
      if have_cmd claude && confirm "run 'claude setup-token' now (needs Pro/Max subscription)?"; then cmd_token; fi
      ;;
  esac

  step "4/5 Codex (ChatGPT) auth…"
  if [ -n "${CODEX_AUTH_B64:-}" ]; then
    # shellcheck disable=SC2088  # display text, not a path
    ok "~/.codex/auth.json found — it'll be copied into sandboxes"
  else
    warn "not signed in to Codex — run 'codex', pick 'Sign in with ChatGPT', then re-run setup"
  fi

  step "5/5 GitHub + defaults…"
  if have_cmd gh && gh auth status >/dev/null 2>&1; then
    ok "gh authenticated"
  else
    if have_cmd gh && confirm "run 'gh auth login' now?"; then gh auth login; fi
  fi
  if [ -t 0 ]; then
    printf 'default agent [claude/codex/both] (claude): '
    local a; read -r a || true
    case "$a" in codex|both) config_set "$CONFIG_FILE" DEVFLOW_AGENT "$a"; ok "default agent: $a" ;; *) ;; esac
  fi
  echo
  ok "setup complete — verify with ${C_BOLD}devflow doctor${C_RESET}, then run ${C_BOLD}devflow up${C_RESET}"
}

# ----------------------------------------------------------------------------
# Custom snapshot (optional: instant starts)
# ----------------------------------------------------------------------------
emit_dockerfile() {
cat <<'DV_DOCKERFILE'
# devflow base snapshot — agents + toolchains prebaked for instant session
# starts (claude, codex, gh, tmux, node, go, bun, uv, build tools, harnesses).
# Built server-side by Daytona:  devflow snapshot build [--size S]
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git jq ripgrep sudo tmux unzip xz-utils \
      python3 python3-pip openssh-client less nano vim-tiny locales \
      build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*
# Go toolchain — /usr/local/bin is on every shell's PATH, login or not
RUN GO_V=1.26.5 && \
    curl -fsSL "https://go.dev/dl/go${GO_V}.linux-amd64.tar.gz" | tar -xz -C /usr/local && \
    ln -s /usr/local/go/bin/go /usr/local/bin/go && \
    ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt
# non-root user with passwordless sudo (claude bypass mode refuses root)
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd -m -s /bin/bash -u 1000 daytona && \
    echo 'daytona ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/91-daytona
USER daytona
WORKDIR /home/daytona
ENV HOME=/home/daytona
ENV PATH="/home/daytona/.local/bin:${PATH}"
RUN mkdir -p "$HOME/.local/bin" && \
    curl -fsSL https://claude.ai/install.sh | bash && \
    GH_V=2.96.0 && \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_V}/gh_${GH_V}_linux_amd64.tar.gz" | tar -xz -C /tmp && \
    cp "/tmp/gh_${GH_V}_linux_amd64/bin/gh" "$HOME/.local/bin/gh" && \
    curl -fsSL "https://github.com/openai/codex/releases/download/rust-v0.142.5/codex-x86_64-unknown-linux-musl.tar.gz" | tar -xz -C /tmp && \
    find /tmp -maxdepth 1 -name 'codex*' -type f -exec cp {} "$HOME/.local/bin/codex" \; && \
    chmod +x "$HOME"/.local/bin/* && \
    "$HOME/.local/bin/claude" --version && "$HOME/.local/bin/codex" --version && "$HOME/.local/bin/gh" --version
# bun + uv — linked into ~/.local/bin so non-interactive shells find them too
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -sf "$HOME/.bun/bin/bun" "$HOME/.local/bin/bun" && \
    ln -sf "$HOME/.bun/bin/bun" "$HOME/.local/bin/bunx" && \
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    go version && "$HOME/.local/bin/bun" --version && "$HOME/.local/bin/uv" --version
# node + the oh-my-* multi-agent harnesses, prebaked for instant session starts.
# node/npm/npx get linked into ~/.local/bin — nvm only loads in interactive
# shells, and agents shell out non-interactively (the classic nvm PATH trap)
RUN export NVM_DIR="$HOME/.nvm" && \
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && nvm install 22 && \
    NODE_DIR="$(dirname "$(nvm which 22)")" && \
    ln -sf "$NODE_DIR/node" "$HOME/.local/bin/node" && \
    ln -sf "$NODE_DIR/npm"  "$HOME/.local/bin/npm" && \
    ln -sf "$NODE_DIR/npx"  "$HOME/.local/bin/npx" && \
    npm config set prefix "$HOME/.local" && \
    npm install -g oh-my-claude-sisyphus@latest oh-my-codex@latest && \
    "$HOME/.local/bin/omc" --version && "$HOME/.local/bin/omx" --version && \
    "$HOME/.local/bin/node" --version && "$HOME/.local/bin/npm" --version && \
    sed -i '/NVM_DIR/d' "$HOME/.bashrc"
# ^ drop nvm's login-shell loader: node is symlinked above, and nvm + the npm
#   prefix we set would print a warning on every interactive login otherwise
CMD ["sleep", "infinity"]
DV_DOCKERFILE
}

cmd_snapshot() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    build)
      local size=""
      while [ $# -gt 0 ]; do
        case "$1" in
          -s|--size) need_val "$1" "${2:-}"; size="$2"; shift 2 ;;
          *) die "unknown flag for snapshot build: $1 (usage: devflow snapshot build [--size small|medium|large])" ;;
        esac
      done
      [ -n "$size" ] || size="$(default_size)"
      local cpu mem_gb disk_gb
      case "$size" in   # a snapshot bakes its resources ('snapshot create' memory is GB)
        small)  cpu=1 mem_gb=1 disk_gb=3 ;;
        medium) cpu=2 mem_gb=4 disk_gb=8 ;;
        large)  cpu=4 mem_gb=8 disk_gb=10 ;;
        *) die "invalid size '$size' (small|medium|large)" ;;
      esac
      require_daytona_cli
      dt_auth_check || die "not logged in to Daytona — run: devflow setup"
      local snap_name="devflow-base-$DEVFLOW_VERSION-$size" tmp
      tmp="$(mktemp -d "${TMPDIR:-/tmp}/devflow-snap.XXXXXX")"
      emit_dockerfile >"$tmp/Dockerfile"
      say "building snapshot ${C_BOLD}$snap_name${C_RESET} ($(size_desc "$size")) on Daytona (one-time, a few minutes)…"
      if dt snapshot create "$snap_name" --dockerfile "$tmp/Dockerfile" \
           "--cpu=$cpu" "--memory=$mem_gb" "--disk=$disk_gb"; then
        config_set "$CONFIG_FILE" DEVFLOW_SNAPSHOT "$snap_name"
        rm -rf "$tmp"
        ok "snapshot built + set as default — new sandboxes now start in seconds"
        step "want another size too? ${C_BOLD}devflow snapshot build --size small|medium|large${C_RESET} (they coexist; DEVFLOW_SNAPSHOT picks)"
      else
        rm -rf "$tmp"
        die "snapshot build failed (see output above)"
      fi
      ;;
    dockerfile) emit_dockerfile ;;
    *) die "usage: devflow snapshot [build [--size small|medium|large] | dockerfile]" ;;
  esac
}

# ----------------------------------------------------------------------------
# Help
# ----------------------------------------------------------------------------
usage_up() {
cat <<EOF
${C_BOLD}devflow up${C_RESET} [REPO] [flags] — create (or reattach to) a cloud agent session

  REPO                owner/name or GitHub URL; omit to use the current repo,
                      or get a picker of your GitHub repos

  -a, --agent A       claude | codex | both | none     (default: $DEVFLOW_AGENT)
  -H, --harness H     multi-agent harness: auto | omc | omx | both | core (none≡core)
                      (default: $DEVFLOW_HARNESS — auto matches the agent:
                      oh-my-claudecode for claude, oh-my-codex for codex;
                      core = devflow's built-in dv-engineer/designer/security)
  -m, --task "…"      hand the agent a task right away; add --no-attach to
                      fire-and-forget; poll with 'devflow status' or 'peek'
      --script FILE   run a local script inside the sandbox (tmux window
                      'script'; log ~/.devflow/script.log). A bare positional
                      arg that names an existing file works too:
                      devflow up repro.sh
      --with-daytona  give the sandbox your Daytona CLI + API key + devflow,
                      so scripts/agents in it can spin up SIBLING sandboxes
                      (they bill your account — clean up with devflow rm)
      --aws-profile P resolve and forward profile P as a temporary AWS session;
                      also installs aws/eksctl/kubectl/helm/yq/envsubst,
                      helm-unittest, shellcheck, Docker, and supporting tools
      --secret-env V  forward the named local environment variable through the
                      encrypted 0600 auth bundle (repeatable; values never log)
      --env N=V       forward a non-secret runtime setting through the same
                      0600 bundle (repeatable; useful for domains/API URLs)
      --allow-static-aws
                      explicitly permit non-expiring AWS credentials (unsafe;
                      an assumed-role profile with an STS session is preferred)
  -b, --branch B      checkout (or create) branch B
  -n, --name N        sandbox name (default: dv-<repo>)
      --blank         no repo — empty scratch sandbox
      --pick          force the repo picker
      --fresh         delete + recreate if the sandbox already exists
      --no-attach     don't SSH in after starting
      --detach        alias for --no-attach
  -s, --size S        small | medium | large   (default: $(default_size))
                      small=1cpu/1gb/3gb · medium=2cpu/4gb/8gb · large=4cpu/8gb/10gb
                      (--cpu/--memory/--disk are deprecated: they map to the
                      smallest size that fits)
      --auto-stop MIN 0 = keep running until 'devflow stop' (default ${DEVFLOW_AUTO_STOP})
      --snapshot S    custom snapshot — brings its own size (see: devflow snapshot build)
EOF
}

usage() {
cat <<EOF
${C_CYAN}${C_BOLD}devflow${C_RESET} $DEVFLOW_VERSION — agentic cloud dev sessions on Daytona, powered by your subscriptions

${C_BOLD}start here${C_RESET}
  devflow setup                 one-time: accounts + auth (no API keys needed)
  devflow demo                  linked workers, desktop recording, Harbor eval, Windows
  devflow up [REPO]             spin up Claude Code / Codex on a repo & attach
  devflow up -m "fix bug X" --detach       fire-and-forget, close your laptop
  devflow team up [REPO] --task "build X"  run a multi-agent workflow in one
                                           sandbox; add --mode linked --agents 3
                                           for one linked sandbox per agent
  devflow up repro.sh --with-daytona       run a script in a sandbox; it can
                                           even spin up sibling sandboxes

  every sandbox gets a multi-agent harness: oh-my-claudecode (/autopilot,
  /team, 29 agents) with claude, oh-my-codex with codex, plus devflow's own
  dv-engineer / dv-designer / dv-security subagents. tune: --harness

${C_BOLD}daily driving${C_RESET}
  devflow attach [NAME]   (a)   reattach from anywhere — tmux keeps it alive
  devflow status [NAME]         readable sandbox + task health; --raw for scripts
  devflow peek [NAME] [-w W]    clean recent output; -n N lines, --raw transcript
  devflow team status TEAM      inspect a one- or multi-sandbox agent team
  devflow team ui TEAM          console: watch, assign, message, hand off, attach
  devflow ls                    list sandboxes
  devflow stop [NAME|--all]     stop (disk kept) — attach restarts + resumes
  devflow rm [NAME|--all]       delete sandbox
  devflow sync [NAME] [flags]   re-sync auth; accepts --aws-profile P,
                                repeatable --secret-env V / --env N=V,
                                --allow-static-aws

${C_BOLD}more${C_RESET}
  devflow ssh [NAME]            SSH in (lands in tmux; detach: Ctrl-b d)
  devflow web [NAME]            print NAME.devflow.sh; add --port PORT for an app
  devflow ssh-command [NAME]    print a plain ssh command for any machine
  devflow ssh-config [NAME]     managed ~/.ssh/config Host block — plain
                                ssh NAME, VS Code/Cursor Remote-SSH, scp
  devflow mobile [NAME]         hand the session to your phone — camera QR +
                                ssh line; --send pushes it to the phone
                                (ntfy notification / 1Password / Apple Notes)
  devflow exec NAME -- CMD      run a one-off command in a sandbox
  devflow token                 store a 1-year Claude subscription token
  devflow snapshot build        prebake a custom snapshot (agents + go/bun/uv/
                                build tools) for instant starts; --size S per size
  devflow doctor                check local setup
  devflow config [set K V]      defaults (agent, resources, auto-stop…)
  devflow dashboard             open app.daytona.io

Docs: https://github.com/dalinkstone/devflow
EOF
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  load_config

  case "$cmd" in
    up|start|new)         cmd_up "$@" ;;
    attach|a|open)        cmd_attach "$@" ;;
    ssh)                  cmd_ssh "$@" ;;
    web|url|preview)      cmd_web "$@" ;;
    ssh-command|ssh-cmd)  cmd_ssh_command "$@" ;;
    ssh-config|sshconfig) cmd_ssh_config "$@" ;;
    mobile|phone|qr)      cmd_mobile "$@" ;;
    exec)                 cmd_exec "$@" ;;
    peek|watch)           cmd_peek "$@" ;;
    status|state)         cmd_status "$@" ;;
    ls|list|ps)           cmd_ls "$@" ;;
    stop)                 cmd_stop "$@" ;;
    rm|delete|down)       cmd_rm "$@" ;;
    sync)                 cmd_sync "$@" ;;
    team|teams)           cmd_team "$@" ;;
    demo)                 cmd_demo "$@" ;;
    __demo-driver)        emit_demo_driver ;;
    __bugfix-demo)        emit_bugfix_demo ;;
    __demo-exec)          dt_run "$@" ;;
    token)                cmd_token "$@" ;;
    setup|init)           cmd_setup "$@" ;;
    doctor|check)         cmd_doctor "$@" ;;
    config)               cmd_config "$@" ;;
    snapshot)             cmd_snapshot "$@" ;;
    dashboard)            cmd_dashboard "$@" ;;
    __provision-script)   emit_provision_script ;;
    __dockerfile)         emit_dockerfile ;;
    __bus-script)         emit_bus_script ;;
    version|--version|-v) echo "devflow $DEVFLOW_VERSION" ;;
    help|--help|-h)       usage ;;
    *)                    err "unknown command: $cmd"; echo; usage; exit 1 ;;
  esac
}

main "$@"
