#!/usr/bin/env bash
# Fake daytona CLI for devflow tests.
# Records every invocation to $FAKE_LOG; keeps sandbox state in $FAKE_STATE_DIR.
# FAKE_EXEC_STYLE=argv|join controls how `exec -- args` are interpreted,
# mirroring the two possible behaviors of the real CLI.
set -u

: "${FAKE_LOG:?FAKE_LOG must be set}"
: "${FAKE_STATE_DIR:?FAKE_STATE_DIR must be set}"
: "${FAKE_EXEC_STYLE:=argv}"
mkdir -p "$FAKE_STATE_DIR"

printf 'daytona %s\n' "$*" >> "$FAKE_LOG"

sbx_file() { printf '%s/%s.json' "$FAKE_STATE_DIR" "$1"; }

emit_fake_peek_pane() { # WINDOW
  local window="$1" i
  case "${FAKE_PEEK_VARIANT:-default}" in
    long)
      printf '\n\n'
      i=1
      while [ "$i" -le 12 ]; do
        printf 'peek-line-%02d\n' "$i"
        i=$((i + 1))
      done
      printf '\n\n\n'
      ;;
    dirty)
      # Exercise more than SGR: real CLIs also emit hyperlinks, titles,
      # cursor movement, carriage-return spinners, and backspaces.
      printf '\n\033[31mred agent update\033[0m\n'
      printf '\033]8;;https://incidental.example\007useful link label\033]8;;\007\n'
      printf '\033]0;incidental terminal title\007'
      printf 'spinner one\rspinner done\n'
      printf 'typoX\b fixed\n'
      printf '\033[2K\033[1Aclean result\n\n'
      ;;
    completed)
      printf '\nraw pane transcript\ntokens used: 153371\n\n'
      ;;
    noise)
      printf '\nuseful work\n'
      printf '2026-08-30T10:00:00Z ERROR codex_core::session: failed to record rollout\n'
      printf 'items: thread 019f9be8-0766-7990-b5d4-890aab32b4e5 not found\n'
      printf 'tokens used\n153,371\nfinished result\n\n'
      ;;
    empty)
      printf '\n\n\n'
      ;;
    windows)
      printf '\n%s window output\n\n' "$window"
      ;;
    *)
      printf '\n\n⏺ fake agent output line\n❯ waiting for input\n\n\n'
      ;;
  esac
}

emit_fake_peek_final() {
  printf '\nImplemented the requested change.\nAll tests pass.\n\n'
}

emit_fake_peek_envelope() { # SCRIPT
  local script="$1" window=agent state agent source=pane prefer_final=1 detected_window
  state="${FAKE_AGENT_STATE:-running}"
  agent="${FAKE_AGENT_NAME:-codex}"
  detected_window="$(printf '%s' "$script" | sed -n 's/^.*window=\([a-zA-Z0-9_.-]*\);.*$/\1/p')"
  [ -z "$detected_window" ] || window="$detected_window"
  case "$script" in
    *window=codex*|*dv:codex*)   window=codex ;;
    *window=script*|*dv:script*) window=script ;;
    *window=shell*|*dv:shell*)   window=shell ;;
  esac
  case "$script" in
    *prefer_final=0*|*DEVFLOW_PEEK_PREFER_FINAL=0*) prefer_final=0 ;;
  esac
  if [ "$prefer_final" = 1 ] && [ "$state" = completed ] \
     && [ "$agent" = codex ] && [ "$window" = agent ]; then
    source=final
  fi
  [ "${FAKE_PEEK_VARIANT:-}" != missing ] || source=missing
  printf '__DEVFLOW_PEEK_META__ state=%s agent=%s source=%s window=%s\n' \
    "$state" "$agent" "$source" "$window"
  printf '__DEVFLOW_PEEK_BEGIN__\n'
  if [ "$source" = final ]; then emit_fake_peek_final
  elif [ "$source" = missing ]; then printf 'window %s is not running\n' "$window"
  else emit_fake_peek_pane "$window"; fi
  printf '__DEVFLOW_PEEK_END__\n'
}

cmd="${1:-}"; shift || true

case "$cmd" in
  organization)
    [ "${FAKE_UNAUTH:-0}" = "1" ] && { echo "Unauthorized" >&2; exit 1; }
    echo "org-default"
    exit 0
    ;;

  create)
    name=""; labels="{}"; cpu=""; memory=""; disk=""; auto_stop=15; snapshot=""; target=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name=*) name="${1#--name=}"; shift ;;
        --auto-stop=*) auto_stop="${1#--auto-stop=}"; shift ;;
        --cpu=*) cpu="${1#--cpu=}"; shift ;;
        --memory=*) memory="${1#--memory=}"; shift ;;
        --disk=*) disk="${1#--disk=}"; shift ;;
        --snapshot=*) snapshot="${1#--snapshot=}"; shift ;;
        --target=*) target="${1#--target=}"; shift ;;
        --label) kv="$2"; k="${kv%%=*}"; v="${kv#*=}"
                 labels="$(printf '%s' "$labels" | jq --arg k "$k" --arg v "$v" '. + {($k): $v}')"
                 shift 2 ;;
        *) shift ;;
      esac
    done
    [ -n "$name" ] || { echo "create: missing --name" >&2; exit 1; }
    # real API (v0.194+): resources are rejected whenever a snapshot backs the
    # sandbox — and the default image is a snapshot too
    if [ -n "$cpu$memory$disk" ]; then
      echo "FATA Bad Request: Cannot specify Sandbox resources when using a snapshot" >&2
      exit 1
    fi
    case "$snapshot" in                    # sizes live in the snapshot; memory/disk in GB
      daytona-small)  cpu=1; memory=1; disk=3 ;;
      daytona-medium) cpu=2; memory=4; disk=8 ;;
      daytona-large)  cpu=4; memory=8; disk=10 ;;
      "")             cpu=1; memory=1; disk=3 ;;   # default snapshot = small
      *)              cpu=2; memory=4; disk=8 ;;   # custom snapshot: whatever it was built with
    esac
    jq -n --arg name "$name" --argjson labels "$labels" \
          --argjson cpu "$cpu" --argjson memory "$memory" --argjson disk "$disk" \
          --arg autoStop "$auto_stop" --arg snapshot "$snapshot" --arg target "$target" \
          '{id: ("id-" + $name), name: $name, state: "started", labels: $labels,
            cpu: $cpu, memory: $memory, disk: $disk,
            autoStopInterval: $autoStop, snapshot: $snapshot, target: $target}' \
      > "$(sbx_file "$name")"
    echo "Sandbox $name created"
    echo "Open the Web Terminal: https://22222-${name}.daytonaproxy01.net"
    exit 0
    ;;

  info)
    name="${1:-}"
    f="$(sbx_file "$name")"
    [ -f "$f" ] || { echo "sandbox not found: $name" >&2; exit 1; }
    cat "$f"
    exit 0
    ;;

  list)
    [ "${FAKE_UNAUTH:-0}" = "1" ] && { echo "Unauthorized" >&2; exit 1; }
    files=$(ls "$FAKE_STATE_DIR"/*.json 2>/dev/null || true)
    if [ -z "$files" ]; then echo "[]"; else jq -s '.' "$FAKE_STATE_DIR"/*.json; fi
    exit 0
    ;;

  start)
    name="${1:-}"; f="$(sbx_file "$name")"
    [ -f "$f" ] || { echo "not found" >&2; exit 1; }
    jq '.state = "started"' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    echo "started $name"
    exit 0
    ;;

  stop)
    name="${1:-}"; f="$(sbx_file "$name")"
    [ -f "$f" ] || { echo "not found" >&2; exit 1; }
    jq '.state = "stopped"' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    echo "stopped $name"
    exit 0
    ;;

  delete)
    [ "${FAKE_DELETE_FAIL:-0}" != 1 ] || { echo 'deletion unavailable' >&2; exit 1; }
    name="${1:-}"
    f="$(sbx_file "$name")"
    parent_id=""
    [ ! -f "$f" ] || parent_id="$(jq -r '.id // empty' "$f")"
    rm -f "$(sbx_file "$name")"
    # Daytona deletes linked children when their parent is deleted.
    if [ -n "$parent_id" ]; then
      for f in "$FAKE_STATE_DIR"/*.json; do
        [ -f "$f" ] || continue
        [ "$(jq -r '.linkedSandbox // empty' "$f")" != "$parent_id" ] || rm -f "$f"
      done
    fi
    echo "deleted $name"
    exit 0
    ;;

  ssh)
    echo "FAKE-SSH ${1:-}"
    exit 0
    ;;

  snapshot)
    echo "snapshot ok"
    exit 0
    ;;

  exec)
    name="${1:-}"; shift || true
    # swallow --timeout N / --cwd X
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout|--cwd) shift 2 ;;
        --) shift; break ;;
        *) shift ;;
      esac
    done
    f="$(sbx_file "$name")"
    [ -f "$f" ] || { echo "exec: sandbox not found: $name" >&2; exit 1; }
    state="$(jq -r .state "$f")"
    [ "$state" = "started" ] || { echo "exec: sandbox not started" >&2; exit 1; }

    if [ "$FAKE_EXEC_STYLE" = "argv" ]; then
      # argv preserved: emulate a few commands the probe/devflow relies on
      printf 'EXEC[%s] %s\n' "$name" "$*" >> "$FAKE_LOG"
      case "${1:-}" in
        printf) shift; fmt="$1"; shift; printf "$fmt" "$@"; exit 0 ;;
        echo)   shift; echo "$@"; exit 0 ;;
        bash)
          # bash -lc SCRIPT
          script="${3:-}"
          ;;
        *) script="$*" ;;
      esac
      # materialize devflow's chunked file pushes into a fake sandbox fs,
      # so tests can assert on the exact bytes that would land remotely
      FS="$FAKE_STATE_DIR/fs"
      case "$script" in
        *"printf %s '"*"' > '"*".b64'"*|*"printf %s '"*"' >> '"*".b64'"*)
          part="$(printf '%s' "$script" | sed -n "s/^.*printf %s '\([A-Za-z0-9+\/=]*\)'.*$/\1/p")"
          dest="$(printf '%s' "$script" | sed -n "s/^.*> *'\(\/[^']*\.b64\)'.*$/\1/p")"
          if [ -n "$dest" ]; then
            mkdir -p "$FS$(dirname "$dest")"
            case "$script" in
              *"printf %s '"*"' >> '"*) printf '%s' "$part" >> "$FS$dest" ;;
              *)                        printf '%s' "$part" >  "$FS$dest" ;;
            esac
          fi
          exit 0 ;;
        *"base64 -d '"*".b64'"*)
          src="$(printf '%s' "$script" | sed -n "s/^.*base64 -d '\(\/[^']*\.b64\)'.*$/\1/p")"
          if [ -n "$src" ] && [ -f "$FS$src" ]; then
            mkdir -p "$FS$(dirname "${src%.b64}")"
            base64 --decode < "$FS$src" > "$FS${src%.b64}" 2>/dev/null \
              || base64 -d < "$FS$src" > "$FS${src%.b64}"
          fi
          exit 0 ;;
      esac
    else
      # join style: args joined with spaces, run through remote sh -c
      joined="$*"
      printf 'EXEC[%s] %s\n' "$name" "$joined" >> "$FAKE_LOG"
      case "$joined" in
        "printf %s x y") printf 'xy'; exit 0 ;;   # printf gets two args: "x" "y"
        "printf %s 'x y'") printf 'x y'; exit 0 ;;
        echo*) printf '%s\n' "${joined#echo }" | tr -d "'"; exit 0 ;;
      esac
      # strip the self-quoted "bash -lc '…'" wrapper for content matching
      script="$joined"
    fi

    if [ "${FAKE_FAIL_TOOLS:-0}" = 1 ]; then
      case "$script" in
        *"DV_PHASE='tools'"*) echo "fake tools phase failed" >&2; exit 42 ;;
      esac
    fi

    case "$script" in
      *'agent is still active'*) [ "${FAKE_TASK_BUSY:-0}" != 1 ]; exit $? ;;
      *'"${s:-idle}"'*) echo "${FAKE_AGENT_STATE:-running}"; exit 0 ;;
      *cat*/tmp/devflow-demo-owner*) echo dispatcher; exit 0 ;;
      *dv-bus*send*worker*--file*/tmp/.dv-demo-input*)
        [ "${FAKE_BUS_FAIL:-0}" != 1 ] || exit 1
        echo '{"id":1,"from":"leader","to":"worker"}'; exit 0 ;;
      *dv-bus*events*--json*) echo '[{"id":2,"sender":"worker","recipient":"leader","body":"Job #1 complete. Report: 3 words; 2 unique."}]'; exit 0 ;;
      *'dv-bus" context'*)
        [ "${FAKE_AGENT_STATE:-running}" = completed ] || exit 1
        printf '# Agent handoff\nOriginal task: build feature\nLatest result: ready\n'; exit 0 ;;
      *".devflow/provisioned"*)
        [ "${FAKE_UNPROVISIONED:-0}" = "1" ] || echo "5"
        exit 0 ;;
      *'while [ "$i" -lt 30 ]'*)
        echo "${FAKE_AGENT_STATE:-running}"
        exit 0 ;;
      *'agent_state=%s'*)
        state="${FAKE_AGENT_STATE:-running}"
        echo "agent_state=$state"
        echo "agent=codex"
        echo "process_alive=yes"
        echo "tmux_session=running"
        echo "started_at=2026-07-17T00:00:00Z"
        echo "completed_at="
        echo "exit_code="
        echo "prompt_sha256=FAKE"
        exit 0 ;;
      *'__DEVFLOW_PEEK_META__'*'__DEVFLOW_PEEK_BEGIN__'*'__DEVFLOW_PEEK_END__'*)
        emit_fake_peek_envelope "$script"
        exit 0 ;;
      *capture-pane*) emit_fake_peek_pane agent; exit 0 ;;
      *dv-ensure*)    exit 0 ;;
      *dv-task-start*) echo "agent task started in tmux window dv:agent"; exit 0 ;;
      *provision.sh*) echo "[devflow] fake provision phase ran"; exit 0 ;;
      *)              exit 0 ;;
    esac
    ;;

  version) echo "Daytona CLI version v${FAKE_DAYTONA_VERSION:-0.200.1}"; exit 0 ;;
  *) exit 0 ;;
esac
